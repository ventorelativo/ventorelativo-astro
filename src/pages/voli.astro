---
/**
 * /voli (C6, X1, X2): intro prose then the five XContest searches, stacked.
 */
import { getEntry, render } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import XContestLinks from '../components/XContestLinks.astro';

const page = await getEntry('pages', 'voli');
if (!page) throw new Error('Missing src/content/pages/voli.mdx');
const { Content } = await render(page);
---

<PageLayout title={page.data.title} description={page.data.description} ogRoute="voli">
  <div class="prose prose--full">
    <Content />
  </div>

  <div class="links prose">
    <XContestLinks layout="list" />
  </div>
</PageLayout>

<style>
  /*
    `.prose` for the measure: stacked full-container rows read as a wall of
    identical bars, and these are five links, not a table. The component's own
    grid outranks `.prose ul` (a class plus Astro's scope attribute beats a
    class plus a type), and the external glyph `.prose` adds to outward links
    skips these: each one already draws the real icon.
  */
  .links {
    margin-block-start: var(--space-lg);
  }
</style>
