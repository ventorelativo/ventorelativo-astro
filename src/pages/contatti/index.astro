---
/**
 * /contatti (C8) — intro, the contact buttons, then the Netlify form.
 */
import { getEntry, render } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import ContactButtons from '../../components/ContactButtons.astro';
import ContactForm from '../../components/ContactForm.astro';
import OrganizationDetails from '../../components/OrganizationDetails.astro';

const page = await getEntry('pages', 'contatti');
if (!page) throw new Error('Missing src/content/pages/contatti.mdx');
const { Content } = await render(page);
const { contacts } = page.data;
---

<PageLayout
  title={page.data.title}
  description={page.data.description}
  ogRoute="contatti"
>
  {/* Who is answering, before anything asks the reader to write. */}
  <OrganizationDetails />

  <div class="prose">
    <Content />
  </div>

  {contacts && <ContactButtons contacts={contacts} />}

  <div class="form">
    <h2>Scrivici</h2>
    <p class="form__intro">
      Il modulo arriva alla stessa casella dell'indirizzo qui sopra. Se preferisci il
      telefono, il numero è quello del direttivo: chiamalo a un'ora ragionevole.
    </p>
    <ContactForm />
  </div>
</PageLayout>

<style>
  .form {
    margin-block-start: var(--space-xl);
  }

  .form__intro {
    max-width: var(--prose-width);
    margin-block-end: var(--space-md);
    color: var(--color-text-muted);
  }
</style>
