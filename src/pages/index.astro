---
/**
 * Homepage (C2).
 *
 * Ports the Drupal front page: full-bleed hero, centred branding, CTA row, and
 * the image credit that `vr_creditiimmagine` showed only here (G8).
 *
 * Two changes from the Drupal version:
 *  - The hero was a CSS `image-set()` background on `main::before` plus a
 *    hand-written preload hint in helper.module. It's a real <Picture> now, so
 *    Astro generates the avif/webp variants and the browser discovers the LCP
 *    image in the markup instead of after CSS parses.
 *  - The three CTAs were raw Bootstrap anchors inside the body HTML. They are
 *    structured data here, which is what §2.4 called for; Phase 2 moves this
 *    array into a Keystatic `home` singleton.
 */
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/Logo.astro';
import { SITE } from '../consts';
import H2 from '../components/H2.astro';
import ArticleCard from '../components/ArticleCard.astro';
import XContestLinks from '../components/XContestLinks.astro';
import PricingTiers from '../components/PricingTiers.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import { getCollection, getEntry, render } from 'astro:content';
import ExternalIcon from '../components/ExternalIcon.astro';

/*
  The homepage's editable parts, from the `home` entry in the pages collection.

  The credit travels inside `hero` rather than beside it because it belongs to
  the picture and not to the page (G8): a page that does not render `src` has
  no credit to show, and an editor swapping the photograph is prompted for the
  new one in the same place.
*/
const home = await getEntry('pages', 'home');
if (!home?.data.hero) throw new Error('src/content/pages/home.mdx needs a hero image');
const HERO = home.data.hero;

/*
  The homepage was the hero and nothing else: 60 words, no headings, no links
  to the pages it exists to send people to. It is the strongest page on the
  domain and it was ranking on the club's name alone.

  The prose comes from the `home` entry's own body, a field that already
  existed in Keystatic and was labelled "not used today". So the club can edit
  the front page's words without touching code, which is the point of the CMS.
*/
const { Content: Intro } = await render(home);

/* Every site, as a line of links: fourteen names is a paragraph, and it puts
   fourteen internal links on the strongest page on the domain. Five bespoke
   cards said less and looked like an arbitrary shortlist. */
const sites = (await getCollection('sites')).sort((a, b) =>
  a.data.title.localeCompare(b.data.title, 'it'),
);

const iscrizioni = await getEntry('pages', 'iscrizioni');
const tiers = iscrizioni?.data.tiers ?? [];

const latest = (await getCollection('news', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
---

{
  /*
  Title and social card from metatag.metatag_defaults.front.yml (S5): the front
  page said "Parapendio Club a Pinerolo, Val Chisone e Val Pellice" rather than
  repeating the club name, and used the static card rather than a generated one.
*/
}
<BaseLayout
  title="Parapendio Club a Pinerolo, Val Chisone e Val Pellice"
  description={home.data.description}
  titleSuffix={SITE.name}
  bare
  ogRoute="home"
>
  <section class="hero">
    {
      /*
        `quality` is below the default on purpose: this photograph costs more
        than the fog it replaced, because rock and scrub compress far worse.
        And the comment sits here rather than inside the tag, where Astro reads
        each of its words as an attribute and prints them into the <img>.
      */
    }
    <Picture
      src={HERO.src}
      formats={['avif', 'webp']}
      widths={[800, 1200, 1600]}
      sizes="100vw"
      quality={40}
      alt={HERO.alt}
      loading="eager"
      fetchpriority="high"
      class="hero__bg"
    />

    <div class="hero__content container">
      {/* Morphs into the header's mark on every other page: see Header. */}
      <Logo height="8rem" style="view-transition-name: brand-mark" />

      {
        /*
        The logo artwork already carries the wordmark and the slogan, so
        repeating them as text beneath it reads as a stutter, and the header
        now shows both. They stay in the DOM, visually hidden: the page still
        needs its one <h1>, and that heading is what a screen reader announces
        and what search engines read.
      */
      }
      <h1 class="visually-hidden">{SITE.name}</h1>
      <p class="visually-hidden">{SITE.slogan}</p>
    </div>

    {
      /*
      The credit sits with the picture it credits, bottom-right of <main>,
      where `vr_creditiimmagine` put it in the Drupal theme. It used to be
      passed down to the footer, which meant a global chrome component had to
      know about one page's image; now it cannot appear anywhere the photo
      isn't, because it is inside the same element.
    */
    }
    {
      HERO.credit && (
        <p class="hero__credit">
          Foto:{' '}
          <a href={HERO.credit.href} target="_blank" rel="noopener noreferrer">
            {HERO.credit.text}
            <ExternalIcon size={12} />
          </a>
        </p>
      )
    }
  </section>

  <div class="home">
    <section class="home__band">
      <div class="container">
        <div class="home__intro"><Intro /></div>
      </div>
    </section>

    <section class="home__band home__band--tint">
      <div class="container">
        <H2>Dove voliamo</H2>
        <p class="home__lead">
          Quattordici siti tra le valli, ognuno con i suoi decolli e atterraggi, le
          coordinate, la mappa e i file da caricare nello strumento.
        </p>
        <ul class="home__sites" role="list">
          {
            sites.map((site) => (
              <li>
                <a href={`/siti/${site.id}/`}>{site.data.title}</a>
              </li>
            ))
          }
        </ul>
        <p>
          <a class="home__more" href="/siti/">
            Tutti i siti di volo, con le mappe
            <ArrowIcon />
          </a>
        </p>
      </div>
    </section>

    <section class="home__band">
      <div class="container">
        <H2>Eventi e ultime dal club</H2>
        <ul class="home__grid" role="list">
          {
            /* No `priority`: the LCP here is the hero, and these sit far below
               the fold, so they stay lazy. */
            latest.map((entry) => (
              <li>
                <ArticleCard entry={entry} headingLevel={3} />
              </li>
            ))
          }
        </ul>
        <p>
          <a class="home__more" href="/news/">
            Tutte le news
            <ArrowIcon />
          </a>
        </p>
      </div>
    </section>

    <section class="home__band home__band--tint">
      <div class="container">
        <H2>I nostri voli</H2>
        <p class="home__lead">
          Le tracce dai nostri decolli finiscono su XContest. Queste tre ricerche sono
          già filtrate sulla zona.
        </p>
        <XContestLinks limit={3} />
        <p>
          <a class="home__more" href="/voli/">
            Tutte le ricerche
            <ArrowIcon />
          </a>
        </p>
      </div>
    </section>

    {
      tiers.length > 0 && (
        <section class="home__band">
          <div class="container">
            <H2>Iscriversi</H2>
            <p class="home__lead">
              La quota tiene in piedi i decolli, gli atterraggi, le gare e questo sito:
              nessuno ci paga per farlo. Il Sostenitore dà una mano senza entrare
              nell’associazione, il Socio vota in assemblea e decide insieme agli altri.
              Si paga con Satispay o con un bonifico.
            </p>
            <PricingTiers tiers={tiers} />
            <p>
              <a class="home__more" href="/iscrizioni/">
                Come iscriversi e come pagare
                <ArrowIcon />
              </a>
            </p>
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>

<style>
  /*
    Full-bleed bands, alternating, rather than one column on a white page.

    Every section is edge to edge and the `.container` inside it keeps the text
    where the rest of the site keeps it. The tint is what separates one subject
    from the next now that the page has five of them.
  */
  .home__band {
    padding-block: var(--space-xl);
  }

  .home__band--tint {
    background-color: var(--color-bg-subtle);
    border-block: 1px solid var(--color-border);
  }

  .home__band > .container > :global(* + *) {
    margin-block-start: var(--space-sm);
  }

  /*
    No measure here at all. The intro is the page's opening statement, and
    anything narrower than the container leaves a wide screen looking half
    empty beside it.
  */
  .home__intro {
    font-size: var(--text-lg);
  }

  .home__intro :global(p + p) {
    margin-block-start: var(--space-sm);
  }

  .home__lead {
    color: var(--color-text-muted);
  }

  /*
    Fourteen names as pills, not as a sentence.

    A paragraph of links separated by dots was read as prose: the eye ran
    along the line instead of seeing fourteen places it could go. Each name
    is now its own target, on the raised surface so it stands off the tint
    this band carries.
  */
  .home__sites {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .home__sites :global(a) {
    display: block;
    /*
      Body line-height is set for paragraphs and made the pill far taller than
      it was wide. Tightened here, with the horizontal padding raised to match:
      the ring of space around the name is now even on all four sides.
    */
    padding: var(--space-3xs) var(--space-xs);
    line-height: 1.4;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background-color: var(--color-bg-raised);
    color: inherit;
    text-decoration: none;
    transition:
      border-color var(--transition),
      color var(--transition);
  }

  .home__sites :global(a:hover) {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  /* The ring the rest of the site draws, since the pill is the whole target. */
  .home__sites :global(a:focus-visible) {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .home__more {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3xs);
    font-weight: 500;
    text-decoration: none;
  }

  .home__more:hover {
    text-decoration: underline;
  }

  /* The same grid the listings use, so a card is the same size everywhere.
     `align-items: stretch` is the default and is the point: the cards in a row
     match, instead of each ending where its own summary does. */
  .home__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: var(--space-md);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .home__grid > li {
    display: flex;
  }

  .home__grid > li > :global(*) {
    flex: 1;
  }

  .hero {
    position: relative;
    /*
      Fills whatever is left of the first screen: body is a 100svh flex column,
      so `flex: 1` took the viewport minus the footer back when the hero was
      the only thing on the page. It is not any more, and with a sibling below
      it there is no free space to claim, so it collapsed to its content.

      Hence the floor. Not 100svh: a little of the text below should show, both
      because it says what the club is and because it is the only thing telling
      a phone there is more to scroll.
    */
    flex: 1;
    min-block-size: 60svh;
    display: grid;
    place-items: center;
    overflow: hidden;
    text-align: center;

    /*
      The hero is treated differently per scheme, deliberately.
      No `color-scheme` override here, each mode gets its own character:

      Heaviest at the top and nearly clear at the foot: the other way up from
      where this started. The scrim exists to carry the logo and the buttons,
      which sit in the upper half; running it the other way spent its density
      on the ridge line, which is the one part of the picture worth seeing.
      The credit sits over the clear end, and is the only thing there.

      LIGHT: barely there. The Drupal theme washed the picture out because its
      photograph was a flat grey sky worth hiding; this one is the reason the
      page has a photograph at all, and the header sits on pale blue where dark
      type holds up on its own.

      DARK: heavier than light, and heavier than it was: white type needs a
      ground, and the sky here is bright enough to take it away.

      Both are expressed as one light-dark() pair per gradient stop, so there is
      still a single place to tune each.
    */
    --hero-scrim-top: light-dark(rgb(255 255 255 / 0.16), rgb(22 25 28 / 0.67));
    --hero-scrim-bottom: light-dark(rgb(255 255 255 / 0.24), rgb(22 25 28 / 0.14));

    /*
      A soft pool behind the logo and the buttons.

      Once the linear scrim stopped covering the whole picture, the content had
      only whatever the sky happened to be behind it, and this sky is bright.
      The outline buttons' label measured 5.0:1 in light and 1.4:1 in dark
      against it. An ellipse with no visible edge puts a controlled ground
      under the content and leaves the rest of the photograph alone.
    */
    --hero-pool: light-dark(rgb(255 255 255 / 0.55), rgb(22 25 28 / 0.62));

    /*
      The credit sits on the clear end of the scrim, which is now the raw
      photograph in both schemes, so it takes a light colour in both, rather
      than following a token meant for a page background it is no longer on.
    */
    --hero-credit: rgb(255 255 255 / 0.88);
    --hero-credit-strong: rgb(255 255 255);
  }

  /*
    <Picture> applies `class` to the inner <img>, so positioning `.hero__bg`
    alone left the wrapping <picture> in flow: a second, empty grid row that
    `align-content: normal` (stretch) handed half the free space to, dropping
    the content into the lower half of the hero. Take the wrapper out of flow
    and the grid is back to a single centred row.
  */
  .hero :global(picture) {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .hero__bg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /*
      The Monviso, and the sky above it, are what this photograph is for.

      A wide hero crops a 3:2 picture hard, top and bottom, and `bottom` (which
      the old theme used, for a photograph whose subject was the ridge at its
      foot) cropped the peak away entirely and left a slope. 27% down puts the
      summit at about the middle of the band; on a phone, where the frame is
      taller than the picture and the crop happens sideways instead, only the
      50% matters.
    */
    object-position: 50% 27%;
  }

  /*
    Legibility scrim. The light values fold in what the Drupal theme achieved
    with `opacity: .8` on the image plus a 55%→80% white gradient, same result,
    one mechanism, so the image itself stays at full opacity in both modes.
  */
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(60% 42% at 50% 46%, var(--hero-pool) 0%, transparent 100%),
      linear-gradient(to bottom, var(--hero-scrim-top), var(--hero-scrim-bottom));
  }

  .hero__credit {
    position: absolute;
    inset-block-end: var(--space-2xs);
    /* Lines up with the container gutter the hero content uses. */
    inset-inline-end: var(--space-md);
    color: var(--hero-credit);
    font-size: var(--text-xs);
    /* No panel behind it: a shadow is enough over terrain, and a box here
       would be the loudest thing in the corner. */
    text-shadow: 0 1px 3px rgb(0 0 0 / 0.55);
    text-align: end;
  }

  /*
    Inline-flex and `nowrap`: as plain inline content the outward glyph was a
    separate word and wrapped onto a line of its own under the credit.
  */
  .hero__credit a {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    white-space: nowrap;
    color: inherit;
  }

  .hero__credit a:hover {
    color: var(--hero-credit-strong);
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
    padding-block: var(--header-height);
  }

  /*
    No hero-specific button treatment any more. It existed because the outline
    button's border used to be a UI grey that vanished against the photograph;
    now that the border is the brand blue it reads on the hero unaided, and
    the override's translucent white fill was fighting the ported hover state,
    leaving white text on a near-white background.
  */
</style>
