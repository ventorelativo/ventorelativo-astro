---
/**
 * /iscrizioni (C7): intro, membership tiers, bank-transfer fallback.
 *
 * The bank details stay visible whatever D10 decides: they are the zero-fee
 * route, and the one that works when a payment provider is between contracts.
 */
import { getEntry, render } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import PricingTiers from '../../components/PricingTiers.astro';
import MembershipForm from '../../components/MembershipForm.astro';
import H2 from '../../components/H2.astro';

const page = await getEntry('pages', 'iscrizioni');
if (!page) throw new Error('Missing src/content/pages/iscrizioni.mdx');
const { Content } = await render(page);
const { tiers, bankTransfer } = page.data;
---

<PageLayout
  title={page.data.title}
  description={page.data.description}
  ogRoute="iscrizioni"
>
  <div class="prose">
    <Content />
  </div>

  {tiers && <PricingTiers tiers={tiers} />}

  {
    /*
      The form comes after the cards because the cards are what someone is
      deciding between; the form is what they do once they have decided. Each
      card's button jumps here, which is why the heading's id is load-bearing:
      `PricingTiers` links to #iscriviti by hand.
    */
    tiers && (
      <section class="join">
        <H2>Iscriviti</H2>
        <p>
          Il pagamento avviene su Satispay, che ci dice quanto arriva ma non da chi.
          Lasciaci il tuo nome qui e la quota finisce nella colonna giusta.
        </p>
        <MembershipForm tiers={tiers} />
      </section>
    )
  }

  {
    bankTransfer && (
      <section class="bank">
        <H2>Bonifico bancario</H2>
        <p>Alternativamente, puoi effettuare un bonifico verso:</p>
        <p>
          <strong>{bankTransfer.holder}</strong>
          <br />
          {/* `notranslate`: an IBAN must survive GTranslate untouched. */}
          <span class="bank__iban notranslate">IBAN: {bankTransfer.iban}</span>
        </p>
      </section>
    )
  }
</PageLayout>

<style>
  .join {
    margin-block-start: var(--space-xl);
  }

  .join p {
    max-width: var(--prose-width);
  }

  .bank {
    margin-block-start: var(--space-xl);
    max-width: var(--prose-width);
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .bank__iban {
    /* An IBAN is read a character at a time when someone copies it by hand. */
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
  }
</style>
