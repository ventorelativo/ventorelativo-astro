---
/**
 * A news article (C10). URL preserved from Drupal: /news/<path.alias>.
 *
 * `getStaticPaths` is how a static build discovers dynamic routes: it runs at
 * build time and returns one entry per page to generate. Nothing is rendered on
 * demand, so a route that is not returned here simply does not exist.
 *
 * The slug comes from the filename via the glob loader, which is why the
 * content files are named after their live URLs: MIGRATION-PLAN.md §2.1 listed
 * `slug` as a field, but a field can drift from the filename and this cannot.
 */
import { getCollection, render } from 'astro:content';
import EntryLayout from '../../layouts/EntryLayout.astro';
import Badge from '../../components/Badge.astro';
import BlurImage from '../../components/BlurImage.astro';
import EventDetails from '../../components/EventDetails.astro';
import { MDX_COMPONENTS } from '../../components/mdx/components';
import { formatDate, isoDate } from '../../utils/date';

export async function getStaticPaths() {
  const articles = await getCollection('news', ({ data }) => !data.draft);
  return articles.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { title, date, summary, image, category, event } = entry.data;
const cardUrl = new URL(`/og/news/${entry.id}.jpg`, Astro.site).href;

// `summary` is deliberately not rendered here. It feeds the card blurb and the
// meta description (D7); on the page it sat directly above a first paragraph
// saying the same thing, because that is how a summary gets written.

// `render()` compiles the MDX body; <Content /> is the rendered result.
const { Content } = await render(entry);

/*
  The hero's box, known before a byte of the picture arrives.

  Article images are a mix of wide banners and portrait posters, so the hero
  keeps its natural shape and only its height is capped (see the style
  block). That used to be `width: auto; height: auto; max-height: 30rem`,
  which is the natural shape *once the file has arrived*: until then an
  `<img>` with `width: auto` has no definite dimension for its
  `width`/`height` attributes to give a ratio to, the box was nothing, and
  the whole article jumped 30rem when the picture landed. CLS 0.31 on a page
  whose body is text.

  Both numbers below come from the source image, so the box is settled in
  the HTML: the ratio for `aspect-ratio`, and the width a `max-height` of
  30rem implies at that ratio, which is what a portrait poster is actually
  as wide as. `sizes` says the same thing in the browser's own terms: the
  column is the viewport minus the container's padding, then the prose
  width, then that cap. A portrait poster capped at 30rem is 312 CSS px
  wide, and `100vw` had the browser fetching 832 px for it.
*/
const HERO_MAX_HEIGHT_REM = 30;
const PROSE_WIDTH_REM = 42; /* --prose-width, which `sizes` cannot read. */
const ratio = image ? image.src.width / image.src.height : 1;
const heroCapRem = (HERO_MAX_HEIGHT_REM * ratio).toFixed(2);
const heroSizes = `min(calc(100vw - 3rem), ${PROSE_WIDTH_REM}rem, ${heroCapRem}rem)`;
---

<EntryLayout
  title={title}
  description={summary}
  breadcrumbLabels={{ '/news': 'News' }}
  ogRoute={`news/${entry.id}`}
  type="article"
  publishedTime={date.toISOString()}
  article={{
    title,
    description: summary,
    image: cardUrl,
    published: date,
    section: category,
  }}
  event={event && {
    name: title,
    description: summary,
    image: cardUrl,
    start: event.start,
    end: event.end,
    location: event.location,
  }}
>
  <p class="meta" slot="meta">
    <Badge label={category} />
    <time datetime={isoDate(date)}>{formatDate(date)}</time>
  </p>

  {
    /* The other half of the morph from the teaser card: see global.css. */
    image && (
      <BlurImage
        slot="media"
        class="hero"
        style={`view-transition-name: post-${entry.id}; view-transition-class: post; --hero-ratio: ${image.src.width} / ${image.src.height}`}
        src={image.src}
        alt={image.alt}
        widths={[400, 700, 1400]}
        sizes={heroSizes}
        priority
      />
    )
  }

  {
    /*
    Components are handed to the body rather than imported inside it. MDX can
    do either, but an `import` line in a content file is something Keystatic
    refuses to parse, and something no club volunteer should have to type.
    See src/components/mdx/components.ts.
  */
  }
  {event && <EventDetails event={event} entry={entry} />}

  <Content components={MDX_COMPONENTS} />
</EntryLayout>

<style>
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  /*
    Article images are a mix of wide banners and portrait posters. Cropping to a
    fixed shape (object-fit: cover) threw most of a poster away, so instead the
    natural aspect ratio is kept and only the height is capped: wide images fill
    the column, tall ones stay whole.

    Written as a definite width and an explicit ratio rather than `max-height`
    on an `auto` box, because an auto box is only known once the file is: see
    the frontmatter. `--hero-ratio` is set inline on the image, `w / h` from
    the source, and the width is the column, the prose width, or the width
    the height cap implies at that ratio, whichever is least. Same result once
    loaded, and the same box before.

    Matched to the prose width and left-aligned with it: a centred image beside
    left-aligned text reads as a mistake, whatever its proportions.
  */
  .hero {
    --hero-max-height: 30rem;
    display: block;
    width: min(
      100%,
      var(--prose-width),
      calc(var(--hero-max-height) * var(--hero-ratio))
    );
    height: auto;
    aspect-ratio: var(--hero-ratio);
    border-radius: var(--radius-lg);
  }
</style>
