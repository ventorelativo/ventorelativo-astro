---
/**
 * Flight sites index (C4).
 *
 * MIGRATION-PLAN.md schedules /siti for Phase 4, because its composition is
 * intro → overview map → card grid → navdata links and the map is the risky
 * part. The grid needs none of that, and without this page the "Siti" nav item
 * — the site's most prominent link — points at a 404. So it ships now and the
 * map drops in above the grid in Phase 4.
 *
 * Sort: featured first, then alphabetical, as the Drupal view did (`sticky`
 * DESC, `title` ASC).
 */
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import SiteCard from '../../components/SiteCard.astro';

const sites = (await getCollection('sites')).sort((a, b) => {
  if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
  return a.data.title.localeCompare(b.data.title, 'it');
});
---

<PageLayout
  ogRoute="siti"
  title="Siti di volo"
  description="I siti di volo del Parapendio Club Ventorelativo, tra Pinerolo, Val Chisone e Val Pellice."
>
  {/* TODO(Phase 4): overview map of all 34 features goes here. */}

  <div class="site-grid">
    {sites.map((entry) => <SiteCard entry={entry} />)}
  </div>

  {/* TODO(Phase 4): navdata download links (OpenAir / CUP). */}
</PageLayout>

<style>
  .site-grid {
    display: grid;
    /* 20rem is the largest minimum that still fits three columns in the 68rem
       container — the three-across, ~350px card the old site had. */
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    /*
      Stretch, which is the grid default: every card in a row is as tall as the
      tallest. `align-items: start` was here to stop a card without a
      photograph being stretched to match one with; the cards carry no images
      any more, and now that some have tag pills and some do not, sizing each to
      its own content left the row ragged.
    */
    gap: var(--space-md);
  }
</style>
