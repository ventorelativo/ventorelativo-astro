---
/**
 * Flight sites index (C4).
 *
 * MIGRATION-PLAN.md schedules /siti for Phase 4, because its composition is
 * intro → overview map → card grid → navdata links and the map is the risky
 * part. The grid needs none of that, and without this page the "Siti" nav item
 * (the site's most prominent link) points at a 404. So it ships now and the
 * map drops in above the grid in Phase 4.
 *
 * Sort: featured first, then alphabetical, as the Drupal view did (`sticky`
 * DESC, `title` ASC).
 */
import { getCollection, getEntries, getEntry, render } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import SiteCard from '../../components/SiteCard.astro';
import NavdataLinks from '../../components/NavdataLinks.astro';
import FeatureIcons from '../../components/FeatureIcons.astro';
import SiteMap from '../../components/SiteMap.astro';

const sites = (await getCollection('sites')).sort((a, b) => {
  if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
  return a.data.title.localeCompare(b.data.title, 'it');
});

/*
  Every feature of every site, each carrying the site it belongs to so the map's
  popups can offer a way through to it.

  Deduplicated by id: several sites share a landing, Atterraggio Beba serves
  three, and drawing it three times would stack three identical markers and
  three identical popups on one spot. The first site to claim it wins, which is
  the alphabetical one, and the others still list it in their own tables.
*/
/*
  The page's own words, above the map.

  It had none: an h1, a map and a grid of names. That reads as a directory
  rather than a place, and it gives a search engine nothing to index about the
  area beyond fourteen site names, which is the one thing someone searching
  "parapendio val chisone" would not type.
*/
const page = await getEntry('pages', 'siti');
if (!page) throw new Error('Missing src/content/pages/siti.mdx');
const { Content } = await render(page);

const seen = new Set<string>();
const overview = (
  await Promise.all(
    sites.map(async (site) => {
      const features = await getEntries(site.data.mapFeatures);
      return features.map((feature) => ({
        ...feature.data,
        id: feature.id,
        site: { title: site.data.title, href: `/siti/${site.id}/` },
      }));
    }),
  )
)
  .flat()
  .filter((feature) => !seen.has(feature.id) && seen.add(feature.id));

/*
  The map stills, by slug. Built by `npm run map:posters` and committed: see
  the script for why they exist and how they are kept in step.
*/
const POSTERS = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/map-posters/*.webp',
  { eager: true },
);
const posterFor = (slug: string) =>
  POSTERS[`../../assets/map-posters/${slug}.webp`]?.default;
---

<PageLayout ogRoute="siti" title={page.data.title} description={page.data.description}>
  <div class="prose prose--full intro">
    <Content />
  </div>

  <FeatureIcons />
  <SiteMap features={overview} poster={posterFor('overview')} />

  <div class="site-grid">
    {sites.map((entry) => <SiteCard entry={entry} />)}
  </div>

  <NavdataLinks />
</PageLayout>

<style>
  .intro {
    margin-block-end: var(--space-lg);
  }

  .site-grid {
    display: grid;
    /* 20rem is the largest minimum that still fits three columns in the 68rem
       container: the three-across, ~350px card the old site had. */
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    /*
      Stretch, which is the grid default: every card in a row is as tall as the
      tallest. `align-items: start` was here to stop a card without a
      photograph being stretched to match one with; the cards carry no images
      any more, and now that some have tag pills and some do not, sizing each to
      its own content left the row ragged.
    */
    gap: var(--space-md);
  }
</style>
