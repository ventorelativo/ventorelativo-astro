---
/**
 * A flight site (C5). URL preserved from Drupal: /siti/<path.alias>.
 *
 * Composition per MIGRATION-PLAN.md §3 is title → map → body → gallery →
 * feature table → XContest links. Everything map-derived is Phase 4; what is
 * here is the body and the gallery, which is all the content the export holds.
 */
import { getCollection, render } from 'astro:content';
import EntryLayout from '../../layouts/EntryLayout.astro';
import Gallery from '../../components/Gallery.astro';

export async function getStaticPaths() {
  const sites = await getCollection('sites');
  return sites.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { title, summary, images } = entry.data;
const { Content } = await render(entry);
---

<EntryLayout
  title={title}
  description={summary}
  breadcrumbLabels={{ '/siti': 'Siti di volo' }}
>
  <p class="summary" slot="meta">{summary}</p>

  {/* TODO(Phase 4): this site's map, then the feature table and XContest links. */}

  <Content />

  {images.length > 0 && <Gallery images={images} title="Immagini" />}
</EntryLayout>

<style>
  /* The specs triplet, set as data rather than prose — same treatment as the
     card it also fills. */
  .summary {
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    font-variant-numeric: tabular-nums;
  }

</style>
