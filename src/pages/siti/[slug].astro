---
/**
 * A flight site (C5). URL preserved from Drupal: /siti/<path.alias>.
 *
 * Composition per MIGRATION-PLAN.md §3 is title → map → body → gallery →
 * feature table → XContest links. Everything map-derived is Phase 4; what is
 * here is the body and the gallery, which is all the content the export holds.
 */
import { getCollection, getEntries, render } from 'astro:content';
import EntryLayout from '../../layouts/EntryLayout.astro';
import Gallery from '../../components/Gallery.astro';
import Badge from '../../components/Badge.astro';
import SiteMap from '../../components/SiteMap.astro';
import FeatureIcons from '../../components/FeatureIcons.astro';
import FeatureTable from '../../components/FeatureTable.astro';
import XContestTakeoffs from '../../components/XContestTakeoffs.astro';
import ExternalIcon from '../../components/ExternalIcon.astro';
import { MDX_COMPONENTS } from '../../components/mdx/components';
import { formatDate } from '../../utils/date';

export async function getStaticPaths() {
  const sites = await getCollection('sites');
  return sites.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { title, summary, description, images, tags, guideUrl } = entry.data;

/*
  Events happening here, and only the ones still to come.

  A static build has to answer "is it in the past" twice: once now, so the
  page ships without events that are already over, and once in the browser,
  because the build is not rebuilt the morning after an event. Same trick the
  event panel uses for its "Evento concluso" state: render the answer, stamp
  the deadline in `data-ends`, and let three lines of script correct it.

  `endsAt` is the day after the last day, so an event is still "upcoming"
  while it is happening.
*/
const upcoming = (await getCollection('news', ({ data }) => !data.draft))
  .flatMap((post) => {
    const event = post.data.event;
    if (event?.site?.id !== entry.id) return [];
    const endsAt = new Date(event.end ?? event.start);
    endsAt.setUTCDate(endsAt.getUTCDate() + 1);
    return endsAt.getTime() > Date.now() ? [{ post, start: event.start, endsAt }] : [];
  })
  .sort((a, b) => a.start.getTime() - b.start.getTime());

/*
  Who to thank for the windgram.

  Keyed on the host rather than written into the card, because `guideUrl` is a
  content field an editor can repoint: hardcoding the name meant a URL sent
  somewhere else would still have credited this one, and a credit that can
  become a false attribution is worse than a label that can. An unknown host
  falls back to itself, which is at least true.

  Paragliding Kubernetes is one person's work, and he flies with the club.
*/
const WINDGRAM_PROVIDERS: Record<string, string> = {
  'paragliding-kubernetes.web-forge.info': 'Paragliding Kubernetes',
};

const provider = guideUrl
  ? (WINDGRAM_PROVIDERS[new URL(guideUrl).hostname] ?? new URL(guideUrl).hostname)
  : undefined;

/*
  `mapFeatures` holds references, not data: Zod's `reference()` stores the id
  and checks at build that the target exists, so a typo fails the build rather
  than rendering an empty table. `getEntries` resolves them, in the order the
  site lists them, which is the order Drupal's field held.
*/
const features = (await getEntries(entry.data.mapFeatures)).map(
  (feature) => feature.data,
);

// `summary` is deliberately not rendered here, as on news articles: it is the
// card blurb (D7), and on the page it only repeated
// the Località / Altitudine / Esposizione the body opens with.
const { Content } = await render(entry);

/*
  The site as a place, for the schema.org graph (S7, and the note in
  src/lib/schema.ts that said this waited on Phase 4's coordinates).

  Takeoffs only. A landing is part of a flight rather than somewhere anyone
  sets out for, and every one of them is already published, with the obstacle,
  in the two navdata files.
*/
const takeoffs = features
  .filter((feature) => feature.type === 'takeoff' && feature.point)
  .map((feature) => ({
    name: feature.name,
    lat: feature.point!.lat,
    lon: feature.point!.lon,
  }));

/*
  The map stills, by slug. Built by `npm run map:posters` and committed: see
  the script for why they exist and how they are kept in step.
*/
const POSTERS = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/map-posters/*.webp',
  { eager: true },
);
const posterFor = (slug: string) =>
  POSTERS[`../../assets/map-posters/${slug}.webp`]?.default;
---

<EntryLayout
  title={title}
  description={description ?? summary}
  breadcrumbLabels={{ '/siti': 'Siti di volo' }}
  ogRoute={`siti/${entry.id}`}
  place={{ name: title, description: description ?? summary, takeoffs, tags }}
>
  {
    tags.length > 0 && (
      <p class="tags" slot="meta">
        {tags.map((tag) => (
          <Badge label={tag} />
        ))}
      </p>
    )
  }

  {/* Once per page: the poster and the table both point at these. */}
  <FeatureIcons slot="media" />
  <SiteMap features={features} poster={posterFor(entry.id)} slot="media" />

  {
    /*
      Above the body, because it is the one thing on this page with a deadline:
      somebody who lands here in the week of an event should not have to scroll
      past the aerology to find out it is happening.
    */
    upcoming.length > 0 && (
      <ul class="upcoming" role="list">
        {upcoming.map(({ post, start, endsAt }) => (
          <li
            class="card card--link upcoming__item"
            data-upcoming
            data-ends={endsAt.toISOString()}
          >
            <span class="upcoming__icon" aria-hidden="true">
              <svg viewBox="0 0 20 20" width="20" height="20">
                <rect x="3" y="4.5" width="14" height="13" rx="2" />
                <path d="M3 8.5h14M7 2.5v4M13 2.5v4" />
              </svg>
            </span>
            <span class="upcoming__body">
              <a class="card__stretch upcoming__label" href={`/news/${post.id}/`}>
                {post.data.title}
              </a>
              <span class="upcoming__hint">Si vola qui il {formatDate(start)}</span>
            </span>
          </li>
        ))}
      </ul>
    )
  }

  <Content components={MDX_COMPONENTS} />

  {
    /*
      The site's windgram, when there is one. Below the body and above the
      flight points: it belongs with the reading, not with the data, and it is
      the one outward link here no coordinate can produce.
    */
    guideUrl && (
      <p class="guide" slot="sections">
        <a
          class="guide__link card card--link"
          href={guideUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="guide__icon" aria-hidden="true">
            <svg viewBox="0 0 20 20" width="20" height="20">
              <path d="M3.5 13a3 3 0 0 1 .4-6 4.5 4.5 0 0 1 8.6-1.2A3.4 3.4 0 1 1 14 13H3.5Z" />
              <path d="M6.5 16.5h7" />
            </svg>
          </span>
          <span class="guide__text">
            <span class="guide__label">Windgram e previsioni dettagliate</span>
            <span class="guide__source">
              Grazie a <span class="guide__partner">{provider}</span>
            </span>
          </span>
          <ExternalIcon class="guide__out" />
        </a>
      </p>
    )
  }

  <FeatureTable features={features} slot="sections" />

  <XContestTakeoffs features={features} slot="sections" />

  {
    /*
    The photographs come after the flight points, not before them. Someone
    reading a site page is deciding whether and where to fly it; the takeoffs,
    landings and hazards answer that, and the pictures are what they look at
    once they have.
  */
  }
  {images.length > 0 && <Gallery images={images} title="Immagini" slot="sections" />}
</EntryLayout>

<script>
  /*
    The build decided what was upcoming on the day it ran. A page served three
    weeks later is stale by exactly that much, so each card carries the day
    after its last day and checks it here. Same shape as the event panel's
    "Evento concluso" switch.
  */
  for (const card of document.querySelectorAll<HTMLElement>('[data-upcoming]')) {
    const ends = Date.parse(card.dataset.ends ?? '');
    if (ends && Date.now() >= ends) card.hidden = true;
  }
</script>

<style>
  /* The same mini card as the navigator files below, and as the site link on
     the news post this points at: one shape for "here is a related page". */
  .upcoming {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    margin: 0 0 var(--space-md);
    padding: 0;
    list-style: none;
  }

  .upcoming__item {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-xs) var(--space-sm);
  }

  .upcoming__icon {
    display: flex;
    flex: none;
    color: var(--color-accent);
  }

  .upcoming__icon svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .upcoming__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    min-width: 0;
  }

  .upcoming__label {
    color: var(--color-text-strong);
    font-weight: 500;
  }

  .upcoming__hint {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  /*
    A card row, not a button: it is a pointer to somebody else's page rather
    than an action on this one, and the source deserves saying out loud:
    "Windgram e previsioni" alone reads as a page of ours.
  */
  .guide__link {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    max-width: var(--prose-width);
    padding: var(--space-xs) var(--space-sm);
    color: inherit;
    text-decoration: none;
  }

  /* The name reads as a name, not as more of the sentence around it. */
  .guide__partner {
    color: var(--color-text-strong);
  }

  .guide__icon {
    display: flex;
    color: var(--color-accent);
  }

  .guide__icon svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .guide__text {
    display: flex;
    flex-direction: column;
    gap: 0.1em;
    min-width: 0;
  }

  .guide__label {
    color: var(--color-text-strong);
    font-weight: 500;
  }

  .guide__source {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  /*
    `:global`, because the icon is a component: Astro stamps its scope id on
    the elements *it* writes, so a class passed into `<ExternalIcon>` lands on
    an element carrying that component's id and never matches a rule scoped to
    this file. The rule looked right and did nothing.
  */
  .guide__link :global(.guide__out) {
    margin-inline-start: auto;
    color: var(--color-text-muted);
  }

  .guide__link:hover :global(.guide__out) {
    color: var(--color-accent);
  }

  .guide {
    margin-block: var(--space-lg) 0;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs);
  }
</style>
