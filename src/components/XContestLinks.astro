---
/**
 * The five XContest searches on /voli (X2).
 *
 * These are kept as-is from the Drupal block — same five, same order, same
 * emoji — with one fix (MIGRATION-PLAN.md §4.4).
 *
 * The date-scoped URLs were built with PHP's `date()` at build time, so
 * "Migliori giornata" froze to whenever the site was last deployed. A daily
 * rebuild used to hide that; it was switched off, and the archived build shows
 * `filter[date]=2026-07-10` — seven weeks stale at the time of writing.
 *
 * So: the build-time date goes into the markup as a floor, and a few lines of
 * script correct it to the actual date on load. Someone without JavaScript gets
 * what the old site gave everyone; everyone else gets today. Either way there
 * is no reason left to rebuild this site on a schedule.
 */
import ExternalIcon from './ExternalIcon.astro';
import { searchUrl, datesFrom } from '../lib/xcontest';

const today = datesFrom(new Date());

interface Link {
  icon: string;
  label: string;
  /** What the search actually returns, so nobody has to open five to find out. */
  hint: string;
  href: string;
  /** Which date the script should refresh, if any. */
  scope?: 'day' | 'month' | 'year';
}

/*
  The same five searches the Drupal block had, in the same order and with the
  same emoji — the club chose them and pilots know them. What is new is a line
  under each saying what it returns: the labels alone made you open all five to
  learn the difference between "giornata" and "sempre".
*/
const LINKS: Link[] = [
  {
    icon: '⏱️',
    label: 'Recenti',
    hint: 'Gli ultimi voli caricati, dal più nuovo',
    href: searchUrl({ sort: 'time_start' }),
  },
  {
    icon: '🐥',
    label: 'Migliori della giornata',
    hint: 'Il punteggio più alto di oggi',
    href: searchUrl({ sort: 'pts', date: today.day }),
    scope: 'day',
  },
  {
    icon: '🐓',
    label: 'Migliori del mese',
    hint: 'Il mese in corso, per punteggio',
    href: searchUrl({ sort: 'pts', date: today.month }),
    scope: 'month',
  },
  {
    icon: '🦅',
    label: 'Migliori dell’anno',
    hint: 'La stagione in corso, per punteggio',
    href: searchUrl({ sort: 'pts', date: today.year }),
    scope: 'year',
  },
  {
    icon: '🏆',
    label: 'Migliori di sempre',
    hint: 'Tutto l’archivio, dai voli più lunghi',
    href: searchUrl({ sort: 'pts' }),
  },
];
---

<ul class="xc">
  {
    LINKS.map(({ icon, label, hint, href, scope }) => (
      <li class="xc__item">
        <a
          class="xc__link card card--link"
          href={href}
          data-xc-scope={scope}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="xc__icon" aria-hidden="true">
            {icon}
          </span>
          <span class="xc__text">
            <span class="xc__label">{label}</span>
            <span class="xc__hint">{hint}</span>
          </span>
          {/* Says the link leaves the site, without a word of copy. */}
          <ExternalIcon class="xc__out" />
        </a>
      </li>
    ))
  }
</ul>

<style>
  /*
    Cards, not a row of identical buttons. Five blue pills reading "Migliori
    giornata / mese / anno / sempre" gave the eye nothing to sort them by, and
    the difference between them is the whole content of this page.
  */
  .xc {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-2xs);
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: var(--content-width);
  }

  .xc__item {
    display: flex;
  }

  /*
    The anchor is the card, rather than a stretched link inside one: there is
    nothing else in it, so wrapping adds an element and a `::after` for
    nothing. Surface and hover come from the `.card` primitive.
  */
  .xc__link {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    width: 100%;
    padding: var(--space-xs) var(--space-sm);
    color: inherit;
    text-decoration: none;
  }

  .xc__link:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .xc__icon {
    flex: none;
    font-size: 1.6rem;
    line-height: 1;
  }

  .xc__text {
    display: flex;
    flex-direction: column;
    gap: 0.1em;
    min-width: 0;
  }

  .xc__label {
    color: var(--color-text-strong);
    font-weight: 500;
  }

  .xc__hint {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    text-wrap: pretty;
  }

  /*
    `:global`, because the icon is a component: Astro stamps its scope id on
    the elements *it* writes, so a class passed into `<ExternalIcon>` lands on
    an element carrying that component's id and never matches a rule scoped to
    this file. The rule looked right and did nothing.
  */
  .xc__link :global(.xc__out) {
    margin-inline-start: auto;
    color: var(--color-text-muted);
  }

  .xc__link:hover :global(.xc__out) {
    color: var(--color-accent);
  }
</style>

<script>
  import { datesFrom } from '../lib/xcontest';

  function init() {
    const links = document.querySelectorAll<HTMLAnchorElement>('[data-xc-scope]');
    if (!links.length) return;

    const dates = datesFrom(new Date());
    for (const link of links) {
      const scope = link.dataset.xcScope as keyof typeof dates;
      if (!dates[scope]) continue;
      const url = new URL(link.href);
      url.searchParams.set('filter[date]', dates[scope]);
      link.href = url.toString();
    }
  }

  init();
  document.addEventListener('astro:after-swap', init);
</script>
