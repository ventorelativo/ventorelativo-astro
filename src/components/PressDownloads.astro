---
/**
 * The press kit's download grid.
 *
 * Each tile previews its artwork with an `<img>` pointing at the SVG the page
 * is offering, so what you look at is literally the file you get: no
 * possibility of a preview that has drifted from the download, which is a
 * mistake this component has already made once.
 *
 * The PNGs are 1-2 MB of 2000px artwork between them and are never loaded
 * here; the vectors are 2-3 kB each on the wire and cached.
 *
 * The list is `src/lib/press.ts`, which is also what generates the files: one
 * definition, so a tile cannot advertise something the build did not write.
 */
import sharp from 'sharp';

import { PRESS_VARIANTS, variantSource } from '../lib/press';

/*
  Each variant's real proportions, read from the artwork rather than assumed:
  the lockup, the bordered version and the square are three different shapes,
  and the "2000×825" on the label has to be the size the file actually is.
*/
const tiles = await Promise.all(
  PRESS_VARIANTS.map(async (variant) => {
    const meta = await sharp(await variantSource(variant)).metadata();
    const ratio = (meta.width ?? 1) / (meta.height ?? 1);
    const height = variant.height ?? Math.round(variant.width / ratio);
    return {
      ...variant,
      /* Previews are drawn from the vector when there is one. */
      preview: variant.formats.includes('svg')
        ? `/stampa/${variant.slug}.svg`
        : `/stampa/${PRESS_VARIANTS[0].slug}.svg`,
      ratio,
      pngSize: `${variant.width}×${height} px`,
    };
  }),
);
---

<ul class="press">
  {
    tiles.map((tile) => (
      <li class="press__item card">
        <span
          class:list={['press__preview', !tile.background && 'press__preview--check']}
          style={tile.background ? `background-color:${tile.background}` : undefined}
        >
          <img class="press__logo" src={tile.preview} alt="" width="120" height="52" />
        </span>

        <span class="press__body">
          <strong>{tile.label}</strong>
          <span class="press__use">{tile.use}</span>
        </span>

        <span class="press__get">
          {tile.formats.includes('svg') && (
            <a
              class="button button--outline"
              href={`/stampa/${tile.slug}.svg`}
              download
            >
              SVG
            </a>
          )}
          {tile.formats.includes('png') && (
            <a
              class="button button--outline"
              href={`/stampa/${tile.slug}.png`}
              download
            >
              PNG
            </a>
          )}
          <span class="press__meta">{tile.pngSize}</span>
        </span>
      </li>
    ))
  }
</ul>

<style>
  .press {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
    gap: var(--space-sm);
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: var(--content-width);
  }

  /* Surface from the `.card` primitive. No hover: the card is not the link,
     the buttons inside it are. */
  .press__item {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    padding: var(--space-sm);
  }

  .press__preview {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 6rem;
    padding: var(--space-sm);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  /*
    A checkerboard for the files with a transparent ground: the only way to
    show "transparent" that does not read as "white".
  */
  .press__preview--check {
    background-color: #ffffff;
    background-image:
      linear-gradient(45deg, #e6e8ec 25%, transparent 25%),
      linear-gradient(-45deg, #e6e8ec 25%, transparent 25%),
      linear-gradient(45deg, transparent 75%, #e6e8ec 75%),
      linear-gradient(-45deg, transparent 75%, #e6e8ec 75%);
    background-size: 16px 16px;
    background-position:
      0 0,
      0 8px,
      8px -8px,
      -8px 0;
  }

  /* `height: auto` so each drawing keeps its own proportions, three of the
     five are not the same shape. */
  .press__logo {
    width: auto;
    max-width: 100%;
    height: 3rem;
  }

  .press__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
  }

  .press__use {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    text-wrap: pretty;
  }

  .press__get {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs);
    margin-block-start: auto;
    padding-block-start: var(--space-2xs);
  }

  .press__meta {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }
</style>
