---
/**
 * A call-to-action link inside an article body.
 *
 * Replaces the `<a class="btn btn-primary btn-sm">` anchors the Drupal bodies
 * carried (MIGRATION-PLAN.md §2.4). Those hard-coded Bootstrap classes into
 * editor-authored HTML; when Bootstrap left, every one of them would have
 * become an unstyled link. Here the styling is the site's own `.button`
 * primitive, so these follow the design system automatically.
 *
 * External links get target/rel without the author having to remember.
 */
interface Props {
  href: string;
  variant?: 'primary' | 'outline';
}

const { href, variant = 'primary' } = Astro.props;
const external = /^https?:\/\//.test(href);
---

<a
  href={href}
  class:list={['button', variant === 'outline' && 'button--outline']}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
>
  <slot />
</a>
