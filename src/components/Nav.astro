---
/**
 * Primary navigation (G4) and the mobile drawer (G5).
 *
 * The Drupal theme used Bootstrap's `offcanvas-lg`, which needs Bootstrap's JS
 * bundle and hand-rolls its own focus handling. MIGRATION-PLAN.md §6.2 flagged
 * that as one of the accessibility issues to fix rather than port, so the
 * drawer is a native <dialog> opened with showModal(): the browser supplies the
 * focus trap, the Escape handler, inert-ing of background content, and the
 * top-layer stacking for free.
 *
 * One list, rendered once. Wide viewports show it inline; narrow ones show it
 * inside the dialog. No duplicated markup, so no duplicated landmarks.
 */
import { NAV } from '../consts';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<nav class="nav" aria-label="Navigazione principale">
  <button type="button" class="nav__trigger" aria-label="Apri il menu" data-nav-open>
    <svg viewBox="0 0 16 16" width="24" height="24" aria-hidden="true">
      <path
        fill="currentColor"
        fill-rule="evenodd"
        d="M2.5 11.5A.5.5 0 0 1 3 11h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zm0-4A.5.5 0 0 1 3 7h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zm0-4A.5.5 0 0 1 3 3h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5z"
      ></path>
    </svg>
  </button>

  <dialog class="nav__drawer" data-nav-drawer aria-label="Menu">
    <div class="nav__drawer-head">
      <button
        type="button"
        class="nav__close"
        aria-label="Chiudi il menu"
        data-nav-close
      >
        <svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true">
          <path
            fill="currentColor"
            d="M2.146 2.146a.5.5 0 0 1 .708 0L8 7.293l5.146-5.147a.5.5 0 0 1 .708.708L8.707 8l5.147 5.146a.5.5 0 0 1-.708.708L8 8.707l-5.146 5.147a.5.5 0 0 1-.708-.708L7.293 8 2.146 2.854a.5.5 0 0 1 0-.708"
          ></path>
        </svg>
      </button>
    </div>

    <ul class="nav__list">
      {
        NAV.map(({ label, href }) => (
          <li>
            <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </dialog>
</nav>

<style>
  /* ---------------------------------------------------------- shared list */

  .nav__list {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /*
    Measured from the old site's `.navbar-nav .nav-link`: uppercase, no letter
    spacing, 8px of vertical padding, an 8px horizontal margin and a 3px bottom
    rule that only shows on the current page. Colour runs on its own ramp:
    `rgba(0,0,0,.65)` rising to solid black: rather than the body text tokens.
  */
  .nav__list a {
    display: block;
    padding-block: 0.5rem;
    margin-inline: 0.5rem;
    color: var(--color-nav);
    line-height: 1.5;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    border-bottom: 3px solid transparent;
    transition:
      color var(--transition),
      border-color var(--transition);
  }

  /*
    Colour only. The 3px rule is reserved at every width for row height, but it
    is coloured in only in the inline bar: see the wide block below. In the
    drawer the current page is marked by an underline instead.
  */
  .nav__list a:hover {
    color: var(--color-nav-hover);
  }

  .nav__list a[aria-current='page'] {
    color: var(--color-nav-active);
  }

  /* --------------------------------------------------------- narrow: drawer */

  .nav__trigger,
  .nav__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-2xs);
    border: 0;
    border-radius: var(--radius-sm);
    background: none;
    color: var(--color-text-strong);
    cursor: pointer;
  }

  .nav__drawer {
    width: min(20rem, 85vw);
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0 0 0 auto;
    padding: var(--space-md);
    border: 0;
    border-inline-start: 1px solid var(--color-border);
    background-color: var(--color-bg);
    color: var(--color-text);
  }

  .nav__drawer::backdrop {
    background-color: light-dark(#0f172a4d, #00000080);
    backdrop-filter: blur(2px);
  }

  .nav__drawer-head {
    display: flex;
    justify-content: flex-end;
    margin-bottom: var(--space-md);
  }

  .nav__drawer .nav__list {
    flex-direction: column;
  }

  /* The drawer ran at 1.5rem/300: larger and lighter than the inline bar. The
     3px rule stays in place but transparent, so the row keeps its height and
     the current page is marked by an underline instead. */
  .nav__drawer .nav__list a {
    font-size: 1.5rem;
    font-weight: 300;
  }

  .nav__drawer .nav__list a[aria-current='page'] {
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  /* ---------------------------------------------------------- wide: inline */

  @media (width >= 52rem) {
    .nav__trigger {
      display: none;
    }

    /* The dialog stops being a dialog and becomes an inline list. `display`
       is what gates <dialog> visibility, so this needs !important to beat the
       UA sheet's `dialog:not([open]) { display: none }`. */
    .nav__drawer {
      display: contents !important;
    }

    .nav__drawer-head {
      display: none;
    }

    .nav__drawer .nav__list {
      flex-direction: row;
      /* The 8px gap is the links' own inline margin; no extra flex gap. */
      gap: 0;
    }

    .nav__drawer .nav__list a {
      font-size: 1.1rem;
      font-weight: 600;
    }

    /* Inline only: grey rule on hover, solid rule on the current page. */
    .nav__drawer .nav__list a:hover {
      border-bottom-color: var(--color-nav-rule-hover);
    }

    .nav__drawer .nav__list a[aria-current='page'],
    .nav__drawer .nav__list a[aria-current='page']:hover {
      border-bottom-color: currentColor;
      text-decoration: none;
    }
  }
</style>

<script>
  const WIDE = '(width >= 52rem)';

  function init() {
    const drawer = document.querySelector<HTMLDialogElement>('[data-nav-drawer]');
    const open = document.querySelector<HTMLButtonElement>('[data-nav-open]');
    const close = document.querySelector<HTMLButtonElement>('[data-nav-close]');
    if (!drawer || !open || !close) return;

    open.addEventListener('click', () => drawer.showModal());
    close.addEventListener('click', () => drawer.close());

    // Clicking the backdrop closes it. The dialog fills its own box, so a click
    // whose target is the dialog element itself landed outside the content.
    drawer.addEventListener('click', (event) => {
      if (event.target === drawer) drawer.close();
    });

    // Following a link inside the drawer should close it: matters when the
    // destination is the current page (an in-page anchor won't remount).
    drawer.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) drawer.close();
    });

    // If the viewport grows past the breakpoint while the dialog is open, it
    // would stay modal and trap focus around a nav that now looks inline.
    const wide = window.matchMedia(WIDE);
    wide.addEventListener('change', (event) => {
      if (event.matches && drawer.open) drawer.close();
    });
  }

  init();
  document.addEventListener('astro:after-swap', init);
</script>
