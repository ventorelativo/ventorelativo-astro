---
/**
 * The site's takeoffs, landings and hazards as a table (M-series).
 *
 * The map is the nice way to read this; the table is the reliable one. It
 * works with no JavaScript, no WebGL and no network, it can be read aloud, and
 * the coordinates can be selected and pasted into whatever a pilot actually
 * uses. That is also the fallback when the map cannot run at all.
 */
import { FEATURE_TYPES, type FeatureType } from '../lib/featureTypes';
import { FEATURE_SYMBOLS, symbolId } from '../lib/featureIcons';
import { forecastUrl, formatCoordinates, navigationUrl } from '../lib/coordinateLinks';
import type { LatLon } from '../lib/geo';
import ExternalIcon from './ExternalIcon.astro';
import H2 from './H2.astro';

interface Feature {
  name: string;
  type: FeatureType;
  point?: LatLon;
}

interface Props {
  features: Feature[];
}

const { features } = Astro.props;

/*
  Takeoffs first, then landings, then the rest: the order a pilot reads them
  in, rather than alphabetical. Within a group, by name.
*/
const ORDER: FeatureType[] = ['takeoff', 'landing', 'poi', 'obstacle'];
const sorted = [...features].sort(
  (a, b) =>
    ORDER.indexOf(a.type) - ORDER.indexOf(b.type) || a.name.localeCompare(b.name, 'it'),
);
---

{
  sorted.length > 0 && (
    <section class="features">
      <H2>Punti di volo</H2>

      {/* Scrolls itself rather than the page: AGENTS.md, wide content. */}
      <div class="features__scroll">
        <table>
          <thead>
            <tr>
              <th scope="col">Tipo</th>
              <th scope="col">Nome</th>
              <th scope="col">Coordinate</th>
              <th scope="col">Meteo</th>
            </tr>
          </thead>
          <tbody>
            {sorted.map((feature) => (
              <tr>
                <td>
                  {FEATURE_SYMBOLS[feature.type] ? (
                    <svg class="icon" viewBox="0 0 100 100" aria-hidden="true">
                      <use href={`#${symbolId(feature.type)}`} />
                    </svg>
                  ) : (
                    <span class={`dot dot--${feature.type}`} aria-hidden="true" />
                  )}
                  {FEATURE_TYPES[feature.type].label}
                </td>
                <th scope="row">{feature.name}</th>
                <td class="coords">
                  {feature.point ? (
                    /*
                      The coordinates are the link, as they are in the map's
                      popups: same destination, same decimal degrees, so a
                      pilot gets the same thing whichever they happen to be
                      looking at. Still selectable for copying into an
                      instrument: the outward mark is an SVG, so it carries no
                      text nodes and a selection of the cell yields the
                      coordinates and nothing else.
                    */
                    <a
                      href={navigationUrl(feature.point)}
                      target="_blank"
                      rel="noopener noreferrer"
                      title={`Naviga verso ${feature.name}`}
                    >
                      <span class="coords__value">
                        {formatCoordinates(feature.point)}
                      </span>
                      <ExternalIcon size={13} />
                    </a>
                  ) : (
                    <span class="none">n/d</span>
                  )}
                </td>
                <td class="forecast">
                  {/*
                    Takeoffs only, as in the map's popups: Meteo-Parapente
                    answers "can I fly from here", which is a question about the
                    hill you launch from. The cell is left empty rather than
                    dashed: a column of dashes says nothing and reads as
                    missing data.
                  */}
                  {feature.type === 'takeoff' && feature.point && (
                    <a
                      href={forecastUrl(feature.point)}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      <span>Previsioni</span>
                      <ExternalIcon size={13} />
                    </a>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )
}

<style>
  .features {
    margin-block: var(--space-lg);
  }

  /*
    Scroll shadows, ported from the old site (Bootstrap's `.table-responsive`,
    itself Roman Cortés' trick). Four backgrounds on the scrolling box: two
    covers in the page colour that scroll *with* the content (`local`), and two
    shadows pinned to the box's edges (`scroll`). At rest a cover sits exactly
    over its shadow and hides it; scroll away from an edge and the cover goes
    with the content, uncovering the shadow.

    The point is that it needs no JavaScript and no media query: the hint
    appears precisely when there is something to scroll to, on exactly the
    edges that have more table behind them, and disappears on a wide screen
    where the table fits.

    Deviation from the original: its covers fade from the first pixel, which
    leaves about a seventh of the shadow showing at rest. Ours holds the page
    colour solid for 20px (wider than the shadow) before it starts to fade,
    so at rest there is nothing to see at all.
  */
  .features__scroll {
    overflow-x: auto;
    background-color: var(--color-bg);
    background-image:
      linear-gradient(90deg, var(--color-bg) 0 20px, transparent),
      linear-gradient(-90deg, var(--color-bg) 0 20px, transparent),
      radial-gradient(farthest-side at 0 50%, var(--color-scroll-edge), transparent),
      radial-gradient(farthest-side at 100% 50%, var(--color-scroll-edge), transparent);
    background-position:
      0 0,
      100% 0,
      0 0,
      100% 0;
    background-repeat: no-repeat;
    background-size:
      60px 100%,
      60px 100%,
      14px 100%,
      14px 100%;
    background-attachment: local, local, scroll, scroll;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  th,
  td {
    padding: var(--space-2xs) var(--space-xs);
    border-block-end: 1px solid var(--color-border);
    text-align: start;
    white-space: nowrap;
  }

  thead th {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  tbody th {
    color: var(--color-text-strong);
    font-weight: 500;
    /* The name is the one column allowed to wrap on a narrow screen. */
    white-space: normal;
  }

  /*
    Sized to the cap height of the label beside it, so the two align.

    `display: inline-block` undoes global.css, which makes every svg a block,
    right for figures and diagrams, wrong for a glyph sitting in a line of text,
    where it pushed the label onto its own row.
  */
  .icon {
    display: inline-block;
    /*
      About 22 px at this text size, which is the size the artwork was drawn
      for and the size the map draws it at. Smaller was tried and failed on the
      landing target: its ring is 11 units of 100 with a white keyline eating
      both edges, so at 16 px under a pixel of green survived and it read as a
      plain dot.
    */
    width: 1.55em;
    height: 1.55em;
    margin-inline-end: 0.28em;
    vertical-align: -0.45em;
  }

  .dot {
    display: inline-block;
    width: 0.62em;
    height: 0.62em;
    /* Half of .icon's width, so dotted rows line up with iconned ones. */
    margin-inline: 0.26em 0.53em;
    border-radius: 50%;
    /* The keyline the icons have, so the two read as one family. */
    box-shadow: 0 0 0 2px var(--color-bg);
    vertical-align: baseline;
  }

  .dot--takeoff {
    background-color: var(--color-map-takeoff);
  }
  .dot--landing {
    background-color: var(--color-map-landing);
  }
  .dot--obstacle {
    background-color: var(--color-map-obstacle);
  }
  .dot--poi {
    background-color: var(--color-map-poi);
  }

  .coords {
    font-variant-numeric: tabular-nums;
  }

  /*
    These are links and have to look like it. Muted and undecorated was tried
    and read as plain text: nobody clicks what looks like a number. The link
    colour carries it; the underline is faint so a column of seven does not
    turn into stripes, and it firms up on hover.
  */
  .coords a {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    color: var(--color-accent);
  }

  /*
    The underline is on the value, not on the anchor: on the anchor it also
    ran under the outward glyph, which then read as part of the number.
  */
  .coords__value {
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, currentColor 35%, transparent);
  }

  .coords a:hover .coords__value,
  .coords a:focus-visible .coords__value {
    text-decoration-color: currentColor;
  }

  /* Label and glyph on one line: wrapped, the icon fell under the word and
     took the whole row with it. */
  .forecast a {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    white-space: nowrap;
  }

  .none {
    color: var(--color-text-muted);
  }
</style>
