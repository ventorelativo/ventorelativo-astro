---
/**
 * Fixed site header (G1, G2, G3).
 *
 * Ports the Drupal theme's `nav_branding` + `nav_main` regions and the
 * backdrop-blur treatment from _general.scss, minus the Drupal toolbar
 * displacement offsets and the `.path-frontpage` special-casing (which is now
 * a `transparent` prop rather than a body class).
 */
import Logo from './Logo.astro';
import Nav from './Nav.astro';
import { SITE } from '../consts';

interface Props {
  /** Homepage variant: sits over the hero with no background or border. */
  transparent?: boolean;
}

const { transparent = false } = Astro.props;
---

<header class:list={['header', transparent && 'header--transparent']}>
  <div class="header__inner container">
    {
      /*
      The name and slogan show on every page. The mark does not: on the homepage
      the hero carries it, centred and large, directly below, so repeating it
      in the header is the same logo twice on one screen.
    */
    }
    <a href="/" class="header__brand" rel="home">
      {
        /*
          Named for the view transition, and only ever rendered here when the
          homepage is not the page being shown, so the name is unique in the
          document, which it has to be. Coming from the homepage the browser
          matches this against the hero's big centred mark and flies one into
          the other; between two interior pages it holds still, which is also
          correct.
        */
      }
      {!transparent && <Logo style="view-transition-name: brand-mark" />}
      <span class="header__names">
        <span class="header__name">{SITE.name}</span>
        <span class="header__slogan">{SITE.slogan}</span>
      </span>
    </a>

    <Nav />
  </div>
</header>

<style>
  .header {
    position: fixed;
    inset-block-start: 0;
    inset-inline: 0;
    z-index: 100;
    height: var(--header-height);
    border-bottom: 1px solid var(--color-header-border);
    background-color: color-mix(in srgb, var(--color-header-bg) 80%, transparent);
    backdrop-filter: blur(8px);
    box-shadow: var(--shadow-chrome-down);
  }

  /*
    Transparent over the hero, glass once you leave it.

    The homepage used to be one screen, so a header that was transparent all
    the way down was right. It scrolls now, and the nav sat on the article text
    with nothing behind it.

    A scroll-driven animation, so this costs no JavaScript: the timeline is the
    document's own scroll, and the range is the height of the header itself, so
    the glass has arrived by the time anything has slid under it. Firefox has
    not shipped `animation-timeline` yet and simply keeps the transparent
    header it has today, which is the state this page shipped with.

    Not gated on `prefers-reduced-motion`: nothing moves. It is a cross-fade
    tied to scroll position, and a reader who has asked for less movement
    still needs the nav to be legible over the text.
  */
  @supports (animation-timeline: scroll()) {
    /*
      The glass is a layer that fades in, not colours that animate.

      Animating `background-color` straight to `var(--color-header-bg)` worked
      until someone changed the theme: a running animation keeps the keyframe
      values it resolved when it started, so `light-dark()` had already been
      collapsed to the old scheme's colour and the header stayed light on a
      dark page until the next reload. Only the reload restarted the animation.

      Fading a layer instead leaves every colour a live `var()` on a static
      rule, which follows `color-scheme` the moment it flips, and animates the
      one property that costs nothing to animate.
    */
    .header--transparent::after {
      content: '';
      position: absolute;
      /* -1px so the layer's own border sits where the header's border is. */
      inset: 0 0 -1px;
      z-index: -1;
      border-bottom: 1px solid var(--color-header-border);
      background-color: color-mix(in srgb, var(--color-header-bg) 80%, transparent);
      backdrop-filter: blur(8px);
      box-shadow: var(--shadow-chrome-down);

      /*
        Longhands, not the `animation` shorthand: the minifier folds
        `animation-timeline` into it as `animation: … scroll(root)`, which the
        shorthand does not accept, so the whole declaration is dropped and
        nothing animates. Checked in the built CSS, not assumed.
      */
      animation-name: header-glass;
      animation-fill-mode: both;
      animation-timing-function: linear;
      animation-timeline: scroll(root block);
      animation-range: 0 var(--header-height);
    }
  }

  @keyframes header-glass {
    from {
      opacity: 0;
    }

    to {
      opacity: 1;
    }
  }

  /*
    The whole transparent treatment is conditional on scroll-driven animation.

    Without it there is nothing to bring the glass back as the page scrolls, so
    the nav would sit on the photograph for the whole visit: legible over the
    dark end of it, barely legible over the bright sky. Firefox is the one that
    matters today. Those browsers keep the ordinary opaque header the rest of
    the site has, which is the honest fallback: less handsome, entirely
    readable, and nothing to maintain.
  */
  @supports (animation-timeline: scroll()) {
    .header--transparent {
      border-bottom-color: transparent;
      background-color: transparent;
      /*
        No shadow over the photograph. Everywhere else the header casts onto a
        content sheet and reads as depth; here it sits on the picture, where the
        same shadow reads as a seam across it.

        It lives here rather than on the homepage because a page's `:global()`
        rule cannot override a component's own scoped one: Astro compiles this
        file's `.header` to `.header[data-astro-cid-…]`, one specificity point
        above the bare `.header` a `:global()` produces.
      */
      box-shadow: none;
      backdrop-filter: none;

      /*
        Over the homepage hero there is no chrome behind the nav, and the light
        scheme's hero is a pale wash: `$gray-400` on top of it is all but
        invisible. Dark mode keeps the grey, where it reads fine against the
        photograph.
      */
      --color-nav-rule-hover: light-dark(rgba(0, 0, 0, 0.35), #ced4da);

      /*
        Dark mode's nav is 65% white everywhere else, over a solid header. Here
        it sits on the photograph, and measured 3.72:1 against the sky behind it:
        below the 4.5 a 17.6px link needs. 85% takes it to 5.06 and still reads
        as quieter than the active item, which is pure white.

        Light mode is untouched at 6.38:1: the scrim is doing the work there.
      */
      --color-nav: light-dark(rgba(0, 0, 0, 0.65), rgba(255, 255, 255, 0.85));
      --color-nav-hover: light-dark(rgba(0, 0, 0, 0.8), rgba(255, 255, 255, 0.95));
    }
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    height: 100%;
  }

  .header__brand {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    text-decoration: none;
  }

  .header__names {
    display: flex;
    flex-direction: column;
    line-height: var(--leading-tight);
  }

  /*
    Matches the old site's `.navbar-brand a.site-title`: uppercase and bold from
    the Bootstrap base theme, the vr subtheme's `letter-spacing: -0.02em` over
    the base's +2px, and the link colour rather than a text colour: the
    wordmark was blue there, and it is what ties the header to the brand.
  */
  .header__name {
    /* The old theme ran this at 1.5rem; --text-xl lands within a hair of that
       at desktop widths and shrinks sensibly on small screens. */
    font-size: var(--text-xl);
    font-weight: 700;
    letter-spacing: var(--tracking-tight);
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .header__slogan {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  /*
    The name stays at every width: it is how a visitor knows whose site this
    is. Only the slogan drops on narrow screens, where the logo artwork already
    carries it and the header would otherwise crowd the menu button.
  */
  @media (width < 26rem) {
    .header__slogan {
      display: none;
    }
  }
</style>
