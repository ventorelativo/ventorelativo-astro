---
/**
 * Fixed site header (G1, G2, G3).
 *
 * Ports the Drupal theme's `nav_branding` + `nav_main` regions and the
 * backdrop-blur treatment from _general.scss, minus the Drupal toolbar
 * displacement offsets and the `.path-frontpage` special-casing (which is now
 * a `transparent` prop rather than a body class).
 */
import Logo from './Logo.astro';
import Nav from './Nav.astro';
import { SITE } from '../consts';

interface Props {
  /** Homepage variant: sits over the hero with no background or border. */
  transparent?: boolean;
}

const { transparent = false } = Astro.props;
---

<header class:list={['header', transparent && 'header--transparent']}>
  <div class="header__inner container">
    {
      /*
        The homepage hero carries the mark and the wordmark directly below this,
        so repeating them in the header is duplication — and a "go home" link on
        the home page is noise. The Drupal theme reached the same conclusion the
        long way round, hiding the logo with `visibility:hidden;width:0` in
        _front.scss. Omitted outright here.
      */
      !transparent && (
        <a href="/" class="header__brand" rel="home">
          <Logo />
          <span class="header__names">
            <span class="header__name">{SITE.name}</span>
            <span class="header__slogan">{SITE.slogan}</span>
          </span>
        </a>
      )
    }

    <Nav />
  </div>
</header>

<style>
  .header {
    position: fixed;
    inset-block-start: 0;
    inset-inline: 0;
    z-index: 100;
    height: var(--header-height);
    border-bottom: 1px solid var(--color-border);
    background-color: color-mix(in srgb, var(--color-bg) 80%, transparent);
    backdrop-filter: blur(8px);
  }

  .header--transparent {
    border-bottom-color: transparent;
    background-color: transparent;
    backdrop-filter: none;

    /*
      No color-scheme override: the hero is pale in light mode and dark in dark
      mode (see index.astro), so the normal per-scheme text tokens already give
      the nav the right contrast over it in both.
    */
  }

  .header__inner {
    display: flex;
    align-items: center;
    /* flex-end so the nav stays right-aligned when the brand is omitted. */
    justify-content: space-between;
    gap: var(--space-md);
    height: 100%;
  }

  .header--transparent .header__inner {
    justify-content: flex-end;
  }

  .header__brand {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    color: var(--color-text-strong);
    text-decoration: none;
  }

  .header__names {
    display: flex;
    flex-direction: column;
    line-height: var(--leading-tight);
  }

  .header__name {
    font-size: var(--text-lg);
    font-weight: 600;
    letter-spacing: var(--tracking-tight);
  }

  .header__slogan {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  /* The wordmark is inside the logo art, so the text is redundant beside it on
     narrow screens — same call the old theme made in _general.scss. */
  @media (width < 30rem) {
    .header__names {
      display: none;
    }
  }
</style>
