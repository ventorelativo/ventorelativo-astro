---
/**
 * Fixed site header (G1, G2, G3).
 *
 * Ports the Drupal theme's `nav_branding` + `nav_main` regions and the
 * backdrop-blur treatment from _general.scss, minus the Drupal toolbar
 * displacement offsets and the `.path-frontpage` special-casing (which is now
 * a `transparent` prop rather than a body class).
 */
import Logo from './Logo.astro';
import Nav from './Nav.astro';
import { SITE } from '../consts';

interface Props {
  /** Homepage variant: sits over the hero with no background or border. */
  transparent?: boolean;
}

const { transparent = false } = Astro.props;
---

<header class:list={['header', transparent && 'header--transparent']}>
  <div class="header__inner container">
    {
      /*
      The name and slogan show on every page. The mark does not: on the homepage
      the hero carries it, centred and large, directly below, so repeating it
      in the header is the same logo twice on one screen.
    */
    }
    <a href="/" class="header__brand" rel="home">
      {
        /*
          Named for the view transition, and only ever rendered here when the
          homepage is not the page being shown, so the name is unique in the
          document, which it has to be. Coming from the homepage the browser
          matches this against the hero's big centred mark and flies one into
          the other; between two interior pages it holds still, which is also
          correct.
        */
      }
      {!transparent && <Logo style="view-transition-name: brand-mark" />}
      <span class="header__names">
        <span class="header__name">{SITE.name}</span>
        <span class="header__slogan">{SITE.slogan}</span>
      </span>
    </a>

    <Nav />
  </div>
</header>

<style>
  .header {
    position: fixed;
    inset-block-start: 0;
    inset-inline: 0;
    z-index: 100;
    height: var(--header-height);
    border-bottom: 1px solid var(--color-header-border);
    background-color: color-mix(in srgb, var(--color-header-bg) 80%, transparent);
    backdrop-filter: blur(8px);
    box-shadow: var(--shadow-chrome-down);
  }

  .header--transparent {
    border-bottom-color: transparent;
    background-color: transparent;
    /*
      No shadow over the photograph. Everywhere else the header casts onto a
      content sheet and reads as depth; here it sits on the picture, where the
      same shadow reads as a seam across it.

      It lives here rather than on the homepage because a page's `:global()`
      rule cannot override a component's own scoped one: Astro compiles this
      file's `.header` to `.header[data-astro-cid-…]`, one specificity point
      above the bare `.header` a `:global()` produces.
    */
    box-shadow: none;
    backdrop-filter: none;

    /*
      Over the homepage hero there is no chrome behind the nav, and the light
      scheme's hero is a pale wash: `$gray-400` on top of it is all but
      invisible. Dark mode keeps the grey, where it reads fine against the
      photograph.
    */
    --color-nav-rule-hover: light-dark(rgba(0, 0, 0, 0.35), #ced4da);

    /*
      No color-scheme override: the hero is pale in light mode and dark in dark
      mode (see index.astro), so the normal per-scheme text tokens already give
      the nav the right contrast over it in both.
    */
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    height: 100%;
  }

  .header__brand {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    text-decoration: none;
  }

  .header__names {
    display: flex;
    flex-direction: column;
    line-height: var(--leading-tight);
  }

  /*
    Matches the old site's `.navbar-brand a.site-title`: uppercase and bold from
    the Bootstrap base theme, the vr subtheme's `letter-spacing: -0.02em` over
    the base's +2px, and the link colour rather than a text colour: the
    wordmark was blue there, and it is what ties the header to the brand.
  */
  .header__name {
    /* The old theme ran this at 1.5rem; --text-xl lands within a hair of that
       at desktop widths and shrinks sensibly on small screens. */
    font-size: var(--text-xl);
    font-weight: 700;
    letter-spacing: var(--tracking-tight);
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .header__slogan {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  /*
    The name stays at every width: it is how a visitor knows whose site this
    is. Only the slogan drops on narrow screens, where the logo artwork already
    carries it and the header would otherwise crowd the menu button.
  */
  @media (width < 26rem) {
    .header__slogan {
      display: none;
    }
  }
</style>
