---
/**
 * Fixed site header (G1, G2, G3).
 *
 * Ports the Drupal theme's `nav_branding` + `nav_main` regions and the
 * backdrop-blur treatment from _general.scss, minus the Drupal toolbar
 * displacement offsets and the `.path-frontpage` special-casing (which is now
 * a `transparent` prop rather than a body class).
 */
import Logo from './Logo.astro';
import Nav from './Nav.astro';
import { SITE } from '../consts';

interface Props {
  /** Homepage variant: sits over the hero with no background or border. */
  transparent?: boolean;
}

const { transparent = false } = Astro.props;
---

<header class:list={['header', transparent && 'header--transparent']}>
  <div class="header__inner container">
    {/*
      The brand shows on every page, homepage included. The hero below repeats
      the mark, but the header is where a visitor looks for who this is, and on
      the homepage the hero's own wordmark is visually hidden so the two do not
      compete.
    */}
    <a href="/" class="header__brand" rel="home">
      <Logo />
      <span class="header__names">
        <span class="header__name">{SITE.name}</span>
        <span class="header__slogan">{SITE.slogan}</span>
      </span>
    </a>

    <Nav />
  </div>
</header>

<style>
  .header {
    position: fixed;
    inset-block-start: 0;
    inset-inline: 0;
    z-index: 100;
    height: var(--header-height);
    border-bottom: 1px solid var(--color-border);
    background-color: color-mix(in srgb, var(--color-bg) 80%, transparent);
    backdrop-filter: blur(8px);
  }

  .header--transparent {
    border-bottom-color: transparent;
    background-color: transparent;
    backdrop-filter: none;

    /*
      No color-scheme override: the hero is pale in light mode and dark in dark
      mode (see index.astro), so the normal per-scheme text tokens already give
      the nav the right contrast over it in both.
    */
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    height: 100%;
  }

  .header__brand {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    color: var(--color-text-strong);
    text-decoration: none;
  }

  .header__names {
    display: flex;
    flex-direction: column;
    line-height: var(--leading-tight);
  }

  .header__name {
    font-size: var(--text-lg);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .header__slogan {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  /*
    The name stays at every width — it is how a visitor knows whose site this
    is. Only the slogan drops on narrow screens, where the logo artwork already
    carries it and the header would otherwise crowd the menu button.
  */
  @media (width < 26rem) {
    .header__slogan {
      display: none;
    }
  }
</style>
