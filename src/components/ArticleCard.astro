---
/**
 * A news teaser (the Drupal `article` "listing" view mode / `vr_articlecard`).
 *
 * The whole card is clickable but only the title is a link: the pseudo-element
 * below stretches that one anchor over the card. Wrapping everything in an <a>
 * instead would make screen readers announce the date, badge and summary as
 * part of the link text, and would nest the card's own links illegally.
 */
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Badge from './Badge.astro';
import { formatDate, isoDate } from '../utils/date';

interface Props {
  entry: CollectionEntry<'news'>;
}

const { entry } = Astro.props;
const { title, date, summary, image, category } = entry.data;
const href = `/news/${entry.id}/`;
---

<article class="card">
  {
    image && (
      <Image
        class="card__image"
        src={image.src}
        alt={image.alt}
        widths={[400, 800]}
        sizes="(width < 48rem) 100vw, 24rem"
        quality={70}
        loading="lazy"
      />
    )
  }

  <div class="card__body">
    <p class="card__meta">
      <Badge label={category} />
      <time datetime={isoDate(date)}>{formatDate(date)}</time>
    </p>

    <h2 class="card__title">
      <a href={href}>{title}</a>
    </h2>

    <p class="card__summary">{summary}</p>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background-color: var(--color-bg-raised);
    transition: border-color var(--transition);
  }

  .card:hover {
    border-color: var(--color-border-strong);
  }

  .card__image {
    width: 100%;
    height: 12rem;
    object-fit: cover;
  }

  .card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    padding: var(--space-sm);
  }

  .card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  /* Overrides the global heading rule, as SiteCard does: the old card titles
     were 1.5rem/500 in the body colour, not the heading blue. */
  .card__title {
    color: var(--color-text);
    font-size: 1.5rem;
    font-weight: 500;
  }

  .card__title a {
    color: inherit;
    text-decoration: none;
  }

  /* Stretches the title link across the whole card. */
  .card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .card:hover .card__title a {
    color: var(--color-accent);
  }

  .card__summary {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
</style>
