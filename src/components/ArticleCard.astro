---
/**
 * A news teaser (the Drupal `article` "listing" view mode / `vr_articlecard`).
 *
 * The whole card is clickable but only the title is a link: the pseudo-element
 * below stretches that one anchor over the card. Wrapping everything in an <a>
 * instead would make screen readers announce the date, badge and summary as
 * part of the link text, and would nest the card's own links illegally.
 */
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Badge from './Badge.astro';
import { formatDate, isoDate } from '../utils/date';
import { FEATURE_SYMBOLS } from '../lib/featureIcons';

interface Props {
  entry: CollectionEntry<'news'>;
  /**
   * Set on the first card of a listing. Its image is the LCP element, and
   * `loading="lazy"` on the LCP element is a measured delay, not a saving:
   * a lazy image is invisible to the preload scanner and is not requested
   * until layout has run. On slow 3G that cost 1.5s here.
   */
  priority?: boolean;
}

const { entry, priority = false } = Astro.props;

/*
  Half of the morph into the article's hero (see global.css). The name has to
  be unique in the document, so it carries the slug; the class is what the
  stylesheet can target, since the name is not knowable there.
*/

/*
  Cropped at build time to the box it is displayed in, not resized to the
  card's width and cropped in the browser.

  The difference is most of the page. These are portrait posters; the card
  shows a 340x192 letterbox of one. Asking for 800w gave an 800x1231 image —
  145 kB — of which the browser drew a 384px-tall strip and discarded the
  rest. `fit: cover` makes sharp do the same crop, once, at build.

  The candidate widths are chosen against the sizes below, not picked round:
  a phone at 390 CSS px needs 684 device px, so a 680 candidate is one pixel
  short and the browser silently steps up to the next one. That mistake cost
  45 kB a page until it was measured.
*/
const CARD_IMAGE = {
  width: 340,
  /* 12rem, the height `.card__image` is pinned to below. */
  height: 192,
  fit: 'cover',
  position: 'center',
} as const;
const { title, date, summary, image, category, event } = entry.data;
/*
  An event's card says so before you read it: the day sits on the image and
  the takeoff replaces nothing — it is added under the title. A post without
  `event` gets neither and reads as an article, which is the whole reason
  events live inside `news` rather than in a collection of their own.
*/
const it = (options: Intl.DateTimeFormatOptions) =>
  new Intl.DateTimeFormat('it-IT', options);
const when = event && {
  day: it({ day: 'numeric' }).format(event.start),
  month: it({ month: 'short' }).format(event.start).replace('.', ''),
  iso: isoDate(event.start),
};
const href = `/news/${entry.id}/`;
---

<article class="card card--link">
  {
    /* The date chip lives with the image so it can sit on it. */
    image && (
      <div class="card__media">
        {when && (
          <time class="card__when" datetime={when.iso}>
            <span class="card__day">{when.day}</span>
            <span class="card__month">{when.month}</span>
          </time>
        )}
        <Image
          class="card__image"
          style={`view-transition-name: post-${entry.id}; view-transition-class: post`}
          src={image.src}
          alt={image.alt}
          {...CARD_IMAGE}
          widths={[400, 700, 900]}
          sizes="(width < 48rem) calc(100vw - 3rem), (width < 64rem) calc(50vw - 3rem), 21rem"
          quality={70}
          loading={priority ? 'eager' : 'lazy'}
          fetchpriority={priority ? 'high' : 'auto'}
        />
      </div>
    )
  }

  <div class="card__body">
    <p class="card__meta">
      <Badge label={category} />
      <time datetime={isoDate(date)}>{formatDate(date)}</time>
    </p>

    <h2 class="card__title">
      <a class="card__stretch" href={href}>
        {title}
      </a>
    </h2>

    {
      event && (
        <p class="card__where">
          <svg viewBox="0 0 100 100" width="16" height="16" aria-hidden="true">
            <g class="glyph" set:html={FEATURE_SYMBOLS.takeoff} />
          </svg>
          {event.location}
        </p>
      )
    }

    <p class="card__summary">{summary}</p>
  </div>
</article>

<style>
  /* Surface, shadow and hover come from the `.card` primitive in global.css. */
  .card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .card__media {
    position: relative;
  }

  .card__image {
    width: 100%;
    height: 12rem;
    object-fit: cover;
    /* The image is a block; without this the media box keeps a text baseline
       gap under it and the chip's corner never lines up. */
    display: block;
  }

  /*
    The day, on the picture. It is the one thing that distinguishes an event
    from an article at a glance, and a badge in the body would be a fourth
    thing competing with the category, the date and the title.
  */
  .card__when {
    position: absolute;
    z-index: 1;
    inset-block-start: var(--space-2xs);
    inset-inline-start: var(--space-2xs);
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 3rem;
    padding: var(--space-3xs) var(--space-2xs);
    border-radius: var(--radius-md);
    background-color: var(--brand-blue);
    color: var(--color-on-brand);
    line-height: 1.05;
    box-shadow: var(--shadow-md);
  }

  .card__day {
    font-size: var(--text-lg);
    font-weight: 500;
  }

  .card__month {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }

  .card__where {
    display: flex;
    align-items: center;
    gap: var(--space-3xs);
    color: var(--color-text-strong);
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .card__where .glyph {
    flex: none;
    fill: var(--color-map-takeoff);
  }

  .card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    padding: var(--space-sm);
  }

  .card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  /* The size and weight are the old card's; the colour is the heading blue,
     as it is on every other heading. */
  .card__title {
    font-size: 1.5rem;
    font-weight: 500;
  }

  .card__title a {
    color: inherit;
    text-decoration: none;
  }

  .card:hover .card__title a {
    color: var(--color-accent-hover);
  }

  .card__summary {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
</style>
