---
/**
 * The mark that says a link leaves the site.
 *
 * One drawing, used everywhere an outward link appears, so "this opens
 * somewhere else" looks the same on a card, in a button and in a sentence.
 * Drawn here rather than pulled from an icon package (AGENTS.md rule 6) — it
 * is eleven path commands.
 *
 * `aria-hidden`, always: the information it carries is already in the link's
 * text, and a screen reader announcing "opens in a new tab" belongs in the
 * accessible name if it belongs anywhere, not in a decorative glyph.
 */
interface Props {
  /** Rendered size in px. Matches the text it sits beside. */
  size?: number;
  class?: string;
}

const { size = 16, class: className } = Astro.props;
---

<svg
  class:list={['external', className]}
  viewBox="0 0 20 20"
  width={size}
  height={size}
  aria-hidden="true"
  focusable="false"
>
  <path d="M11 4h5v5M16 4l-7 7M15 12v3.5a1.5 1.5 0 0 1-1.5 1.5h-9A1.5 1.5 0 0 1 3 15.5v-9A1.5 1.5 0 0 1 4.5 5H8"
  ></path>
</svg>

<style>
  .external {
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
