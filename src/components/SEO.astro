---
/**
 * Per-page metadata (S1, S2, S4, S5).
 *
 * Replaces the Drupal `metatag` defaults. Same title pattern, same description,
 * same canonical, same Open Graph set; Twitter's tags are added because the
 * card type is what decides whether a shared link shows a large image or a
 * thumbnail, and the old config left it to chance.
 *
 * Cards are generated per page (S3) by src/pages/og/[...route].jpg.ts. `ogRoute`
 * names which one; anything without a card (/404, the thank-you page) falls
 * back to the club's static card.
 */
import { SITE } from '../consts';

interface Props {
  title?: string;
  description?: string;
  /** Route of this page's generated card, e.g. `siti/montoso`. */
  ogRoute?: string;
  imageAlt?: string;
  /** `article` for news posts; anything else is a page. */
  type?: 'website' | 'article';
  /** ISO date, for articles. */
  publishedTime?: string;
  /**
   * What follows the pipe in the title. Left unset it is chosen to fit: see
   * below. Pass one only to override that.
   */
  suffix?: string;
}

const {
  title,
  description = SITE.description,
  ogRoute,
  imageAlt,
  type = 'website',
  publishedTime,
  suffix,
} = Astro.props;

/*
  Drupal's template was '[current-page:title] | [site:name]', so every title
  ended "| VentoRelativo" and the word people actually search for, the sport,
  appeared on no page but the home one. The suffix carries the slogan now, so
  "Bourcet" can be found by "bourcet parapendio" and not only by the club's
  name.

  A prop, because the homepage's own title says "Parapendio" already and would
  otherwise say it twice.
*/
/*
  The suffix is whichever one still fits.

  A result truncates around sixty characters, and three titles here ran to
  seventy-nine: the words spent past that are spent on nothing. So the long
  suffix where there is room for it, the club's name where there is not, and
  nothing at all where even that does not fit. A post's own title is the club's
  words and is left alone; Google prints the site's name beside a result
  anyway, from the `WebSite` node.
*/
const LONG = `${SITE.name} ${SITE.slogan}`;
const MAX_TITLE = 60;
const fitted = (name: string) =>
  !title || `${title} | ${name}`.length <= MAX_TITLE ? name : null;
const chosen = suffix ?? fitted(LONG) ?? fitted(SITE.name);

const pageTitle = title ? (chosen ? `${title} | ${chosen}` : title) : LONG;
const canonical = new URL(Astro.url.pathname, Astro.site);

const ogImage = new URL(
  ogRoute ? `/og/${ogRoute}.jpg` : '/social-card.png',
  Astro.site,
);
const ogImageAlt = imageAlt ?? `${title ?? SITE.name} | ${SITE.name}`;
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={title ?? SITE.name} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:type" content={type} />
<meta property="og:locale" content="it_IT" />
<meta property="og:image" content={ogImage} />
<meta property="og:image:alt" content={ogImageAlt} />
<meta property="og:image:width" content="1280" />
<meta property="og:image:height" content="640" />

{publishedTime && <meta property="article:published_time" content={publishedTime} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title ?? SITE.name} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={ogImageAlt} />
