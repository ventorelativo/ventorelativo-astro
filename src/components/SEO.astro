---
/**
 * Per-page metadata (S1, S2, S4, S5).
 *
 * Replaces the Drupal `metatag` defaults. Same title pattern, same description,
 * same canonical, same Open Graph set; Twitter's tags are added because the
 * card type is what decides whether a shared link shows a large image or a
 * thumbnail, and the old config left it to chance.
 *
 * Cards are generated per page (S3) by src/pages/og/[...route].jpg.ts. `ogRoute`
 * names which one; anything without a card — /404, the thank-you page — falls
 * back to the club's static card.
 */
import { SITE } from '../consts';

interface Props {
  title?: string;
  description?: string;
  /** Route of this page's generated card, e.g. `siti/montoso`. */
  ogRoute?: string;
  imageAlt?: string;
  /** `article` for news posts; anything else is a page. */
  type?: 'website' | 'article';
  /** ISO date, for articles. */
  publishedTime?: string;
}

const {
  title,
  description = SITE.description,
  ogRoute,
  imageAlt,
  type = 'website',
  publishedTime,
} = Astro.props;

// metatag.metatag_defaults.global.yml: '[current-page:title] | [site:name]'
const pageTitle = title ? `${title} | ${SITE.name}` : SITE.name;
const canonical = new URL(Astro.url.pathname, Astro.site);

const ogImage = new URL(
  ogRoute ? `/og/${ogRoute}.jpg` : '/social-card.png',
  Astro.site,
);
const ogImageAlt = imageAlt ?? `${title ?? SITE.name} — ${SITE.name}`;
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={title ?? SITE.name} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:type" content={type} />
<meta property="og:locale" content="it_IT" />
<meta property="og:image" content={ogImage} />
<meta property="og:image:alt" content={ogImageAlt} />
<meta property="og:image:width" content="1280" />
<meta property="og:image:height" content="640" />

{publishedTime && <meta property="article:published_time" content={publishedTime} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title ?? SITE.name} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={ogImageAlt} />
