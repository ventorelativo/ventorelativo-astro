---
/**
 * The page's structured data, as one `@graph` (S7).
 *
 * Always: the club and the website. Additionally, whatever the page can say
 * about itself: its breadcrumb trail, and for a news post the article. See
 * src/lib/schema.ts for what each node claims and what is deliberately left out.
 *
 * `set:html` rather than an expression, because Astro escapes quotes in text
 * content and that would break the JSON.
 */
import { crumbsFor } from '../lib/breadcrumbs';
import {
  articleNode,
  breadcrumbNode,
  clubNode,
  eventNode,
  graph,
  placeNode,
  websiteNode,
  type ArticleInput,
  type EventInput,
  type PlaceInput,
} from '../lib/schema';

interface Props {
  /** Page title, used as the last breadcrumb. */
  title?: string;
  breadcrumbLabels?: Record<string, string>;
  /** Present on news posts. */
  article?: Omit<ArticleInput, 'url'>;
  /** Present when that post announces an event. */
  event?: Omit<EventInput, 'url'>;
  /** Present on a flight site: the SportsActivityLocation node's fields. */
  place?: Omit<PlaceInput, 'url'>;
}

const { title, breadcrumbLabels, article, event, place } = Astro.props;

const site = Astro.site ?? new URL('https://www.ventorelativo.it');
const url = new URL(Astro.url.pathname, site);

const data = graph([
  clubNode(site),
  websiteNode(site),
  breadcrumbNode(site, crumbsFor(Astro.url.pathname, title, breadcrumbLabels)),
  article ? articleNode(site, { ...article, url }) : undefined,
  event ? eventNode(site, { ...event, url }) : undefined,
  place ? placeNode(site, { ...place, url }) : undefined,
]);
---

<script type="application/ld+json" set:html={JSON.stringify(data)} is:inline />
