---
/**
 * A small category badge (D13).
 *
 * The Drupal theme rendered taxonomy terms as Bootstrap `.badge` pills linking
 * to `/tags/<slug>` archives. Those archives are gone: four terms across five
 * pieces of content did not justify five thin pages, so this is presentational
 * only: it labels a post, it does not navigate.
 */
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<span class="badge">{label}</span>

<style>
  /*
    The old `.badge`: 0.825rem/700 at line-height 1, a 6px radius, and a 10%
    wash of the link blue behind it: sentence case, not uppercase.

    The wash follows `--color-accent` rather than being pinned to the light-mode
    blue as the original was; at 10% opacity on a dark background that pairing
    was close to unreadable.

    The text does not: it needs to be a step brighter than the accent in dark
    mode to clear 4.5:1 against its own wash. See `--color-badge-text`.
  */
  .badge {
    display: inline-block;
    padding: 0.35em 0.65em;
    border: 1px solid color-mix(in srgb, var(--color-accent) 10%, transparent);
    border-radius: var(--radius-md);
    background-color: color-mix(in srgb, var(--color-accent) 10%, transparent);
    color: var(--color-badge-text);
    font-size: 0.825rem;
    font-weight: 700;
    line-height: 1;
  }
</style>
