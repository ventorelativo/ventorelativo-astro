---
/**
 * A small category badge (D13).
 *
 * The Drupal theme rendered taxonomy terms as Bootstrap `.badge` pills linking
 * to `/tags/<slug>` archives. Those archives are gone — four terms across five
 * pieces of content did not justify five thin pages — so this is presentational
 * only: it labels a post, it does not navigate.
 */
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<span class="badge">{label}</span>

<style>
  .badge {
    display: inline-block;
    padding: 0.15em 0.7em;
    border-radius: var(--radius-pill);
    background-color: var(--color-accent-subtle);
    color: var(--color-accent);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }
</style>
