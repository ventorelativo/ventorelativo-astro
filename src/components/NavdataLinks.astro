---
/**
 * The two files a pilot loads into their flight computer.
 *
 * Restored at the URLs Drupal served them from, so a bookmark or an
 * instrument's saved link keeps working. They are static files written at
 * build and byte-identical to what the old site produced: `npm run verify`
 * fails otherwise, because this is the one thing on the site that ends up
 * inside an instrument (AGENTS.md rule 9).
 *
 * No `download` attribute: on a phone, letting the OS hand the file to the
 * app that understands it is the point. On a desktop the browser downloads it
 * anyway.
 */
import H2 from './H2.astro';
const FILES = [
  {
    href: '/api/navdata/ventorelativo-waypoints.cup',
    label: 'Waypoint (.cup)',
    description: 'Decolli e atterraggi per SeeYou, XCTrack, Skytraxx e simili.',
  },
  {
    href: '/api/navdata/ventorelativo-airspace.txt',
    label: 'Zone di atterraggio (.txt)',
    description: 'Le aree di atterraggio in formato OpenAir.',
  },
];
---

<section class="navdata">
  <H2>Dati per il navigatore</H2>
  <p class="navdata__intro">
    Generati da questo sito e aggiornati a ogni modifica: decolli, atterraggi e
    atterraggi alti da caricare nello strumento, per averli sotto gli occhi in volo
    invece che sulla carta.
  </p>
  <ul>
    {
      FILES.map((file) => (
        <li class="card card--link navdata__item">
          <span class="navdata__icon" aria-hidden="true">
            <svg viewBox="0 0 20 20" width="20" height="20">
              <path d="M10 3v10m0 0 3.5-3.5M10 13 6.5 9.5M3.5 15.5h13" />
            </svg>
          </span>
          <span class="navdata__body">
            <a class="card__stretch navdata__label" href={file.href}>
              {file.label}
            </a>
            <span class="navdata__hint">{file.description}</span>
          </span>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .navdata {
    margin-block-start: var(--space-lg);
    padding-block-start: var(--space-md);
    border-block-start: 1px solid var(--color-border);
  }

  /* The heading sat straight on the cards; a section needs a line of air. */
  .navdata__intro {
    margin-block: var(--space-2xs) var(--space-md);
    color: var(--color-text-muted);
  }

  ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-sm);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Surface and hover from the `.card` primitive; this is only the layout. */
  .navdata__item {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-xs) var(--space-sm);
  }

  .navdata__icon {
    display: flex;
    flex: none;
    color: var(--color-accent);
  }

  .navdata__icon svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .navdata__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    min-width: 0;
  }

  .navdata__label {
    color: var(--color-text-strong);
    font-weight: 500;
    text-decoration: none;
  }

  .navdata__hint {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    text-wrap: pretty;
  }
</style>
