---
/**
 * Image gallery with a zoomable lightbox (C10).
 *
 * The Drupal version was a Slick carousel, jQuery, a fixed 16:9 crop, dots.
 * MIGRATION-PLAN.md C10 proposed a CSS scroll-snap strip; the club asked for a
 * lightbox, and chose Bigger Picture after trying it: ~8.4 KB gzipped, click /
 * wheel / pinch to zoom, keyboard navigation, focus management, and it respects
 * prefers-reduced-motion on its own.
 *
 * Weight discipline (see AGENTS.md, "Performance"):
 *  - The grid is plain HTML and needs no JavaScript at all.
 *  - The import lives in the client <script>, so the bundle reaches only pages
 *    that render a gallery: two of the twenty today.
 *  - The library is behind a dynamic import fired on first click, so opening
 *    the page costs 2 kB of listener; the 21 kB library lands only if someone
 *    actually opens an image.
 *  - Without JavaScript every thumbnail is still a link to the full-size file.
 *
 * `getImage()` runs the lightbox source through the same build pipeline as the
 * thumbnails, so `data-img` points at a processed, fingerprinted webp rather
 * than the multi-megabyte original, and its real dimensions go in the markup so
 * the viewer can size itself before the file arrives.
 */
import { Image, getImage } from 'astro:assets';
/*
  The lightbox's stylesheet is imported here, not alongside the dynamic import
  of the library. Astro's `inlineStylesheets: 'auto'` inlines a stylesheet this
  small into the page, but Vite still emits a preload for the file it no longer
  wrote, so `import('bigger-picture/css')` rejected on a 404 and took the whole
  Promise.all, and the lightbox, down with it. As page CSS it is simply inlined,
  costs no request, and cannot fail at runtime.
*/
import 'bigger-picture/css';

interface Props {
  images: { src: ImageMetadata; alt: string }[];
  /** Heading above the grid. Omit for none. */
  title?: string;
}

const { images, title } = Astro.props;

/** Astro never upscales, so cap the request at the source's own width. */
const LIGHTBOX_WIDTH = 1600;

const full = await Promise.all(
  images.map(async (img) => {
    const width = Math.min(LIGHTBOX_WIDTH, img.src.width);
    const generated = await getImage({ src: img.src, width, format: 'webp' });
    return {
      src: generated.src,
      width,
      height: Math.round(width * (img.src.height / img.src.width)),
    };
  }),
);
---

<section class="gallery">
  {title && <h2>{title}</h2>}

  <div class="gallery__grid" data-gallery>
    {
      images.map((img, i) => (
        <figure>
          {/*
            The link is named, the image inside it is not.

            `alt=""` on the thumbnail is deliberate: the caption below carries
            the same words and a screen reader would otherwise announce them
            twice. But an empty alt inside an anchor leaves the anchor with no
            accessible name at all, which is what Lighthouse caught here: three
            links announced as "link, link, link". The label goes on the link
            and says what following it does, which the caption cannot.
          */}
          <a
            href={full[i].src}
            aria-label={`Ingrandisci: ${img.alt}`}
            data-img={full[i].src}
            data-alt={img.alt}
            data-width={full[i].width}
            data-height={full[i].height}
          >
            {/*
              The thumbnail is a 4:3 crop shown at ~20rem, so 640px covers a
              2x screen. quality 70 is indistinguishable at this size and cuts
              the grid's weight by more than half: the full-resolution frame
              is one click away in the lightbox.
            */}
            <Image
              src={img.src}
              alt=""
              widths={[320, 640]}
              sizes="(width < 48rem) 100vw, 20rem"
              quality={70}
              loading="lazy"
            />
          </a>
          <figcaption>{img.alt}</figcaption>
        </figure>
      ))
    }
  </div>
</section>

<style>
  .gallery {
    margin-block-start: var(--space-xl);
  }

  .gallery__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
    gap: var(--space-md);
    margin-block-start: var(--space-md);
  }

  figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
  }

  a {
    display: block;
    overflow: hidden;
    border-radius: var(--radius-lg);
    /* The cursor is the only affordance that these open; make it explicit. */
    cursor: zoom-in;
  }

  a :global(img) {
    display: block;
    width: 100%;
    /* A fixed ratio keeps a row of mixed portrait and landscape shots tidy.
       Nothing is lost, the lightbox shows the whole frame. */
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: scale var(--transition);
  }

  a:hover :global(img) {
    scale: 1.03;
  }

  figcaption {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
</style>

<script>
  /*
    The library is not imported at module scope: it is fetched on the first
    click, so a visitor who never opens an image never downloads it. The click
    listener is the whole of the up-front JavaScript cost.
  */
  type BiggerPictureInstance = {
    open: (options: { items: NodeList | Element[]; el?: Element }) => void;
  };

  let bp: BiggerPictureInstance | undefined;

  async function open(grid: Element, el: Element) {
    if (!bp) {
      const { default: BiggerPicture } = await import('bigger-picture');
      bp = BiggerPicture({ target: document.body }) as BiggerPictureInstance;
    }
    bp.open({ items: grid.querySelectorAll('a'), el });
  }

  function init() {
    for (const grid of document.querySelectorAll('[data-gallery]')) {
      grid.addEventListener('click', (event) => {
        const link = (event.target as HTMLElement).closest('a');
        if (!link || !grid.contains(link)) return;
        // Let modified clicks (new tab, download) do what the visitor asked.
        const e = event as MouseEvent;
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
        event.preventDefault();
        open(grid, link);
      });
    }
  }

  init();
  document.addEventListener('astro:after-swap', init);
</script>
