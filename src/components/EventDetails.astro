---
/**
 * The when and where of a news post that announces an event.
 *
 * Replaces the `<Facts>` blocks the two event posts wrote by hand: same
 * information, but from structured fields, so the date shown here, the date in
 * the `.ics` and the date in the structured data are one value rather than
 * three copies that can drift.
 *
 * ## Why the date is a block and not a line
 *
 * A pilot reading this is deciding whether to be somewhere on a morning. The
 * day and the place are the two facts that decide it, and prose buries them.
 * So the day is a tear-off-calendar block and the rest is a short labelled
 * list.
 *
 * ## Why a pin here and a takeoff glyph below it
 *
 * The place row used to be the takeoff, drawn with the map's takeoff glyph.
 * That was wrong twice: the string goes into the `.ics` as `LOCATION`, which
 * Google Calendar geocodes, and a takeoff has no address for a geocoder to
 * find; and the club gathers at the landing, because that is where the cars
 * are. So the first row is a place a map can find, and it links to a map.
 *
 * The optional second row is the club's own page for the flying site, which
 * keeps the takeoff glyph: it is the same thing the map means by it, and that
 * page says where the takeoffs are far better than a calendar field could.
 *
 * A post with no `event` renders none of this and reads as a plain article,
 * which is the point of keeping events inside `news` rather than beside it.
 */
import type { CollectionEntry } from 'astro:content';

import { getEntry } from 'astro:content';

import ExternalIcon from './ExternalIcon.astro';
import PinIcon from './PinIcon.astro';
import { FEATURE_SYMBOLS } from '../lib/featureIcons';
import { googleCalendarUrl, outlookCalendarUrl } from '../lib/ics';
import { formatDate, isoDate } from '../utils/date';

interface Props {
  event: {
    start: Date;
    end?: Date;
    location: string;
    site?: { collection: 'sites'; id: string };
  };
  entry: CollectionEntry<'news'>;
}

const { event, entry } = Astro.props;
const slug = entry.id;

/*
  Absolute, because it is going into somebody's calendar: a relative link in an
  event's description is a dead link the moment it leaves this page.
*/
const url = new URL(`/news/${slug}/`, Astro.site ?? 'https://www.ventorelativo.it')
  .href;

/* Resolved here rather than passed in: the caller has the reference, and the
   row needs the site's real title, which only the entry has. */
const site = event.site ? await getEntry(event.site) : undefined;

/*
  Google's own search endpoint, which is what a phone opens as a map. Nothing
  is fetched from Google to build it: it is a link, and it stays a link until
  somebody taps it.
*/
const mapUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(event.location)}`;

const calendarEvent = {
  uid: url,
  title: entry.data.title,
  description: entry.data.summary,
  /* Exactly what the volunteer typed, so the geocoder gets a clean string. */
  location: event.location,
  start: event.start,
  end: event.end,
  url,
};

/*
  Only the two web calendars need a pre-filled URL of their own; Apple Calendar,
  Outlook desktop and everything else read the `.ics`.

  The last two rows are the same file and differ only in `download`, which is
  the whole point of listing both. Without it the OS hands the file to whatever
  app understands it, on an iPhone, Calendar opens with the event ready to
  add. With it the browser saves it, which is what somebody who picked "scarica
  il file" asked for.
*/
const ics = `/news/calendario/${slug}.ics`;

const DESTINATIONS = [
  { label: 'Google Calendar', href: googleCalendarUrl(calendarEvent), external: true },
  { label: 'Outlook', href: outlookCalendarUrl(calendarEvent), external: true },
  { label: 'Apple Calendar', href: ics },
  { label: 'Scarica il file (.ics)', href: ics, download: true },
] as const;

/*
  When the event stops being addable.

  The same exclusive end every calendar format here uses: the day *after* the
  last day, so an event is still current all through its final day. Emitted
  into the markup because a static page cannot know today's date: the build
  renders whichever state is right at build time, and three lines of inline
  script correct it for anyone who arrives after an event has passed but
  before the site is next deployed. Without that, a post announcing a May
  event would still be offering "aggiungi al calendario" in September.
*/
const endsAt = new Date(event.end ?? event.start);
endsAt.setUTCDate(endsAt.getUTCDate() + 1);
const expired = Date.now() >= endsAt.getTime();

const it = (options: Intl.DateTimeFormatOptions) =>
  new Intl.DateTimeFormat('it-IT', options);

const day = it({ day: 'numeric' }).format(event.start);
const month = it({ month: 'short' }).format(event.start).replace('.', '');
const year = it({ year: 'numeric' }).format(event.start);
const weekday = it({ weekday: 'long' }).format(event.start);

/* "sabato 16 maggio 2026", or a range when the event spans days. */
const when = event.end
  ? `${formatDate(event.start)} – ${formatDate(event.end)}`
  : `${weekday} ${formatDate(event.start)}`;

const CALENDAR = `<rect x="3" y="4.5" width="14" height="13" rx="2" />
  <path d="M3 8.5h14M7 2.5v4M13 2.5v4" />`;

/*
  U+2060 WORD JOINER, spelled out because an escape in an Astro expression
  reaches the page as the six characters `\u2060`, checked in the built HTML.
*/
const JOINER = String.fromCharCode(0x2060);
---

<section class="event">
  <div class="event__when">
    {/* A date block, not a date string: it is the first thing to find. */}
    <time class="event__date" datetime={isoDate(event.start)}>
      <span class="event__day">{day}</span>
      <span class="event__month">{month}</span>
      <span class="event__year">{year}</span>
    </time>

    <dl class="event__facts">
      <div class="event__row">
        <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
          <g class="stroke" set:html={CALENDAR} />
        </svg>
        <dt class="visually-hidden">Quando</dt>
        <dd>{when}</dd>
      </div>

      <div class="event__row">
        <PinIcon size={18} class="pin--muted" />
        <dt class="visually-hidden">Ritrovo</dt>
        <dd>
          <a href={mapUrl} target="_blank" rel="noopener noreferrer">
            {
              /*
              A word joiner, not `white-space: nowrap`: a line break is allowed
              after a closing bracket, so "Bagnolo Piemonte (CN)" dropped the
              glyph onto a line of its own. `nowrap` on the whole anchor would
              have fixed it and let a long place name overflow the panel
              instead. This glues one seam and leaves the rest wrapping.
            */
            }
            {event.location + JOINER}<ExternalIcon size={13} />
          </a>
        </dd>
      </div>
    </dl>
  </div>

  {
    /*
    A menu, not a row of four buttons: only one of them is ever the right one
    for a given reader, and four side by side would be the loudest thing in the
    panel. `<details>` supplies the open state, the button role and the
    keyboard handling; the script below adds only the light-dismiss it lacks,
    and reaches only the pages that announce an event.

    Every destination is an anchor built at build time. Nothing is fetched from
    Google or Microsoft until somebody picks one.
  */
  }
  <div class="event__add" data-calendar-wrap data-ends={endsAt.toISOString()}>
    <details class="event__menu-root" hidden={expired} data-calendar>
      <summary class="button" data-calendar-summary>
        <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true">
          <g class="stroke" set:html={CALENDAR} />
        </svg>
        Aggiungi al calendario
        <svg
          viewBox="0 0 20 20"
          width="14"
          height="14"
          aria-hidden="true"
          class="chevron"
        >
          <path class="stroke" d="m5 8 5 5 5-5"></path>
        </svg>
      </summary>

      <ul class="event__menu">
        {
          DESTINATIONS.map((to) => (
            <li>
              <a
                href={to.href}
                download={'download' in to ? true : undefined}
                target={'external' in to ? '_blank' : undefined}
                rel={'external' in to ? 'noopener noreferrer' : undefined}
              >
                <span>{to.label}</span>
                {'external' in to && <ExternalIcon size={13} />}
              </a>
            </li>
          ))
        }
      </ul>
    </details>

    {
      /* Not a `<button disabled>`: there is no action here to disable, and a
      disabled control is skipped by a screen reader that would otherwise read
      the one thing this says. */
    }
    <p class="event__expired" hidden={!expired} data-calendar-expired>
      <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true">
        <g class="stroke" set:html={CALENDAR} />
      </svg>
      Evento concluso
    </p>
  </div>
</section>

{
  site && (
    <a class="event__place" href={`/siti/${site.id}/`}>
      <svg
        class="event__site"
        viewBox="6.5 6 149.5 88"
        width="28.3"
        height="16.7"
        aria-hidden="true"
      >
        <g transform="translate(62 0)">
          <g class="glyph glyph--landing" set:html={FEATURE_SYMBOLS.landing} />
        </g>
        <g>
          <g class="glyph glyph--takeoff" set:html={FEATURE_SYMBOLS.takeoff} />
        </g>
      </svg>
      <span class="event__place-text">
        <span class="event__place-label">Sito di volo</span>
        <span class="event__place-name">{site.data.title}</span>
      </span>
    </a>
  )
}

<style>
  .event {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm) var(--space-md);
    margin-block: var(--space-md);
    padding: var(--space-sm) var(--space-md);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background-color: var(--color-bg-subtle);
  }

  .event__when {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    /* Lets the facts column shrink instead of pushing the panel wider than
       the phone: a long takeoff name would otherwise overflow. */
    min-width: 0;
  }

  .event__date {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 4.25rem;
    padding: var(--space-2xs) var(--space-xs);
    border-radius: var(--radius-md);
    background-color: var(--brand-blue);
    color: var(--color-on-brand);
    line-height: 1.05;
  }

  .event__day {
    font-size: var(--text-2xl);
    font-weight: 500;
  }

  .event__month {
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }

  .event__year {
    font-size: var(--text-xs);
    opacity: 0.75;
  }

  .event__facts {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    margin: 0;
  }

  /*
    Label above value, not beside it. Side by side, "Decollo" and "Montoso
    (Bagnolo Piemonte)" split a phone's width in half and the place name wrapped
    into a three-line column: the one fact the panel exists to show.
  */
  .event__row {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    column-gap: var(--space-2xs);
  }

  .event__row svg {
    grid-row: span 2;
  }

  .event__row:has(dt.visually-hidden) svg {
    grid-row: auto;
  }

  /* `flex: none` so a long place name does not squash its icon. */
  .event__row svg {
    flex: none;
  }

  dt {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    line-height: 1.3;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  dd {
    margin: 0;
    color: var(--color-text-strong);
    font-weight: 500;
    line-height: 1.3;
    text-wrap: pretty;
  }

  /* The pin is `currentColor`; here that means the same muted grey as the
     calendar it sits under. */
  .event__row :global(.pin--muted) {
    color: var(--color-text-muted);
  }

  .stroke {
    fill: none;
    stroke: var(--color-text-muted);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /*
    The reset in global.css makes every `svg` a block, which is right nearly
    everywhere and wrong inside a sentence: it put the outward glyph on a line
    of its own under the place name. Inline-block puts it back in the text, and
    the word joiner beside it then keeps the two together.
  */
  .event__row a :global(.external) {
    display: inline-block;
    vertical-align: -0.08em;
  }

  /*
    The site sits outside the event panel, between it and the article.

    Two reasons it is not a row of facts inside the panel. The two-glyph mark
    is half again as wide as a calendar or a pin, so in that list either its
    text started to the right of the others or the column grew and squeezed
    the date onto two lines. And it is a different kind of thing: the date and
    the place are this event, while the site is a page elsewhere, so it reads
    as a pointer away rather than another detail of the day.
  */
  .event__place {
    display: inline-flex;
    /* Only as wide as it needs: full width left a mostly empty box at 1440. */
    max-width: max-content;
    align-items: center;
    gap: var(--space-xs);
    /* No top margin: this is inline-level, so its margin would not collapse
       with the panel's and the two would sit a double gap apart. It only ever
       follows the panel, which already leaves space below itself. */
    margin-block: 0 var(--space-md);
    padding: var(--space-2xs) var(--space-xs);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background-color: var(--color-bg-subtle);
    color: inherit;
    text-decoration: none;
  }

  .event__place:hover {
    border-color: var(--color-border-strong);
  }

  .event__place-text {
    display: flex;
    flex-direction: column;
  }

  .event__place-label {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    line-height: 1.3;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .event__place-name {
    color: var(--color-accent);
    font-weight: 500;
    text-decoration: underline;
  }

  /*
    The takeoff is drawn last, so it carries back the keyline the artwork lost:
    `withoutKeyline` strips it because it eats the drawing at small sizes on a
    flat page, and here the two shapes would otherwise merge into one blot.
    `paint-order` puts the stroke behind the fill, so it reads as a gap rather
    than an outline.
  */
  .event__site > g:last-child .glyph {
    stroke: var(--color-bg-subtle);
    stroke-width: 4.5;
    paint-order: stroke fill;
  }

  /* The map's own colours, so a takeoff means the same thing everywhere. */
  .glyph--takeoff {
    fill: var(--color-map-takeoff);
  }

  .glyph--landing {
    fill: var(--color-map-landing);
  }

  .event__add {
    position: relative;
  }

  /*
    Looks like the button it replaces, minus every affordance: no border
    colour, no pointer, no hover. A reader should see at a glance that the row
    is spent rather than that something is broken.
  */
  .event__expired {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    margin: 0;
    padding: 0.375rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  /* `display` above would otherwise beat the UA's `[hidden]` rule. */
  .event__expired[hidden],
  .event__menu-root[hidden] {
    display: none;
  }

  summary {
    /* `.button` supplies the look; these two remove the disclosure marker. */
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .chevron {
    transition: transform var(--transition);
  }

  [open] .chevron {
    transform: rotate(180deg);
  }

  /*
    Opens downward: this panel sits at the top of an article, where an upward
    menu would go behind the header.
  */
  .event__menu {
    position: absolute;
    z-index: 50;
    inset-block-start: calc(100% + var(--space-3xs));
    inset-inline-start: 0;
    min-width: 100%;
    width: max-content;
    max-width: min(20rem, calc(100vw - 2 * var(--space-md)));
    padding: var(--space-3xs);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background-color: var(--color-bg-raised);
    box-shadow: var(--shadow-md);
    list-style: none;
    margin: 0;
  }

  .event__menu a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    padding: var(--space-3xs) var(--space-2xs);
    border-radius: var(--radius-sm);
    color: var(--color-text);
    font-size: var(--text-sm);
    text-decoration: none;
    transition: background-color var(--transition);
  }

  .event__menu a:hover {
    background-color: var(--color-bg-subtle);
    color: var(--color-accent);
  }

  summary .stroke {
    stroke: currentColor;
  }
</style>

<script>
  /*
    <details> has no light-dismiss of its own. Written out here rather than
    imported from a shared helper, which the theme toggle and the language
    switcher also want: Astro inlines a component's script only while it has no
    imports, and adding one cost 2.0 kB and three requests on *every* page:
    see docs/performance.md. Ten lines, three times, is the cheaper trade.

    The listeners are never removed. Navigation is cross-document
    (`@view-transition { navigation: auto }`), so each page starts fresh.
  */
  /*
    Correct the build's guess about today. Cheap enough to be unconditional:
    two element lookups and a date comparison, in a script this page already
    inlines for the menu below.
  */
  const wrap = document.querySelector<HTMLElement>('[data-calendar-wrap]');
  const expiry = wrap && Date.parse(wrap.dataset.ends ?? '');

  if (wrap && expiry) {
    const past = Date.now() >= expiry;
    wrap.querySelector<HTMLElement>('[data-calendar]')!.hidden = past;
    wrap.querySelector<HTMLElement>('[data-calendar-expired]')!.hidden = !past;
  }

  const root = document.querySelector<HTMLDetailsElement>('[data-calendar]');

  if (root) {
    const summary = root.querySelector<HTMLElement>('[data-calendar-summary]');

    document.addEventListener('click', (event) => {
      if (root.open && !root.contains(event.target as Node)) root.open = false;
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && root.open) {
        root.open = false;
        summary?.focus();
      }
    });
  }
</script>
