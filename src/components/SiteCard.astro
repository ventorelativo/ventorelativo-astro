---
/**
 * A flight-site teaser (the Drupal `sito` "card-big" view mode).
 *
 * Text only, as the old cards were: no thumbnail. Two of the fourteen sites
 * have a photograph, so a picture on the card would mark those two out as
 * "better" for no reason other than which ones someone happened to shoot.
 *
 * Metrics measured from the old build: 6px radius, 16px padding, a 1.5rem/500
 * title in the body colour rather than the heading blue, 8px between the two
 * lines.
 *
 * Only the title is an anchor, stretched over the card by a pseudo-element, so
 * the whole card is clickable without the summary being read out as link text.
 */
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'sites'>;
}

const { entry } = Astro.props;
const { title, summary } = entry.data;
const href = `/siti/${entry.id}/`;
---

<article class="card">
  <h2 class="card__title">
    <a href={href}>{title}</a>
  </h2>
  <p class="card__summary">{summary}</p>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    padding: var(--space-sm);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background-color: var(--color-bg-raised);
    transition: border-color var(--transition);
  }

  .card:hover {
    border-color: var(--color-border-strong);
  }

  /* Overrides the global heading rule: card titles were the body colour on the
     old site, not the heading blue, and a grid of blue titles reads as a list
     of links rather than a set of cards. */
  .card__title {
    color: var(--color-text);
    font-size: 1.5rem;
    font-weight: 500;
  }

  .card__title a {
    color: inherit;
    text-decoration: none;
  }

  .card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .card:hover .card__title a {
    color: var(--color-accent);
  }

  /*
    The summary is the "1969m, S-SE, Roure (TO)" triplet — specification, not
    prose, so it is set as data: tabular figures, muted.
  */
  .card__summary {
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
  }
</style>
