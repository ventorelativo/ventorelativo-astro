---
/**
 * A flight-site teaser (the Drupal `sito` "card-big" view mode).
 *
 * Text only, as the old cards were: no thumbnail. Two of the fourteen sites
 * have a photograph, so a picture on the card would mark those two out as
 * "better" for no reason other than which ones someone happened to shoot.
 *
 * Metrics measured from the old build: 6px radius, 16px padding, a 1.5rem/500
 * title, 8px between the lines. The title takes the heading blue rather than
 * the old card's body grey, so it matches every other heading on the site.
 *
 * Only the title is an anchor, stretched over the card by `.card__stretch`, so
 * the whole card is clickable without the summary being read out as link text.
 * The comment said that before the rule existed — the stretch was never
 * written, and fourteen cards had a clickable heading and a dead body.
 */
import type { CollectionEntry } from 'astro:content';
import Badge from './Badge.astro';

interface Props {
  entry: CollectionEntry<'sites'>;
}

const { entry } = Astro.props;
const { title, summary, tags } = entry.data;
const href = `/siti/${entry.id}/`;
---

<article class="card card--link">
  <h2 class="card__title">
    <a class="card__stretch" href={href}>{title}</a>
  </h2>
  <p class="card__summary">{summary}</p>

  {
    tags.length > 0 && (
      <p class="card__tags">
        {tags.map((tag) => (
          <Badge label={tag} />
        ))}
      </p>
    )
  }
</article>

<style>
  /* Surface, shadow and hover come from the `.card` primitive in global.css. */
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    padding: var(--space-sm);
    /* Clips the contour texture to the rounded corners. */
    overflow: hidden;
    /*
      Makes the card a stacking context, which is what lets the texture below
      sit at `z-index: -1` — above the card's own background, beneath every
      child — without escaping to an ancestor.

      The alternative, positioning each child to lift it over the texture, is
      what was here before, and it silently broke the stretched link: a
      positioned `<h2>` becomes the containing block for the anchor's
      `::after`, so `inset: 0` covered the heading instead of the card.
    */
    isolation: isolate;
  }

  /*
    The same contour pattern as the footer, and for the same reason it belongs
    here: these fourteen cards are places on a mountainside. Masked rather than
    painted so it follows the colour scheme — see Footer.astro.

    Each card takes a different corner of the tile. With one position they all
    showed the same three contour lines and the grid read as a printing error
    rather than terrain.
  */
  .card::before {
    content: '';
    position: absolute;
    inset: 0;
    background-color: var(--color-topo);
    /*
      Two masks, intersected: the contour drawing, and a diagonal fade so the
      pattern arrives gradually out of the bottom-right corner instead of
      filling the card evenly.

      The old theme did it the other way round — it painted a
      `linear-gradient(315deg, transparent 0%, var(--bs-card-bg) 70%)` *over*
      the pattern, which needs the card's own background colour repeated in the
      gradient. Masking needs no colour at all, so it keeps working when the
      card's ground changes.
    */
    mask-image: url('/topo.svg'), linear-gradient(315deg, #000 0%, transparent 70%);
    z-index: -1;
    mask-composite: intersect;
    mask-repeat: repeat, no-repeat;
    mask-size: 600px, cover;
    pointer-events: none;
  }

  .card:nth-child(4n + 1)::before {
    mask-position: 0 0;
  }
  .card:nth-child(4n + 2)::before {
    mask-position: 100% 30%;
  }
  .card:nth-child(4n + 3)::before {
    mask-position: 40% 100%;
  }
  .card:nth-child(4n)::before {
    mask-position: 70% 60%;
  }

  .card:hover {
    border-color: var(--color-border-strong);
  }

  /* The size and weight are the old card's; the colour is the heading blue,
     so card titles read as headings like every other heading on the site. */
  .card__title {
    font-size: 1.5rem;
    font-weight: 500;
  }

  .card__title a {
    color: inherit;
    text-decoration: none;
  }

  .card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .card:hover .card__title a {
    color: var(--color-accent-hover);
  }

  /*
    The summary is the "1969m, S-SE, Roure (TO)" triplet — specification, not
    prose, so it is set as data: tabular figures, muted.
  */
  .card__summary {
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
  }

  /*
    Pushed to the foot of the card. With equal-height cards the pills would
    otherwise float wherever the summary happened to end — one line on Podio,
    two on Montoso — and read as misaligned.
  */
  .card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs);
    margin-block-start: auto;
    padding-block-start: var(--space-2xs);
  }
</style>
