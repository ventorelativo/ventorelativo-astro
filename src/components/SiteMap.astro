---
/**
 * A site's map — as a facade (MIGRATION-PLAN.md Phase 4b).
 *
 * The page ships the poster and a button. MapLibre is 240 kB brotli'd and does
 * not exist until someone asks for it, so a visitor who never opens a map pays
 * nothing, and Lighthouse — which measures page load — never sees it. That is
 * how a 240 kB dependency and a 100/100 target live on the same page.
 *
 * The interaction is shaped around INP, the one Core Web Vital genuinely at
 * risk here. LCP and TBT are settled long before anyone clicks; INP is not, and
 * a handler that blocks while a quarter-megabyte parses is a bad interaction by
 * definition. So the click does two cheap things — flip a class and start an
 * async import — and the next paint happens without waiting for the library.
 * Hover and focus start the fetch even earlier, so by the time the click lands
 * the download is usually already running.
 */
import MapPoster from './MapPoster.astro';
import { FEATURE_TYPES, type FeatureType } from '../lib/featureTypes';
import { MAPTILER_KEY } from '../lib/mapConfig';
/*
  The club's own marker icons: a blue wing for a takeoff, a green target for a
  landing, both with a white keyline so they hold up over any basemap.

  `?url&no-inline`, and the `no-inline` is not decoration. Both files are under
  Vite's 4 kB inline threshold, so by default they become data: URIs compiled
  into the page — 4,166 bytes of base64 in every site page's HTML, a tenth of
  its weight, carried by everyone including the visitors on a metered
  connection who never open a map at all. As files they are fetched only when
  one is opened, and Astro fingerprints them so they cache forever.

  MapLibre cannot take SVG directly — `addImage` wants pixels — so these are
  rasterised in the browser at the device's own resolution. That is the whole
  advantage over shipping PNGs: one drawing, sharp on a phone and on a 5K
  display, instead of a bitmap that was only ever right at one size.
*/
import takeoffIcon from '../assets/map/takeoff.svg?url&no-inline';
import landingIcon from '../assets/map/landing.svg?url&no-inline';
/*
  The club's own control icons, replacing MapLibre's stock ones. Terrain and
  fullscreen belong to controls the library builds, so they are swapped as CSS
  background images; `reset` is inlined into the button this component makes,
  where its `currentColor` fill can inherit.

  `no-inline` again: as data: URIs these would be compiled into the page's
  stylesheet, which is render-blocking and reaches every visitor. As files, the
  browser fetches them only when the buttons that reference them exist.
*/
import terrainIcon from '../assets/map/terrain.svg?url&no-inline';
import terrainOffIcon from '../assets/map/terrain-off.svg?url&no-inline';
import fullscreenIcon from '../assets/map/fullscreen.svg?url&no-inline';
import fullscreenCloseIcon from '../assets/map/fullscreen-close.svg?url&no-inline';
import resetIcon from '../assets/map/reset.svg?raw';
import type { LatLon } from '../lib/geo';

interface Feature {
  name: string;
  type: FeatureType;
  point?: LatLon;
  shape?: { discriminant: 'polygon' | 'line'; value: [number, number][] };
  /**
   * The site this belongs to, on the overview map only. A site's own map has
   * no use for it — the link would point at the page it is already on.
   */
  site?: { title: string; href: string };
}

interface Props {
  features: Feature[];
  title: string;
}

const { features, title } = Astro.props;

/*
  The geometry, as GeoJSON, in a script tag rather than a data attribute: it is
  JSON already, and a data attribute would mean escaping it into an HTML
  attribute and parsing it back out.

  Colours are resolved in the browser from the same `--color-map-*` tokens the
  poster uses, so the two cannot drift and the map follows the theme.
*/
const geojson = {
  type: 'FeatureCollection',
  features: [
    ...features
      .filter((feature) => feature.point)
      .map((feature) => ({
        type: 'Feature',
        properties: {
          name: feature.name,
          kind: feature.type,
          // Empty strings rather than undefined: JSON drops undefined, and an
          // absent key reads as broken data where '' reads as "not set".
          siteTitle: feature.site?.title ?? '',
          siteHref: feature.site?.href ?? '',
        },
        geometry: {
          type: 'Point',
          coordinates: [feature.point!.lon, feature.point!.lat],
        },
      })),
    ...features
      .filter((feature) => feature.shape)
      .map((feature) => ({
        type: 'Feature',
        properties: {
          name: feature.name,
          kind: feature.type,
          // Empty strings rather than undefined: JSON drops undefined, and an
          // absent key reads as broken data where '' reads as "not set".
          siteTitle: feature.site?.title ?? '',
          siteHref: feature.site?.href ?? '',
        },
        geometry:
          feature.shape!.discriminant === 'polygon'
            ? { type: 'Polygon', coordinates: [feature.shape!.value] }
            : { type: 'LineString', coordinates: feature.shape!.value },
      })),
  ],
};

// Without a key there is nothing to load, so the button would lie. The poster
// stands on its own — it is a drawing, not a placeholder for one.
const interactive = features.length > 0 && MAPTILER_KEY !== '';

const typeColours = Object.fromEntries(
  Object.keys(FEATURE_TYPES).map((type) => [type, `--color-map-${type}`]),
);

// Only the two kinds that have an icon. A point of interest stays a dot in the
// logo's yellow, and the obstacle is a line.
const icons = { takeoff: takeoffIcon, landing: landingIcon };

/*
  What the popup calls each kind. From FEATURE_TYPES, so the map, the table and
  the poster cannot drift apart on the wording — and the glyphs are the ones the
  old site's popups used, so a pilot who knew that map recognises this one.
*/
const typeNames = Object.fromEntries(
  Object.entries(FEATURE_TYPES).map(([type, info]) => [type, [info.emoji, info.label]]),
);
---

<div
  class="map"
  data-map={interactive ? '' : null}
  data-reset-icon={interactive ? resetIcon : null}
  style={[
    `--icon-terrain: url(${terrainIcon})`,
    `--icon-terrain-off: url(${terrainOffIcon})`,
    `--icon-fullscreen: url(${fullscreenIcon})`,
    `--icon-fullscreen-close: url(${fullscreenCloseIcon})`,
  ].join('; ')}
>
  <MapPoster features={features} title={title} />

  {
    interactive && (
      <>
        <button class="map__open" type="button" data-map-open>
          <span data-map-label>Apri la mappa</span>
        </button>
        <div class="map__canvas" data-map-canvas hidden />
        {/* Data, not modules — is:inline keeps Astro from trying to bundle them. */}
        <script
          is:inline
          type="application/json"
          data-map-data
          set:html={JSON.stringify(geojson)}
        />
        <script
          is:inline
          type="application/json"
          data-map-colours
          set:html={JSON.stringify(typeColours)}
        />
        <script
          is:inline
          type="application/json"
          data-map-icons
          set:html={JSON.stringify(icons)}
        />
        <script
          is:inline
          type="application/json"
          data-map-names
          set:html={JSON.stringify(typeNames)}
        />
      </>
    )
  }
</div>

<style>
  .map {
    position: relative;
    /*
      On the block, not on the poster. The poster is hidden the moment the map
      opens, and with it went the only thing separating the frame from whatever
      followed — the site grid on /siti ran straight into the map's bottom edge.
    */
    margin-block-end: var(--space-md);
  }

  /*
    One height for the poster and the map, so swapping one for the other shifts
    nothing — the whole reason CLS stays at zero.

    600 px at every width, as the old site had it: the frame keeps its height
    and lets its aspect follow the container, which reads far better than a
    frame that grows and shrinks with the window.

    On a phone that is a tall portrait frame, and the poster's 16:9 drawing sits
    in the middle of it with bands above and below — which is why the poster
    paints its own background across the whole frame, so the bands are not
    visible as bands.
  */
  .map,
  :global(.poster) {
    --map-height: 600px;
  }

  /*
    The button sits over the poster rather than beside it, so the whole drawing
    reads as the control. It is a real <button>, so it is focusable, announced,
    and works from the keyboard without anything being added for it.
  */
  .map__open {
    position: absolute;
    inset-block-end: var(--space-md);
    inset-inline-end: var(--space-xs);
    padding: 0.5rem 1rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background-color: var(--color-bg-raised);
    color: var(--color-text-strong);
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 500;
    cursor: pointer;
  }

  .map__open:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .map__open:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .map__open[disabled] {
    cursor: progress;
    opacity: 0.7;
  }

  /*
    The canvas replaces the poster in the same box, so nothing on the page moves
    when the map arrives — the layout shift a facade would otherwise cause is
    the reason to size it here rather than let MapLibre size itself.
  */
  .map__canvas {
    height: var(--map-height);
    /* Ignored while the height is fixed; takes over when it goes `auto`. */
    aspect-ratio: 16 / 9;
    width: 100%;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .map--open :global(.poster) {
    display: none;
  }

  .map--open .map__open {
    display: none;
  }

  /*
    MapLibre builds these buttons itself, so its classes are the only handle on
    them and the rules have to be :global — nothing here carries this
    component's scope attribute.

    Each control has two states and each state its own drawing. MapLibre names
    them by what pressing the button will *do*, not by what is currently true:
    `maplibregl-ctrl-terrain` is the button offering to turn terrain on, so it
    carries the flat icon, and `-enabled` carries the peaks. Likewise `shrink`
    is the one offering to leave fullscreen.
  */
  .map :global(.maplibregl-ctrl-terrain .maplibregl-ctrl-icon) {
    background-image: var(--icon-terrain-off);
  }

  .map :global(.maplibregl-ctrl-terrain-enabled .maplibregl-ctrl-icon) {
    background-image: var(--icon-terrain);
  }

  .map :global(.maplibregl-ctrl-fullscreen .maplibregl-ctrl-icon) {
    background-image: var(--icon-fullscreen);
  }

  .map :global(.maplibregl-ctrl-shrink .maplibregl-ctrl-icon) {
    background-image: var(--icon-fullscreen-close);
  }

  /*
    The inlined reset icon, sized and coloured like MapLibre's own.

    Smaller than it looks it should be: MapLibre's stock icons carry their own
    padding inside a 33-unit box, while this one is a Font Awesome glyph that
    fills its 512 box edge to edge. Matching them by percentage made it the
    largest thing in the stack.
  */
  /*
    The popup. MapLibre supplies the frame and the tail; these are its contents,
    which have to be :global because the map builds them.
  */
  .map :global(.map-popup) {
    font-size: var(--text-sm);
    line-height: 1.45;
  }

  .map :global(.map-popup p) {
    margin: 0;
  }

  .map :global(.map-popup__name) {
    color: var(--color-text-strong);
  }

  .map :global(.map-popup__icon) {
    display: inline-block;
    width: 1.3em;
    height: 1.3em;
    vertical-align: -0.32em;
  }

  .map :global(.map-popup__dot) {
    display: inline-block;
    width: 0.62em;
    height: 0.62em;
    border-radius: 50%;
  }

  .map :global(.map-popup__dot--poi) {
    background-color: var(--color-map-poi);
  }

  .map :global(.map-popup__kind),
  .map :global(.map-popup__coords) {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  .map :global(.map-popup__coords) {
    font-variant-numeric: tabular-nums;
    /* A pilot copies these, so let them be selected without the popup moving. */
    user-select: text;
  }

  .map :global(.map-popup__links) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin-block-start: var(--space-3xs);
  }

  /*
    The layers panel. It hangs off its own button in the control stack, so it is
    positioned against that button rather than against the map.
  */
  .map :global(.map-layers) {
    position: relative;
  }

  .map :global(.map-layers__panel) {
    position: absolute;
    inset-inline-end: 0;
    inset-block-start: calc(100% + 4px);
    min-width: 12rem;
    padding: var(--space-2xs);
    border-radius: var(--radius-md);
    background-color: var(--color-bg-raised);
    box-shadow: 0 2px 8px rgb(0 0 0 / 0.2);
    font-size: var(--text-sm);
    text-align: start;
  }

  .map :global(.map-layers__panel fieldset) {
    margin: 0;
    padding: 0;
    border: 0;
  }

  .map :global(.map-layers__panel fieldset + fieldset) {
    margin-block-start: var(--space-2xs);
    padding-block-start: var(--space-2xs);
    border-block-start: 1px solid var(--color-border);
  }

  .map :global(.map-layers__panel legend) {
    padding: 0;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .map :global(.map-layers__filters) {
    display: grid;
    gap: var(--space-3xs);
    margin-block-start: var(--space-3xs);
  }

  .map :global(.map-layers__filter) {
    display: grid;
    grid-template-columns: 3.2rem 1fr;
    align-items: center;
    gap: var(--space-3xs);
  }

  .map :global(.map-layers__filter span) {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  .map :global(.map-layers__filter select) {
    padding: 0.1rem 0.2rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    background-color: var(--color-bg);
    color: var(--color-text);
    font: inherit;
    font-size: var(--text-xs);
  }

  .map :global(.map-layers__panel label) {
    display: flex;
    align-items: center;
    gap: var(--space-3xs);
    padding-block: 0.15rem;
    color: var(--color-text);
    cursor: pointer;
  }

  /*
    The two controls this component builds, coloured to match the ones MapLibre
    builds beside them.

    `color`, not `fill`: both icons paint with `currentColor` — the reset glyph
    carries `fill="currentColor"` as an attribute, which a `fill` declaration on
    the parent svg cannot override, and the layers icon strokes with it. Left to
    inherit, they took the page's text colour and turned pale grey on a white
    button the moment the site went dark, while MapLibre's own icons, which
    hardcode theirs, stayed dark.

    Hardcoded for the same reason MapLibre hardcodes it: this chrome is white in
    both schemes, so the icon on it has to be dark in both.
  */
  .map :global(.maplibregl-ctrl-group button) {
    color: rgb(68, 73, 82);
  }

  .map :global(.map-reset-icon) {
    width: 46%;
    height: 46%;
    margin: 27%;
  }

  /* Sized and centred like MapLibre's own icons, which fill 20 of 29 pixels. */
  .map :global(.map-layers__icon) {
    display: block;
    width: 62%;
    height: 62%;
    margin: 19%;
  }
</style>

<script>
  /*
    Loaded on every page that renders a map, and it is deliberately tiny: its
    whole job is to notice an intent and then get out of the way. MapLibre
    itself is behind the dynamic import at the bottom, so nothing here pulls it
    into the page bundle.
  */
  import { TILE_ORIGIN } from '../lib/tileOrigin';

  function setup(root: HTMLElement) {
    const button = root.querySelector<HTMLButtonElement>('[data-map-open]');
    const canvas = root.querySelector<HTMLElement>('[data-map-canvas]');
    const label = root.querySelector<HTMLElement>('[data-map-label]');
    if (!button || !canvas || !label) return;

    /*
      Warm the connection on the first sign of interest. DNS, TCP and TLS to the
      tile host are hundreds of milliseconds that would otherwise happen after
      the click, in series with everything else.
    */
    let warmed = false;
    const warm = () => {
      if (warmed) return;
      warmed = true;
      const link = document.createElement('link');
      link.rel = 'preconnect';
      link.href = TILE_ORIGIN;
      link.crossOrigin = '';
      document.head.append(link);
    };
    button.addEventListener('pointerenter', warm, { once: true });
    button.addEventListener('focus', warm, { once: true });

    let started = false;
    scheduleAutoLoad(root, button);
    button.addEventListener('click', () => {
      if (started) return;
      started = true;

      /*
        Everything before the await is what INP measures. Paint a busy state and
        stop — the import is a promise, and the browser gets its frame.
      */
      button.disabled = true;
      label.textContent = 'Caricamento…';
      warm();

      void open(root, canvas, button, label);
    });
  }

  /**
   * Open the map without being asked — but late, and only when it is worth it.
   *
   * Four gates, and every one of them exists to keep a 240 kB download off
   * somebody's critical path:
   *
   *  - **After `load`.** Nothing competes with the page's own resources.
   *  - **Only when visible.** A map further down the page is not downloaded
   *    until it is scrolled to, so a visitor who reads the text and leaves
   *    never fetches it.
   *  - **When the browser is idle**, so it never delays an interaction.
   *  - **Not on a metered or slow connection.** Save-Data and
   *    `prefers-reduced-data` are explicit requests not to do this, and 2G is
   *    a mountain valley — the audience this site is actually built for. Those
   *    visitors keep the poster and the button, which is the honest trade: they
   *    can still have the map, but they choose to spend the bytes.
   */
  function scheduleAutoLoad(root: HTMLElement, button: HTMLButtonElement) {
    const connection = (
      navigator as Navigator & {
        connection?: { saveData?: boolean; effectiveType?: string };
      }
    ).connection;
    if (connection?.saveData) return;
    if (/(^|-)2g$/.test(connection?.effectiveType ?? '')) return;
    if (matchMedia('(prefers-reduced-data: reduce)').matches) return;
    if (!('IntersectionObserver' in window)) return;

    const whenIdle = (run: () => void) => {
      const idle = () =>
        'requestIdleCallback' in window
          ? requestIdleCallback(run, { timeout: 4000 })
          : setTimeout(run, 1500);
      if (document.readyState === 'complete') idle();
      else window.addEventListener('load', idle, { once: true });
    };

    const observer = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        observer.disconnect();
        // Through the button, so the automatic path and the manual one are the
        // same code — including the busy state and every failure route.
        whenIdle(() => button.click());
      },
      { rootMargin: '200px' },
    );
    observer.observe(root);
  }

  /**
   * MapLibre is a WebGL renderer, so without WebGL 2 there is no map to be had.
   *
   * Worth checking rather than letting the constructor throw: the failure
   * arrives after the poster has been swapped out, and a blank rectangle is a
   * worse answer than the drawing that was already there.
   */
  function canRenderMap(): boolean {
    try {
      return !!document.createElement('canvas').getContext('webgl2');
    } catch {
      return false;
    }
  }

  async function open(
    root: HTMLElement,
    canvas: HTMLElement,
    button: HTMLButtonElement,
    label: HTMLElement,
  ) {
    const back = (message: string) => fail(root, canvas, button, label, message);

    if (!canRenderMap()) {
      back('Mappa non supportata da questo browser');
      return;
    }

    try {
      // The stylesheet is a plain file in public/ — see scripts/sync-vendor-css.mjs
      // for why it is not imported here.
      await loadStylesheet('/vendor/maplibre-gl.css');

      const [
        { Map, NavigationControl, FullscreenControl, Popup, prewarm, setWorkerUrl },
        config,
        links,
      ] = await Promise.all([
        import('maplibre-gl'),
        import('../lib/mapConfig'),
        import('../lib/coordinateLinks'),
      ]);

      /*
        Tell MapLibre where its worker is, before any map exists.

        Left to itself it looks for `maplibre-gl-worker.mjs` beside its own
        module URL, which after bundling is a hashed filename in /_astro/ with
        no worker next to it. The 404 is silent and the symptom is bizarre:
        only *vector* tiles are parsed in the worker, so the raster hillshade
        draws and every road, label and marker vanishes. Copied to this fixed
        path by scripts/sync-vendor.mjs.
      */
      setWorkerUrl('/vendor/maplibre-gl-worker.mjs');

      /*
        Start the worker before the map asks for it. The gain here is modest —
        the map is constructed a few lines below, so there is little for it to
        overlap with — but it costs nothing and takes the worker's own startup
        off the critical path of the first tile.
      */
      prewarm();

      const data = readJson(root, '[data-map-data]');
      const colours = readJson(root, '[data-map-colours]') as Record<string, string>;
      const icons = readJson(root, '[data-map-icons]') as Record<string, string>;
      const colourFor = (kind: string) => resolveColour(colours[kind] ?? '');

      canvas.hidden = false;
      root.classList.add('map--open');

      const map = new Map({
        container: canvas,
        style: config.styleUrl(),
        // Keeps a stray drag inside the club's valleys — see MAX_BOUNDS.
        maxBounds: config.MAX_BOUNDS,
        // Scrolling the page must not zoom the map out from under the reader.
        cooperativeGestures: true,
        attributionControl: { compact: true },
      });

      map.addControl(new NavigationControl({ visualizePitch: true }), 'top-right');
      // The canvas, not the whole block: fullscreen should show the map, not
      // the map plus the poster hidden behind it.
      map.addControl(new FullscreenControl({ container: canvas }), 'top-right');

      /*
        Only a failure before the style loads is fatal. Afterwards `error` also
        fires for a single tile that did not arrive, and tearing the map down
        over one missing tile would be worse than the gap it leaves.
      */
      let loaded = false;
      map.on('error', () => {
        if (!loaded) {
          map.remove();
          back('Mappa non disponibile, riprova');
        }
      });

      /*
        `style.load`, not `load`.

        `load` waits for the style *and* every tile of the opening view, and if
        one of those never resolves it never fires — which is what happened
        here: the style arrived, the basemap drew, and the features and framing
        were never added, leaving a map of the whole world. Adding sources and
        layers needs the style parsed and nothing more, which is exactly what
        `style.load` reports. It also fires sooner, which matters most to the
        person on mountain data this site is built for.
      */
      /*
        The two icons have to be registered before a layer names them, and
        loading them is asynchronous, so this is where `style.load` earns its
        keep — everything below runs once, in order, after the style is parsed.
      */
      const iconsReady = Promise.all(
        Object.entries(icons).map(async ([kind, url]) => {
          const { pixels, pixelRatio } = await rasterise(url);
          if (!map.hasImage(kind)) map.addImage(kind, pixels, { pixelRatio });
          return kind;
        }),
      )
        .then(() => true)
        // An icon that will not load is not worth losing the map over: the
        // circle layer below covers every kind when this fails.
        .catch(() => false);

      map.on('style.load', async () => {
        loaded = true;
        const hasIcons = await iconsReady;
        /*
          The style's own layers, noted before we add any of ours. Switching to
          the raster basemap hides all of these at once rather than swapping
          the style, which would throw away every layer, source and image we
          have just built and make the switch a reload rather than a toggle.
        */
        const styleLayerIds = map.getStyle().layers.map((layer) => layer.id);
        const firstStyleLayer = styleLayerIds[0];

        map.addSource('raster-base', {
          type: 'raster',
          tiles: [config.RASTER_BASE.tiles],
          tileSize: 256,
          maxzoom: config.RASTER_BASE.maxzoom,
          attribution: config.RASTER_BASE.attribution,
        });
        map.addLayer(
          {
            id: 'raster-base',
            type: 'raster',
            source: 'raster-base',
            layout: { visibility: 'none' },
          },
          // Underneath everything, so turning it on is a matter of hiding what
          // is above it rather than restacking.
          firstStyleLayer,
        );

        map.addSource('thermals', {
          type: 'raster',
          // Opens on the current quarter; the panel can change all three parts.
          tiles: [
            config.thermalTiles('thermals', config.currentThermalSeason(), 'all'),
          ],
          tileSize: 256,
          maxzoom: config.THERMAL_MAXZOOM,
          attribution: config.THERMAL_ATTRIBUTION,
          /*
            kk7 numbers its rows from the south, not the north. Without this the
            tiles still arrive with a 200 and still paint nothing, because the
            row asked for is in the southern hemisphere and empty. The give-away
            was the size: 68 bytes for the tile MapLibre wanted, 137 kB for the
            one directly opposite it.
          */
          scheme: 'tms',
        });

        map.addSource('features', { type: 'geojson', data });

        /*
          The face the basemap labels with, taken from the first style layer
          that names one.
        */
        const styleFont = map
          .getStyle()
          .layers.map(
            (layer) => (layer as { layout?: { 'text-font'?: string[] } }).layout,
          )
          .find((layout) => layout?.['text-font'])?.['text-font'];

        map.addLayer({
          id: 'thermals',
          type: 'raster',
          source: 'thermals',
          layout: { visibility: 'none' },
          // Ghosted, so the map underneath still reads through the heat.
          paint: { 'raster-opacity': 0.5 },
        });

        const kinds = ['takeoff', 'landing', 'obstacle', 'poi'];
        // ['match', kind, 'takeoff', <colour>, …, <fallback>] — one paint
        // expression fed from the CSS tokens, so map and poster stay in step.
        const colourExpression: unknown[] = ['match', ['get', 'kind']];
        for (const kind of kinds) colourExpression.push(kind, colourFor(kind));
        colourExpression.push(colourFor('takeoff'));

        map.addLayer({
          id: 'zones',
          type: 'fill',
          source: 'features',
          filter: ['==', ['geometry-type'], 'Polygon'],
          paint: { 'fill-color': colourExpression as never, 'fill-opacity': 0.25 },
        });
        map.addLayer({
          id: 'zone-outlines',
          type: 'line',
          source: 'features',
          filter: ['==', ['geometry-type'], 'Polygon'],
          paint: { 'line-color': colourExpression as never, 'line-width': 2 },
        });
        map.addLayer({
          id: 'lines',
          type: 'line',
          source: 'features',
          filter: ['==', ['geometry-type'], 'LineString'],
          paint: {
            'line-color': colourExpression as never,
            'line-width': 3,
            'line-dasharray': [3, 2],
          },
        });
        /*
          Dots for whatever has no icon — points of interest, and everything if
          the icons failed to load.
        */
        map.addLayer({
          id: 'points',
          type: 'circle',
          source: 'features',
          filter: hasIcons
            ? [
                'all',
                ['==', ['geometry-type'], 'Point'],
                ['!', ['in', ['get', 'kind'], ['literal', Object.keys(icons)]]],
              ]
            : ['==', ['geometry-type'], 'Point'],
          paint: {
            'circle-radius': 7,
            'circle-color': colourExpression as never,
            'circle-stroke-color': '#ffffff',
            'circle-stroke-width': 2,
          },
        });

        if (hasIcons) {
          for (const kind of Object.keys(icons)) {
            map.addLayer({
              id: `icons-${kind}`,
              type: 'symbol',
              source: 'features',
              filter: [
                'all',
                ['==', ['geometry-type'], 'Point'],
                ['==', ['get', 'kind'], kind],
              ],
              layout: {
                'icon-image': kind,
                'icon-size': 0.22,
                /*
                  A takeoff and its landing can be a few hundred metres apart,
                  and MapLibre hides colliding symbols by default. These are the
                  reason the map exists — none of them may be dropped.
                */
                'icon-allow-overlap': true,
                'icon-ignore-placement': true,
              },
            });
          }
        }
        map.addLayer({
          id: 'labels',
          type: 'symbol',
          source: 'features',
          filter: ['==', ['geometry-type'], 'Point'],
          layout: {
            'text-field': ['get', 'name'],
            /*
              Borrow whatever face the style itself labels with.

              Without this MapLibre falls back to its own default, Open Sans
              plus Arial Unicode — a second font stack, so a second glyph
              request, and marker labels set in a different typeface from every
              other label on the map. Reading it from the style rather than
              naming it means the club can change the font in MapTiler and
              these follow.
            */
            ...(styleFont ? { 'text-font': styleFont } : {}),
            'text-size': 13,
            // Clear of a 22 px icon rather than a 14 px dot.
            'text-offset': [0, 1.6],
            'text-anchor': 'top',
          },
          paint: { 'text-halo-color': '#ffffff', 'text-halo-width': 1.5 },
        });

        /*
          Terrain before the camera, and fenced off.

          Fenced because elevation is a second service that can fail on its own,
          and a renderer without the support for it throws where a flat map
          would have been fine — the worst that may cost is the third dimension.

          Before, because whether it worked decides how far to tilt, and the
          tilt decides the camera. A flat map that is tilted anyway just skews
          the labels for nothing.
        */
        let tilted = false;
        try {
          map.addSource('terrain', {
            type: 'raster-dem',
            url: config.terrainUrl(),
            tileSize: 256,
          });
          /*
            Starts flat. The camera is framed at its final tilt a few lines
            below, and then the ground rises into it — the same ramp the button
            runs, so arriving at the map and switching terrain back on look
            like one another rather than two unrelated behaviours.
          */
          map.setTerrain({ source: 'terrain', exaggeration: 0 });
          tilted = true;
        } catch {
          /* Flat map, every feature still present. */
        }

        /*
          One camera, computed with the tilt already in it.

          Fitting flat and tilting afterwards was wrong: `fitBounds` frames the
          bounds for the camera it is given, and pitching afterwards swings the
          view towards the horizon and pushes the near edge — the takeoffs, at
          the bottom of the frame — straight out of it. `fitBounds` takes a
          `pitch`, so the fit is solved once for the view actually used and
          everything stays inside.

          Reduced motion means no tilt at all: it is the one setting that says
          plainly "do not move the ground under me".
        */
        const pitch = tilted && !prefersReducedMotion() ? config.PITCH : 0;
        /*
          Tilt only where there is something to tilt.

          `fitBounds` solves the camera for a rectangle; a pitched view is a
          trapezoid, and that approximation is fine over kilometres and wrong
          over hundreds of metres. Podio's two points are 900 m apart, and at
          that extent the tilted camera came out pointing at empty ground with
          both markers off frame — whatever zoom cap it was given.

          A site spanning less than this is a takeoff and its landing in one
          valley, where there is no relief to show at that scale anyway, so it
          gets the flat view that has always framed correctly.

          Measuring the real screen positions afterwards and zooming out until
          they fit was tried first and is worse: `project` consults terrain
          that has not loaded, so it reports positions the map will never paint
          and the correction runs away.
        */
        const bounds = boundsOf(data);
        const span = Math.max(bounds[1][0] - bounds[0][0], bounds[1][1] - bounds[0][1]);
        const TILT_MINIMUM_SPAN = 0.02; // Roughly two kilometres.
        const tilt = span >= TILT_MINIMUM_SPAN ? pitch : 0;

        map.fitBounds(bounds, { padding: 60, pitch: tilt, duration: 0 });

        /*
          A popup per marker, as the old map had: what it is, where it is, and
          the two links a pilot actually wants from a point on a map — driving
          directions, and the flight forecast for that spot.

          Built as DOM rather than an HTML string. The old site stored rendered
          markup in the GeoJSON itself; ours holds data, and assembling it here
          means a feature name can contain anything without becoming markup.
        */
        const names = readJson(root, '[data-map-names]') as Record<
          string,
          [string, string]
        >;
        const popup = new Popup({ closeButton: true, maxWidth: '260px' });

        for (const layer of ['points', 'icons-takeoff', 'icons-landing']) {
          if (!map.getLayer(layer)) continue;

          map.on('click', layer, (event) => {
            const feature = event.features?.[0];
            if (!feature || feature.geometry.type !== 'Point') return;
            const [lon, lat] = feature.geometry.coordinates as [number, number];
            const kind = String(feature.properties?.kind ?? '');
            const [emoji, label] = names[kind] ?? ['', ''];

            popup
              .setLngLat([lon, lat])
              .setDOMContent(
                popupContent({
                  kind,
                  site: {
                    title: String(feature.properties?.siteTitle ?? ''),
                    href: String(feature.properties?.siteHref ?? ''),
                  },
                  emoji,
                  label,
                  // The kinds with artwork are exactly the ones with an icon file.
                  hasIcon: Boolean(icons[kind]),
                  name: String(feature.properties?.name ?? ''),
                  point: { lat, lon },
                  links,
                }),
              )
              .addTo(map);
          });

          // A marker that opens something should say so before it is pressed.
          map.on('mouseenter', layer, () => {
            map.getCanvas().style.cursor = 'pointer';
          });
          map.on('mouseleave', layer, () => {
            map.getCanvas().style.cursor = '';
          });
        }

        /*
          The terrain button, once the tilt it restores is known. It replaces
          MapLibre's own so that turning the relief off also takes the camera
          back to straight down — and so the ground rises and falls instead of
          snapping between the two.
        */
        if (tilted) {
          const terrain = new TerrainToggle(
            'terrain',
            config.TERRAIN_EXAGGERATION,
            tilt,
          );
          map.addControl(terrain, 'top-right');
          // Only the ground moves: the camera is already where it belongs, and
          // animating the tilt as well would re-frame from a pitch the bounds
          // were not solved for.
          terrain.rise();

          /*
            And then check the framing again, once the ground has actually
            risen.

            `fitBounds` solves for a flat world — it knows the rectangle, not
            the altitudes inside it. So a takeoff a thousand metres above its
            landing is projected further up the screen than the fit allowed
            for, and on the steepest sites (Prali, Le Grange) it left the frame
            entirely. Nothing was wrong with the fit; the ground moved after it.

            The earlier attempt at this ran immediately and chased its own tail,
            because `project` consults terrain that has not loaded and returns
            positions the map will never paint. Waiting for `idle` is what makes
            it honest: by then the DEM tiles are in and the projection is the
            one on screen. Bounded to six steps of a quarter zoom level, so a
            site that somehow cannot be framed gives up rather than zooming to
            the whole Alps.
          */
          const points = coordinatesOf(data);

          if (points.length > 0 && tilt > 0) {
            const PADDING = 48;
            const MAX_STEPS = 6;
            let steps = 0;

            const allInFrame = () => {
              const box = map.getContainer();
              const width = box.clientWidth;
              const height = box.clientHeight;
              return points.every((point) => {
                const { x, y } = map.project(point);
                return (
                  x >= PADDING &&
                  y >= PADDING &&
                  x <= width - PADDING &&
                  y <= height - PADDING
                );
              });
            };

            const check = () => {
              if (steps >= MAX_STEPS || allInFrame()) return;
              steps += 1;
              map.easeTo({ zoom: map.getZoom() - 0.25, duration: 200 });
              map.once('idle', check);
            };

            map.once('idle', check);
          }
        }

        /*
          Where "reset" goes back to. Read off the map rather than recomputed,
          so it is exactly the view the visitor was given.
        */
        const home = {
          center: map.getCenter(),
          zoom: map.getZoom(),
          bearing: map.getBearing(),
          pitch: map.getPitch(),
        };
        map.addControl(new ResetControl(home, root), 'top-right');
        map.addControl(new LayersControl(map, styleLayerIds, config), 'top-right');
      });
    } catch {
      back('Mappa non disponibile, riprova');
    }
  }

  /**
   * Put the poster back.
   *
   * The drawing and the table below it say everything the map says, so a
   * failure should return the page to what it had rather than leave an empty
   * frame where a map was promised.
   */
  function fail(
    root: HTMLElement,
    canvas: HTMLElement,
    button: HTMLButtonElement,
    label: HTMLElement,
    message: string,
  ) {
    root.classList.remove('map--open');
    canvas.hidden = true;
    canvas.replaceChildren();
    button.disabled = false;
    label.textContent = message;
  }

  /** The icons' own square, and the size they are authored at. */
  const ICON_SIZE = 100;

  function prefersReducedMotion(): boolean {
    return matchMedia('(prefers-reduced-motion: reduce)').matches;
  }

  interface PopupParts {
    kind: string;
    /** Both empty on a site's own map. */
    site: { title: string; href: string };
    emoji: string;
    label: string;
    name: string;
    hasIcon: boolean;
    point: { lat: number; lon: number };
    links: {
      formatCoordinates(point: { lat: number; lon: number }): string;
      navigationUrl(point: { lat: number; lon: number }): string;
      forecastUrl(point: { lat: number; lon: number }): string;
    };
  }

  /** The popup's contents, as elements. */
  function popupContent({
    kind,
    site,
    emoji,
    label,
    name,
    hasIcon,
    point,
    links,
  }: PopupParts): HTMLElement {
    const root = document.createElement('div');
    root.className = 'map-popup';

    const heading = document.createElement('p');
    heading.className = 'map-popup__name';
    heading.append(popupIcon({ kind, emoji, hasIcon }), ' ');
    heading.append(
      Object.assign(document.createElement('strong'), { textContent: name }),
    );

    const kindLine = document.createElement('p');
    kindLine.className = 'map-popup__kind';
    kindLine.textContent = label;
    // On the overview map, say which site this belongs to and offer its page.
    if (site.href) {
      kindLine.append(document.createTextNode(' · '));
      const link = document.createElement('a');
      link.href = site.href;
      link.textContent = site.title;
      kindLine.append(link);
    }

    const coords = document.createElement('p');
    coords.className = 'map-popup__coords';
    coords.textContent = links.formatCoordinates(point);

    const actions = document.createElement('p');
    actions.className = 'map-popup__links';
    /*
      The forecast is offered on takeoffs only. Meteo-Parapente answers "can I
      fly from here", which is a question about the hill you launch from — on a
      landing field or a car park it is noise dressed as information.
    */
    const destinations: [string, string][] = [
      [links.navigationUrl(point), '🗺️ Naviga'],
    ];
    if (kind === 'takeoff')
      destinations.push([links.forecastUrl(point), '🌤️ Previsioni']);

    for (const [href, text] of destinations) {
      const link = document.createElement('a');
      link.href = href;
      link.target = '_blank';
      // Both go to other people's sites; noopener is the default for target
      // _blank in modern browsers but saying it costs nothing.
      link.rel = 'noopener noreferrer';
      link.textContent = text;
      actions.append(link);
    }

    root.append(heading, kindLine, coords, actions);
    return root;
  }

  /**
   * The marker's own drawing, so the popup matches the thing it points at.
   *
   * Takeoffs and landings have artwork and use it, from the sprite the page
   * already renders. The obstacle keeps its warning glyph — a hazard should
   * read as one, and there is no drawing for it. Anything else takes the
   * coloured dot the table and the poster give it. Decorative in every case:
   * the written label sits beside it.
   */
  function popupIcon({
    kind,
    emoji,
    hasIcon,
  }: {
    kind: string;
    emoji: string;
    hasIcon: boolean;
  }): Element {
    if (hasIcon) {
      const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
      svg.setAttribute('class', 'map-popup__icon');
      svg.setAttribute('viewBox', '0 0 100 100');
      svg.setAttribute('aria-hidden', 'true');
      const use = document.createElementNS('http://www.w3.org/2000/svg', 'use');
      use.setAttribute('href', `#feature-${kind}`);
      svg.append(use);
      return svg;
    }

    const span = document.createElement('span');
    span.setAttribute('aria-hidden', 'true');
    if (kind === 'obstacle') span.textContent = emoji;
    else span.className = `map-popup__dot map-popup__dot--${kind}`;
    return span;
  }

  /** What a layers panel needs from the map. */
  interface LayerMap {
    setLayoutProperty(layer: string, name: string, value: unknown): void;
    getLayer(id: string): unknown;
    // `unknown` because MapLibre's own return type is a union of every source
    // kind, and only the raster ones carry setTiles.
    getSource(id: string): unknown;
  }

  interface ThermalConfig {
    RASTER_BASE: { label: string };
    THERMAL_LAYERS: readonly { value: string; label: string }[];
    THERMAL_SEASONS: readonly { value: string; label: string }[];
    THERMAL_TIMES: readonly { value: string; label: string }[];
    currentThermalSeason(): string;
    thermalTiles(layer: string, season: string, time: string): string;
  }

  /**
   * Choose the basemap, and what kk7 data to lay over it.
   *
   * Two decisions worth recording. The basemap switch hides the style's layers
   * rather than calling `setStyle`: a style swap discards every source, layer
   * and image the map has built, so the markers, the terrain and the icons
   * would all need rebuilding and the switch would read as a reload. Hiding is
   * instant and reversible.
   *
   * And the kk7 filters change the source's tile URLs in place rather than
   * adding a layer per combination — there are forty of them, and MapLibre
   * refetches on `setTiles` anyway.
   */
  class LayersControl {
    #map: LayerMap;
    #styleLayerIds: string[];
    #config: ThermalConfig;
    #container: HTMLElement | null = null;

    // What the overlay currently shows. Empty layer means it is off.
    #layer = '';
    #season: string;
    #time = 'all';

    constructor(map: LayerMap, styleLayerIds: string[], config: ThermalConfig) {
      this.#map = map;
      this.#styleLayerIds = styleLayerIds;
      this.#config = config;
      this.#season = config.currentThermalSeason();
    }

    onAdd() {
      const container = document.createElement('div');
      container.className = 'maplibregl-ctrl maplibregl-ctrl-group map-layers';

      const toggle = document.createElement('button');
      toggle.type = 'button';
      toggle.className = 'maplibregl-ctrl-icon map-layers__toggle';
      toggle.title = 'Livelli della mappa';
      toggle.setAttribute('aria-label', 'Livelli della mappa');
      toggle.setAttribute('aria-expanded', 'false');
      toggle.innerHTML =
        '<svg class="map-layers__icon" viewBox="0 0 24 24" aria-hidden="true" ' +
        'focusable="false" fill="none" stroke="currentColor" stroke-width="2" ' +
        'stroke-linecap="round" stroke-linejoin="round">' +
        '<polygon points="12 3 3 8.25 12 13.5 21 8.25 12 3"></polygon>' +
        '<polyline points="3 12.75 12 18 21 12.75"></polyline>' +
        '<polyline points="3 17.25 12 22 21 17.25"></polyline></svg>';

      const panel = document.createElement('div');
      panel.className = 'map-layers__panel';
      panel.hidden = true;

      // Background.
      const base = document.createElement('fieldset');
      base.append(
        Object.assign(document.createElement('legend'), { textContent: 'Sfondo' }),
      );
      const group = `base-${Math.random().toString(36).slice(2, 8)}`;
      base.append(
        this.#radio(group, 'Topografica (vettoriale)', true, () =>
          this.#showRaster(false),
        ),
        this.#radio(group, this.#config.RASTER_BASE.label, false, () =>
          this.#showRaster(true),
        ),
      );

      // The kk7 overlay, and the two filters that shape it.
      const overlay = document.createElement('fieldset');
      overlay.append(
        Object.assign(document.createElement('legend'), { textContent: 'Voli' }),
      );
      const layerGroup = `kk7-${Math.random().toString(36).slice(2, 8)}`;
      overlay.append(
        this.#radio(layerGroup, 'Nessuno', true, () => this.#setLayer('')),
        ...this.#config.THERMAL_LAYERS.map((option) =>
          this.#radio(layerGroup, option.label, false, () =>
            this.#setLayer(option.value),
          ),
        ),
      );

      const filters = document.createElement('div');
      filters.className = 'map-layers__filters';
      filters.append(
        this.#select('Periodo', this.#config.THERMAL_SEASONS, this.#season, (value) => {
          this.#season = value;
          this.#refresh();
        }),
        this.#select('Ora', this.#config.THERMAL_TIMES, this.#time, (value) => {
          this.#time = value;
          this.#refresh();
        }),
      );
      overlay.append(filters);

      panel.append(base, overlay);
      // Tracked here rather than read back off `hidden`, whose DOM type is
      // `string | boolean` and needs coercing at every use.
      let open = false;
      const setOpen = (next: boolean) => {
        open = next;
        panel.hidden = !next;
        toggle.setAttribute('aria-expanded', String(next));
      };

      toggle.addEventListener('click', () => setOpen(!open));

      /*
        Anywhere else closes it — the map included, which is the usual way out
        of a panel that sits over one. The listener is on the document rather
        than the map so a click on the page around it counts too, and Escape is
        there because a keyboard user has no "outside" to click.
      */
      document.addEventListener('pointerdown', (event) => {
        if (!open) return;
        if (!container.contains(event.target as Node)) setOpen(false);
      });
      document.addEventListener('keydown', (event) => {
        if (!open || event.key !== 'Escape') return;
        setOpen(false);
        toggle.focus();
      });

      container.append(toggle, panel);
      this.#container = container;
      return container;
    }

    onRemove() {
      this.#container?.remove();
      this.#container = null;
    }

    #radio(name: string, text: string, checked: boolean, onPick: () => void) {
      const label = document.createElement('label');
      const input = document.createElement('input');
      input.type = 'radio';
      input.name = name;
      input.checked = checked;
      input.addEventListener('change', () => input.checked && onPick());
      label.append(input, document.createTextNode(text));
      return label;
    }

    #select(
      text: string,
      options: readonly { value: string; label: string }[],
      selected: string,
      onPick: (value: string) => void,
    ) {
      const label = document.createElement('label');
      label.className = 'map-layers__filter';
      label.append(
        Object.assign(document.createElement('span'), { textContent: text }),
      );

      const select = document.createElement('select');
      for (const option of options) {
        const element = document.createElement('option');
        element.value = option.value;
        element.textContent = option.label;
        element.selected = option.value === selected;
        select.append(element);
      }
      select.addEventListener('change', () => onPick(select.value));
      label.append(select);
      return label;
    }

    #setLayer(layer: string) {
      this.#layer = layer;
      this.#refresh();
    }

    /** Point the source at the chosen combination, and show or hide it. */
    #refresh() {
      if (this.#layer) {
        const source = this.#map.getSource('thermals') as
          { setTiles?(tiles: string[]): unknown } | undefined;
        source?.setTiles?.([
          this.#config.thermalTiles(this.#layer, this.#season, this.#time),
        ]);
      }
      this.#setVisible('thermals', Boolean(this.#layer));
    }

    #setVisible(id: string, visible: boolean) {
      if (this.#map.getLayer(id)) {
        this.#map.setLayoutProperty(id, 'visibility', visible ? 'visible' : 'none');
      }
    }

    #showRaster(on: boolean) {
      this.#setVisible('raster-base', on);
      for (const id of this.#styleLayerIds) this.#setVisible(id, !on);
    }
  }

  /** The bit of MapLibre a terrain animation needs. */
  interface TerrainMap {
    setTerrain(terrain: { source: string; exaggeration: number } | null): void;
    // `exaggeration` is optional in MapLibre's own type, so it is here too, or
    // the control stops being assignable to IControl.
    getTerrain(): { exaggeration?: number } | null;
    setPitch(pitch: number): void;
    getPitch(): number;
  }

  /**
   * Terrain on/off, with the ground rising rather than snapping.
   *
   * MapLibre's own `TerrainControl` sets terrain in one step, which lands as a
   * jolt: the whole map jumps from flat to relief between two frames. Animating
   * `exaggeration` from zero instead makes the valley grow out of the flat map
   * the way MapTiler's SDK does it, and the same ramp in reverse flattens it.
   *
   * The tilt rides along, because the two belong together: a tilted view of a
   * flat map is just skewed labels, so turning terrain off returns the camera
   * to straight down and turning it on tilts back.
   *
   * It carries MapLibre's own class names, so the icons and styling that apply
   * to its control apply to this one unchanged.
   */
  class TerrainToggle {
    #map: TerrainMap | null = null;
    #button: HTMLButtonElement | null = null;
    #container: HTMLElement | null = null;
    #enabled = true;
    #frame = 0;
    #source: string;
    #exaggeration: number;
    #pitch: number;

    constructor(source: string, exaggeration: number, pitch: number) {
      this.#source = source;
      this.#exaggeration = exaggeration;
      this.#pitch = pitch;
    }

    onAdd(map: TerrainMap) {
      this.#map = map;

      const container = document.createElement('div');
      container.className = 'maplibregl-ctrl maplibregl-ctrl-group';

      const button = document.createElement('button');
      button.type = 'button';
      // MapLibre puts the icon on a child span and the state on the button,
      // which is what its stylesheet — and ours — selects on.
      button.append(
        Object.assign(document.createElement('span'), {
          className: 'maplibregl-ctrl-icon',
        }),
      );
      button.addEventListener('click', () => this.#toggle());

      container.append(button);
      this.#button = button;
      this.#container = container;
      this.#render();
      return container;
    }

    onRemove() {
      cancelAnimationFrame(this.#frame);
      this.#container?.remove();
      this.#container = null;
      this.#map = null;
    }

    #render() {
      const button = this.#button;
      if (!button) return;
      button.className = this.#enabled
        ? 'maplibregl-ctrl-terrain-enabled'
        : 'maplibregl-ctrl-terrain';
      const label = this.#enabled ? 'Disattiva il rilievo 3D' : 'Attiva il rilievo 3D';
      button.title = label;
      button.setAttribute('aria-label', label);
      button.setAttribute('aria-pressed', String(this.#enabled));
    }

    #toggle() {
      this.#enabled = !this.#enabled;
      this.#render();
      this.#animate();
    }

    /** The opening ramp, from the flat map the camera was framed on. */
    rise() {
      this.#animate();
    }

    #animate() {
      const map = this.#map;
      if (!map) return;
      cancelAnimationFrame(this.#frame);

      const toExaggeration = this.#enabled ? this.#exaggeration : 0;
      const toPitch = this.#enabled ? this.#pitch : 0;
      const fromExaggeration = map.getTerrain()?.exaggeration ?? 0;
      const fromPitch = map.getPitch();

      // Growing terrain has to exist at zero before it can rise from it.
      if (this.#enabled && !map.getTerrain()) {
        map.setTerrain({ source: this.#source, exaggeration: 0 });
      }

      const settle = () => {
        if (this.#enabled)
          map.setTerrain({ source: this.#source, exaggeration: toExaggeration });
        else map.setTerrain(null);
        map.setPitch(toPitch);
      };

      // The setting exists precisely to refuse this kind of movement.
      if (prefersReducedMotion()) {
        settle();
        return;
      }

      const DURATION = 900;
      const start = performance.now();
      const step = (now: number) => {
        const t = Math.min((now - start) / DURATION, 1);
        // easeInOutQuad, so the ground neither snaps away nor drifts.
        const eased = t < 0.5 ? 2 * t * t : 1 - (-2 * t + 2) ** 2 / 2;
        map.setTerrain({
          source: this.#source,
          exaggeration: fromExaggeration + (toExaggeration - fromExaggeration) * eased,
        });
        map.setPitch(fromPitch + (toPitch - fromPitch) * eased);
        if (t < 1) this.#frame = requestAnimationFrame(step);
        else settle();
      };
      this.#frame = requestAnimationFrame(step);
    }
  }

  /** What the map goes back to. */
  interface Camera {
    center: { lng: number; lat: number };
    zoom: number;
    bearing: number;
    pitch: number;
  }

  /**
   * A "back to the start" button, which MapLibre has no equivalent of.
   *
   * Panning away from a site is easy and finding it again is not, particularly
   * on a phone where a stray drag moves the map. It builds a plain button
   * inside MapLibre's own `ctrl-group` wrapper, so it inherits the styling,
   * spacing and focus ring of the zoom and terrain buttons beside it rather
   * than needing any of its own.
   */
  class ResetControl {
    #home: Camera;
    #root: HTMLElement;
    #container: HTMLElement | null = null;

    constructor(home: Camera, root: HTMLElement) {
      this.#home = home;
      this.#root = root;
    }

    onAdd(map: { easeTo(options: Camera & { duration: number }): void }) {
      const root = this.#root;
      const container = document.createElement('div');
      container.className = 'maplibregl-ctrl maplibregl-ctrl-group';

      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'maplibregl-ctrl-icon';
      // The control is icon-only, so the name has to come from somewhere.
      button.title = 'Torna alla vista iniziale';
      button.setAttribute('aria-label', 'Torna alla vista iniziale');
      /*
        The club's icon, carried over from the old site's Leaflet reset control.
        It arrives as markup rather than a URL so its `currentColor` fill has a
        context to inherit from; a background image would have none.
      */
      button.innerHTML = (root.dataset.resetIcon ?? '').replace(
        '<svg',
        '<svg class="map-reset-icon"',
      );
      button.addEventListener('click', () => {
        map.easeTo({ ...this.#home, duration: prefersReducedMotion() ? 0 : 800 });
      });

      container.append(button);
      this.#container = container;
      return container;
    }

    onRemove() {
      this.#container?.remove();
      this.#container = null;
    }
  }

  /**
   * An SVG turned into pixels at the density of the screen it will be drawn on.
   *
   * MapLibre's `addImage` takes bitmap data, so vector artwork has to be
   * rasterised somewhere; doing it here rather than shipping a PNG means the
   * same file is sharp at 1x and at 3x. `pixelRatio` is how MapLibre is told
   * the bitmap is oversampled, so `icon-size` keeps meaning CSS pixels and the
   * 0.22 the old map used still renders 22 of them.
   */
  async function rasterise(url: string) {
    const pixelRatio = Math.min(window.devicePixelRatio || 1, 3);
    const side = Math.round(ICON_SIZE * pixelRatio);

    const image = new Image();
    image.decoding = 'async';
    image.src = url;
    await image.decode();

    const canvas = document.createElement('canvas');
    canvas.width = side;
    canvas.height = side;
    const context = canvas.getContext('2d');
    if (!context) throw new Error('no 2d context');
    context.drawImage(image, 0, 0, side, side);

    return { pixels: context.getImageData(0, 0, side, side), pixelRatio };
  }

  /**
   * A custom property's *used* colour, as `rgb(...)`.
   *
   * `getPropertyValue('--color-map-takeoff')` hands back the declaration
   * verbatim — here that is the string `light-dark(#1f52a6, #7997ca)`, which
   * means nothing to a renderer that is not a browser. MapLibre took it,
   * failed to parse it, and drew no markers at all.
   *
   * Painting it onto a throwaway element and reading `color` back makes the
   * browser do the resolving: `light-dark()` collapses to whichever half the
   * current colour scheme calls for, and the result is a plain rgb() triple.
   * It also means the map picks up the theme the visitor is actually in.
   */
  function resolveColour(name: string): string {
    const probe = document.createElement('span');
    probe.style.color = `var(${name})`;
    probe.style.display = 'none';
    document.body.append(probe);
    const colour = getComputedStyle(probe).color;
    probe.remove();
    // Falls back to the brand blue, which is the takeoff colour anyway.
    return colour || '#1f52a6';
  }

  function readJson(root: HTMLElement, selector: string) {
    return JSON.parse(root.querySelector(selector)?.textContent ?? '{}');
  }

  /** Resolves when the stylesheet is in, so the map never paints unstyled. */
  function loadStylesheet(href: string): Promise<void> {
    if (document.querySelector(`link[href="${href}"]`)) return Promise.resolve();
    return new Promise((resolve, reject) => {
      const link = document.createElement('link');
      link.rel = 'stylesheet';
      link.href = href;
      link.addEventListener('load', () => resolve(), { once: true });
      link.addEventListener('error', () => reject(new Error(href)), { once: true });
      document.head.append(link);
    });
  }

  interface GeoJsonLike {
    features: { geometry: { type: string; coordinates: unknown } }[];
  }

  /** [[w, s], [e, n]] over every coordinate, at any nesting depth. */
  /**
   * Every coordinate pair in the data, however deeply nested.
   *
   * The same walk `boundsOf` does, kept separate because the framing check
   * needs the points themselves rather than the rectangle around them: a
   * rectangle says nothing about where each corner ends up once terrain lifts
   * it up the screen.
   */
  function coordinatesOf(data: GeoJsonLike): [number, number][] {
    const found: [number, number][] = [];
    const visit = (value: unknown) => {
      if (!Array.isArray(value)) return;
      if (typeof value[0] === 'number' && typeof value[1] === 'number') {
        found.push(value as [number, number]);
        return;
      }
      for (const item of value) visit(item);
    };
    for (const feature of data.features) visit(feature.geometry?.coordinates);
    return found;
  }

  function boundsOf(data: GeoJsonLike): [[number, number], [number, number]] {
    let west = 180;
    let south = 90;
    let east = -180;
    let north = -90;

    const visit = (value: unknown) => {
      if (!Array.isArray(value)) return;
      if (typeof value[0] === 'number' && typeof value[1] === 'number') {
        const [lon, lat] = value as [number, number];
        west = Math.min(west, lon);
        east = Math.max(east, lon);
        south = Math.min(south, lat);
        north = Math.max(north, lat);
        return;
      }
      for (const item of value) visit(item);
    };
    for (const feature of data.features) visit(feature.geometry.coordinates);

    return [
      [west, south],
      [east, north],
    ];
  }

  for (const root of document.querySelectorAll<HTMLElement>('[data-map]')) setup(root);
</script>
