---
/**
 * Site footer (G7, G8).
 *
 * Ports the five footer-region blocks from Drupal:
 *   vr_socialmedia      -> social links       (block_content, Facebook only)
 *   vr_footer           -> footer menu        (empty in content/, omitted)
 *
 * There is no legal / VAT line. A `block_content` titled "Footer" carries one,
 * but no `block.block.*.yml` ever placed it, so Drupal never rendered it and it
 * appears nowhere in the archived `html/` build. It was a draft, not content.
 * (It also contains a personal codice fiscale: worth a deliberate decision
 * before publishing, not an accident of migration.)
 *   vr_gtranslate       -> <LanguageSwitcher> (G11)
 *   vr_themetoggle      -> <ThemeToggle>      (G10)
 *
 * `vr_creditiimmagine` (G8) is *not* here. It was a footer-region block in
 * Drupal, but it was rendered bottom-right of <main> and it only ever credits
 * the homepage background photo, so it lives with that picture instead (see
 * `.hero__credit` in index.astro). Nothing about the site chrome has to know
 * which page happens to have an image.
 *
 * The social links and legal line become Keystatic singletons in Phase 2; they
 * are inline here so the shell is reviewable.
 */
import { getEntry } from 'astro:content';

import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';

/*
  The icons live here and the addresses live in the CMS.

  An editor picks a network and pastes a URL; the path data stays in code,
  because asking a volunteer for SVG geometry is asking for a broken footer.
  Adding a network means adding it in both places: the enum in
  content.config.ts refuses one that has no icon here, so the build says so
  rather than the footer rendering a hole.
*/
const ICONS: Record<string, { label: string; path: string }> = {
  facebook: {
    label: 'Facebook',
    path: 'M16 8.049c0-4.446-3.582-8.05-8-8.05C3.58 0-.002 3.603-.002 8.05c0 4.017 2.926 7.347 6.75 7.951v-5.625h-2.03V8.05H6.75V6.275c0-2.017 1.195-3.131 3.022-3.131.876 0 1.791.157 1.791.157v1.98h-1.009c-.993 0-1.303.621-1.303 1.258v1.51h2.218l-.354 2.326H9.25V16c3.824-.604 6.75-3.934 6.75-7.951z',
  },
  instagram: {
    label: 'Instagram',
    path: 'M8 0C5.829 0 5.556.01 4.703.048 3.85.088 3.269.222 2.76.42a3.9 3.9 0 0 0-1.417.923A3.9 3.9 0 0 0 .42 2.76C.222 3.268.087 3.85.048 4.7.01 5.555 0 5.827 0 8.001c0 2.172.01 2.444.048 3.297.04.852.174 1.433.372 1.942.205.526.478.972.923 1.417.444.445.89.719 1.416.923.51.198 1.09.333 1.942.372C5.555 15.99 5.827 16 8 16s2.444-.01 3.298-.048c.851-.04 1.434-.174 1.943-.372a3.9 3.9 0 0 0 1.416-.923c.445-.445.718-.891.923-1.417.197-.509.332-1.09.372-1.942C15.99 10.445 16 10.173 16 8s-.01-2.445-.048-3.299c-.04-.851-.175-1.433-.372-1.941a3.9 3.9 0 0 0-.923-1.417A3.9 3.9 0 0 0 13.24.42c-.51-.198-1.092-.333-1.943-.372C10.443.01 10.172 0 7.998 0zm-.717 1.442h.718c2.136 0 2.389.007 3.232.046.78.035 1.204.166 1.486.275.373.145.64.319.92.599s.453.546.598.92c.11.281.24.705.275 1.485.039.843.047 1.096.047 3.231s-.008 2.389-.047 3.232c-.035.78-.166 1.203-.275 1.485a2.5 2.5 0 0 1-.599.919c-.28.28-.546.453-.92.598-.28.11-.704.24-1.485.276-.843.038-1.096.047-3.232.047s-2.39-.009-3.233-.047c-.78-.036-1.203-.166-1.485-.276a2.5 2.5 0 0 1-.92-.598 2.5 2.5 0 0 1-.6-.92c-.109-.281-.24-.705-.275-1.485-.038-.843-.046-1.096-.046-3.233s.008-2.388.046-3.231c.036-.78.166-1.204.276-1.486.145-.373.319-.64.599-.92s.546-.453.92-.598c.282-.11.705-.24 1.485-.276.738-.034 1.024-.044 2.515-.045zm4.988 1.328a.96.96 0 1 0 0 1.92.96.96 0 0 0 0-1.92m-4.27 1.122a4.109 4.109 0 1 0 0 8.217 4.109 4.109 0 0 0 0-8.217m0 1.441a2.667 2.667 0 1 1 0 5.334 2.667 2.667 0 0 1 0-5.334',
  },
  youtube: {
    label: 'YouTube',
    path: 'M8.051 1.999h.089c.822.003 4.987.033 6.11.335a2.01 2.01 0 0 1 1.415 1.42c.101.38.172.883.22 1.402l.01.104.022.26.008.104c.065.914.073 1.77.074 1.957v.075c-.001.194-.01 1.108-.082 2.06l-.008.105-.009.104c-.05.572-.124 1.14-.235 1.558a2.01 2.01 0 0 1-1.415 1.42c-1.16.312-5.569.334-6.18.335h-.142c-.309 0-1.587-.006-2.927-.052l-.17-.006-.087-.004-.171-.007-.171-.007c-1.11-.049-2.167-.128-2.654-.26a2.01 2.01 0 0 1-1.415-1.419c-.111-.417-.185-.986-.235-1.558L.09 9.82l-.008-.104A31 31 0 0 1 0 7.68v-.123c.002-.215.01-.958.064-1.778l.007-.103.003-.052.008-.104.022-.26.01-.104c.048-.519.119-1.023.22-1.402a2.01 2.01 0 0 1 1.415-1.42c.487-.13 1.544-.21 2.654-.26l.17-.007.172-.006.086-.003.171-.007A100 100 0 0 1 7.858 2zM6.4 5.209v4.818l4.157-2.408z',
  },
};

const settings = await getEntry('settings', 'social');
const org = (await getEntry('settings', 'organization'))?.data;

/*
  The legal line. Only what is filled in appears: an ASD's registry data is
  not something this repository can know, and a placeholder on a legal notice
  is worse than a short one.
*/
const legal = [
  org?.legalName,
  org?.taxCode && `C.F. ${org.taxCode}`,
  org?.vatNumber && `P.IVA ${org.vatNumber}`,
].filter(Boolean);
const SOCIAL = (settings?.data.links ?? []).map(({ network, href }) => ({
  href,
  ...ICONS[network],
}));
---

<footer class="footer">
  <div class="footer__inner container">
    <ul class="footer__social">
      {
        SOCIAL.map(({ label, href, path }) => (
          <li>
            <a href={href} target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true">
                <path fill="currentColor" d={path} />
              </svg>
              <span class="visually-hidden">{label}</span>
            </a>
          </li>
        ))
      }
    </ul>

    {
      /* Required to be reachable from every page, which is why it is here
        rather than in the nav. */
    }
    {
      /* Reachable from every page, which is why it is here and not in the
        nav. `notranslate` on the identifiers: a codice fiscale has to survive
        the translator untouched. */
    }
    <p class="footer__legal">
      {legal.length > 0 && <span class="notranslate">{legal.join(' · ')}</span>}
      <a href="/privacy">Privacy</a>
      <a href="/stampa">Media kit</a>
    </p>

    <div class="footer__controls">
      <LanguageSwitcher />
      <ThemeToggle />
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    margin-block-start: auto;
    padding-block: var(--space-md);
    border-top: 1px solid var(--color-border);
    background-color: var(--color-bg-subtle);
    box-shadow: var(--shadow-chrome-up);
    font-size: var(--text-sm);
  }

  /*
    The old site's contour pattern, back where it was, `main + footer` had
    `background-image: var(--bg-countour)`.

    Drawn through a mask rather than as a background image, so one file works
    in both colour schemes: the SVG supplies the shape, `--color-topo` the
    colour. As a background image it was a fixed grey that had to be light
    enough for the light theme and so vanished on the dark one.

    On a pseudo-element because the footer's own background has to stay a flat
    token, and because a mask on the footer itself would clip its children.
  */
  .footer::before {
    content: '';
    position: absolute;
    inset: 0;
    background-color: var(--color-topo);
    mask-image: url('/topo.svg');
    mask-size: 600px;
    pointer-events: none;
  }

  .footer__inner {
    position: relative;
  }

  /*
    Three columns, not `space-between` on a wrapping flex row.

    `space-between` gave the legal line whatever space the other two left, so
    it was never actually centred, and when the row ran out of width the three
    groups wrapped into a ragged left-aligned stack with the social icon
    stranded on a line of its own. `1fr auto 1fr` centres the legal line on the
    footer rather than between its neighbours, and below the breakpoint the
    whole thing becomes one centred column on purpose instead of by accident.
  */
  .footer__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-sm);
  }

  .footer__social {
    justify-self: start;
  }

  .footer__controls {
    justify-self: end;
  }

  /* Where the three groups stop fitting on one line. */
  @media (width < 46rem) {
    .footer__inner {
      grid-template-columns: 1fr;
      justify-items: center;
      gap: var(--space-xs);
    }

    .footer__social,
    .footer__controls {
      justify-self: center;
    }

    /* The identity takes its own line, so the two links stay together on the
       next one instead of splitting two-and-one. */
    .footer__legal > .notranslate {
      flex-basis: 100%;
    }
  }

  .footer__social {
    display: flex;
    gap: var(--space-2xs);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer__controls {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .footer__social a {
    display: flex;
    padding: var(--space-2xs);
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);
  }

  .footer__social a:hover {
    color: var(--color-accent);
  }

  /*
    Body colour, not muted: `--color-text-muted` on the footer's own
    `--color-bg-subtle` measures 4.29:1, under the line for 15px text. It is
    also a link, and one that has to be findable.
  */
  .footer__legal {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    gap: var(--space-2xs) var(--space-sm);
    color: var(--color-text);
    text-align: center;
  }

  .footer__legal a {
    color: var(--color-text);
  }

  .footer__legal a:hover {
    color: var(--color-accent);
  }
</style>
