---
/**
 * Light / dark / auto theme picker.
 *
 * Replaces the Drupal `helper` module's toggle block (G10), which was a
 * Bootstrap dropdown: one button showing the *active* theme's icon, opening a
 * menu of Chiaro / Scuro / Auto with a tick beside the current one. Same shape
 * here, because a three-segment control is three times the footer furniture for
 * a setting most visitors never touch.
 *
 * Built on <details>, not the Popover API. A popover lives in the top layer,
 * whose containing block is the viewport, so positioning it under its button
 * needs CSS anchor positioning, not something to depend on for a footer
 * control. <details> gives the open/close state and keyboard support for free;
 * the script below adds only what it lacks: outside-click and Escape.
 *
 * The radios remain the actual control, so the browser still handles grouping,
 * arrow-key navigation and the checked state. The summary is a label for them.
 *
 * The no-flash script that reads localStorage before first paint lives in
 * BaseLayout's <head>; this component only renders the control.
 */

/* 24x24, stroke-based, matching weights: drawn inline rather than pulled from
   an icon package for three glyphs that will never change. */
const ICONS = {
  light: `<circle cx="12" cy="12" r="4.25" />
    <path d="M12 2.5v2M12 19.5v2M4.22 4.22l1.41 1.41M18.37 18.37l1.41 1.41M2.5 12h2M19.5 12h2M4.22 19.79l1.41-1.42M18.37 5.63l1.41-1.41" />`,
  dark: `<path d="M20.4 13.4A8.5 8.5 0 0 1 10.6 3.6a8.5 8.5 0 1 0 9.8 9.8Z" />`,
  auto: `<circle cx="12" cy="12" r="9" />
    <path d="M12 3a9 9 0 0 1 0 18Z" fill="currentColor" stroke="none" />`,
} as const;

const OPTIONS = [
  { value: 'light', label: 'Chiaro' },
  { value: 'dark', label: 'Scuro' },
  { value: 'auto', label: 'Automatico' },
] as const;

const SVG_ATTRS = {
  viewBox: '0 0 24 24',
  width: 16,
  height: 16,
  fill: 'none',
  stroke: 'currentColor',
  'stroke-width': 1.75,
  'stroke-linecap': 'round',
  'stroke-linejoin': 'round',
  'aria-hidden': 'true',
} as const;

/*
  The tick's class lives in the spread object, not as a separate `class`
  attribute beside it: on an element that has both, Astro's scoped-style class
  injection overwrites the standalone `class`, and the rule silently never
  matches, which showed up as a tick beside every option.
*/
const CHECK_ATTRS = { ...SVG_ATTRS, class: 'check' } as const;
---

<details class="theme-toggle" data-theme-toggle>
  {
    /*
    Rendered as `auto`, which is what the no-flash script falls back to; the
    script below swaps in the stored theme's icon on load.
  */
  }
  <summary aria-label="Tema del sito: Automatico" data-theme-summary>
    <svg {...SVG_ATTRS} data-theme-icon set:html={ICONS.auto} />
  </summary>

  <div class="theme-toggle__menu">
    <fieldset>
      <legend class="visually-hidden">Tema del sito</legend>
      {
        OPTIONS.map(({ value, label }) => (
          <>
            <input type="radio" name="theme" id={`theme-${value}`} value={value} />
            <label for={`theme-${value}`}>
              <svg {...SVG_ATTRS} set:html={ICONS[value]} />
              <span>{label}</span>
              <svg {...CHECK_ATTRS}>
                <path d="m4.5 12.5 5 5 10-11" />
              </svg>
            </label>
          </>
        ))
      }
    </fieldset>
  </div>
</details>

<style>
  .theme-toggle {
    position: relative;
  }

  summary {
    display: flex;
    padding: 0.375rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background-color: var(--color-bg);
    color: var(--color-text-muted);
    cursor: pointer;
    list-style: none; /* Firefox */
    transition:
      background-color var(--transition),
      color var(--transition);
  }

  /* Safari/Chrome's disclosure triangle. */
  summary::-webkit-details-marker {
    display: none;
  }

  summary:hover,
  [open] summary {
    color: var(--color-accent);
    border-color: var(--color-border-strong);
  }

  summary:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .theme-toggle__menu {
    position: absolute;
    z-index: 50;
    /* Opens upward: this control lives in the footer, at the bottom of the
       page, where a downward menu would fall outside the viewport. */
    inset-block-end: calc(100% + var(--space-2xs));
    inset-inline-end: 0;
    min-width: 11rem;
    padding: var(--space-3xs);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background-color: var(--color-bg-raised);
    box-shadow: var(--shadow-md);
  }

  fieldset {
    display: flex;
    flex-direction: column;
    gap: 1px;
    margin: 0;
    padding: 0;
    border: 0;
  }

  input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  label {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    padding: var(--space-3xs) var(--space-2xs);
    border-radius: var(--radius-sm);
    color: var(--color-text);
    font-size: var(--text-sm);
    cursor: pointer;
    user-select: none;
    transition: background-color var(--transition);
  }

  label:hover {
    background-color: var(--color-bg-subtle);
  }

  /* The inputs are visually hidden, so mirror their focus onto the label. */
  input:focus-visible + label {
    outline: 2px solid var(--color-focus);
    outline-offset: -2px;
  }

  input:checked + label {
    color: var(--color-accent);
    font-weight: 500;
  }

  /* The tick marks the active theme, as the old dropdown's check2 icon did. */
  .check {
    margin-inline-start: auto;
    visibility: hidden;
  }

  input:checked + label .check {
    visibility: visible;
  }
</style>

<script>
  const STORAGE_KEY = 'theme';
  type Theme = 'light' | 'dark' | 'auto';

  const isTheme = (v: unknown): v is Theme =>
    v === 'light' || v === 'dark' || v === 'auto';

  function apply(theme: Theme) {
    if (theme === 'auto') {
      document.documentElement.removeAttribute('data-theme');
    } else {
      document.documentElement.setAttribute('data-theme', theme);
    }
  }

  function stored(): Theme {
    try {
      const v = localStorage.getItem(STORAGE_KEY);
      return isTheme(v) ? v : 'auto';
    } catch {
      // Private mode / blocked storage: fall back to following the OS.
      return 'auto';
    }
  }

  function init() {
    const root = document.querySelector<HTMLDetailsElement>('[data-theme-toggle]');
    if (!root) return;

    const summary = root.querySelector<HTMLElement>('[data-theme-summary]');
    const icon = root.querySelector<SVGElement>('[data-theme-icon]');

    /**
     * Mirror the chosen option onto the closed control. The glyph is copied
     * from that option's own label rather than kept in a second map here:
     * one definition, in the markup above.
     */
    function reflect(theme: Theme) {
      const label = root!.querySelector(`label[for="theme-${theme}"]`);
      const source = label?.querySelector('svg');
      if (icon && source) icon.innerHTML = source.innerHTML;
      if (summary && label) {
        summary.setAttribute(
          'aria-label',
          `Tema del sito: ${label.querySelector('span')?.textContent ?? theme}`,
        );
      }
    }

    const current = stored();
    reflect(current);

    for (const input of root.querySelectorAll<HTMLInputElement>(
      'input[name="theme"]',
    )) {
      input.checked = input.value === current;
      input.addEventListener('change', () => {
        if (!input.checked || !isTheme(input.value)) return;
        apply(input.value);
        reflect(input.value);
        root.open = false;
        try {
          localStorage.setItem(STORAGE_KEY, input.value);
        } catch {
          // Preference just won't persist. The page still works.
        }
      });
    }

    // <details> has no light-dismiss of its own.
    document.addEventListener('click', (event) => {
      if (root.open && !root.contains(event.target as Node)) root.open = false;
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && root.open) {
        root.open = false;
        root.querySelector<HTMLElement>('[data-theme-summary]')?.focus();
      }
    });
  }

  init();
  // Re-bind after client-side navigation.
  document.addEventListener('astro:after-swap', init);
</script>
