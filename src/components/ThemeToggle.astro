---
/**
 * Light / dark / auto theme toggle.
 *
 * Replaces the Drupal `helper` module's toggle block (G10). Two differences
 * from the original:
 *
 * 1. The markup lived in a `block_content` body in Drupal — editable content
 *    that no editor should ever have been able to break. It's a component now.
 * 2. It sets `data-theme` on <html>, which flips `color-scheme` (see
 *    tokens.css). Every colour follows from that one property.
 *
 * The no-flash script that reads localStorage before first paint lives in
 * BaseLayout's <head>; this component only renders the control.
 *
 * The three options are icons rather than words. Sun / moon are the universal
 * pair, and the half-filled disc is the usual "follow the system" mark; the
 * Italian label survives as the accessible name and the hover tooltip, so
 * nothing is lost for screen readers or for anyone unsure of the glyph.
 */

/* 24x24, stroke-based, matching weights — drawn inline rather than pulled from
   an icon package for three glyphs that will never change. */
const ICONS = {
  light: `<circle cx="12" cy="12" r="4.25" />
    <path d="M12 2.5v2M12 19.5v2M4.22 4.22l1.41 1.41M18.37 18.37l1.41 1.41M2.5 12h2M19.5 12h2M4.22 19.79l1.41-1.42M18.37 5.63l1.41-1.41" />`,
  dark: `<path d="M20.4 13.4A8.5 8.5 0 0 1 10.6 3.6a8.5 8.5 0 1 0 9.8 9.8Z" />`,
  auto: `<circle cx="12" cy="12" r="9" />
    <path d="M12 3a9 9 0 0 1 0 18Z" fill="currentColor" stroke="none" />`,
} as const;

const OPTIONS = [
  { value: 'light', label: 'Chiaro' },
  { value: 'dark', label: 'Scuro' },
  { value: 'auto', label: 'Automatico' },
] as const;
---

<fieldset class="theme-toggle">
  <legend class="visually-hidden">Tema del sito</legend>
  {
    OPTIONS.map(({ value, label }) => (
      <>
        <input type="radio" name="theme" id={`theme-${value}`} value={value} />
        <label for={`theme-${value}`} title={label}>
          <svg
            viewBox="0 0 24 24"
            width="16"
            height="16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            set:html={ICONS[value]}
          />
          <span class="visually-hidden">{label}</span>
        </label>
      </>
    ))
  }
</fieldset>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    gap: 1px;
    margin: 0;
    padding: 2px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background-color: var(--color-bg);
  }

  input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  label {
    display: flex;
    /* Square-ish tap target around a 16px glyph — 32x28 at the default
       root size, so the pill keeps the height it had with text labels. */
    padding: 0.375rem 0.5rem;
    border-radius: var(--radius-pill);
    color: var(--color-text-muted);
    cursor: pointer;
    user-select: none;
    transition:
      background-color var(--transition),
      color var(--transition);
  }

  label:hover {
    color: var(--color-text-strong);
  }

  input:checked + label {
    background-color: var(--color-accent-subtle);
    color: var(--color-accent);
    font-weight: 500;
  }

  /* The inputs are visually hidden, so mirror their focus onto the label. */
  input:focus-visible + label {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }
</style>

<script>
  const STORAGE_KEY = 'theme';
  type Theme = 'light' | 'dark' | 'auto';

  const isTheme = (v: unknown): v is Theme =>
    v === 'light' || v === 'dark' || v === 'auto';

  function apply(theme: Theme) {
    if (theme === 'auto') {
      document.documentElement.removeAttribute('data-theme');
    } else {
      document.documentElement.setAttribute('data-theme', theme);
    }
  }

  function stored(): Theme {
    try {
      const v = localStorage.getItem(STORAGE_KEY);
      return isTheme(v) ? v : 'auto';
    } catch {
      // Private mode / blocked storage — fall back to following the OS.
      return 'auto';
    }
  }

  function init() {
    const current = stored();

    for (const input of document.querySelectorAll<HTMLInputElement>(
      '.theme-toggle input[name="theme"]',
    )) {
      input.checked = input.value === current;
      input.addEventListener('change', () => {
        if (!input.checked || !isTheme(input.value)) return;
        apply(input.value);
        try {
          localStorage.setItem(STORAGE_KEY, input.value);
        } catch {
          // Preference just won't persist. The page still works.
        }
      });
    }
  }

  init();
  // Re-bind after client-side navigation.
  document.addEventListener('astro:after-swap', init);
</script>
