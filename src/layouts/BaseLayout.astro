---
/**
 * The document shell: <head>, header, main, footer.
 *
 * Phase 1 covers the chrome (G1–G13). The SEO component, JSON-LD and OG image
 * generation (S1–S7) land in Phase 2: the minimum viable meta is inline here
 * so pages aren't shipping without a title or description in the meantime.
 */
import '@fontsource-variable/outfit';
/*
  The URL of the one subset this site actually paints, so it can be preloaded.
  Fontsource splits Outfit by `unicode-range`; Italian never leaves the latin
  block, and the latin-ext face stays unloaded (checked in the browser: one
  woff2, 32 kB). Without a preload the font is discovered only after the
  stylesheet that declares it has been fetched and parsed, which on a slow
  connection is a quarter of a second of text in the fallback face.
*/
import outfitLatin from '@fontsource-variable/outfit/files/outfit-latin-wght-normal.woff2?url';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEO from '../components/SEO.astro';
import JsonLd from '../components/JsonLd.astro';
import WebMcp from '../components/WebMcp.astro';
import Analytics from '../components/Analytics.astro';
import { SITE } from '../consts';

interface Props {
  title?: string;
  description?: string;
  /** Homepage variant: header sits over the hero, main fills the viewport. */
  bare?: boolean;
  /** Route of this page's generated social card, e.g. `siti/montoso`. */
  ogRoute?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  /** What follows the pipe in the title; only the homepage overrides it. */
  titleSuffix?: string;
  /** Labels for intermediate breadcrumb segments, for the BreadcrumbList. */
  breadcrumbLabels?: Record<string, string>;
  /**
   * Keep this page out of search results. For pages that only make sense
   * after doing something: a form's thank-you, a payment's confirmation.
   * They have no standalone value, and a search result landing on one is a
   * dead end. `follow` so the links out of them still count.
   *
   * A page marked this way must also be excluded from the sitemap, in
   * `astro.config.mjs`: telling Google both "index this" and "do not" is
   * how a page ends up in the index anyway.
   */
  noindex?: boolean;
  /** Present on news posts: the NewsArticle node's fields. */
  article?: {
    title: string;
    description: string;
    image: string;
    published: Date;
    section?: string;
  };
  /** Present when that post announces an event: the Event node's fields. */
  event?: {
    name: string;
    description: string;
    image: string;
    start: Date;
    end?: Date;
    location: string;
  };
  /** Present on a flight site: the SportsActivityLocation node's fields. */
  place?: {
    name: string;
    description: string;
    takeoffs: { name: string; lat: number; lon: number }[];
    tags?: string[];
    image?: string;
  };
}

const {
  title,
  description = SITE.description,
  bare = false,
  ogRoute,
  imageAlt,
  type,
  publishedTime,
  titleSuffix,
  breadcrumbLabels,
  article,
  event,
  place,
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/* Before the stylesheet that names it: see the import. */}
    <link rel="preload" as="font" type="font/woff2" href={outfitLatin} crossorigin />

    {noindex && <meta name="robots" content="noindex, follow" />}

    {
      /*
        Google Search Console's proof that we own this site, chosen over the
        DNS record on 2026-09-08.

        Hardcoded rather than read from an environment variable, which is the
        opposite of how the map keys are handled and deliberate: this is not a
        credential. It is a public string whose whole job is to be in the HTML
        of a page anyone can fetch, and it grants nothing to whoever reads it.
        Behind a variable it would silently vanish the first time someone
        cleared it in Netlify, and the site would quietly lose its
        verification.

        **Do not remove it.** Google re-checks periodically and unverifies the
        property when the tag goes, taking the club's access to the reports
        with it.
      */
    }
    <meta
      name="google-site-verification"
      content="03wJYmKSNsM8gtqjn2icefpxH6R8SCo-dakfc4rzH4w"
    />

    <SEO
      title={title}
      description={description}
      ogRoute={ogRoute}
      imageAlt={imageAlt}
      type={type}
      publishedTime={publishedTime}
      suffix={titleSuffix}
    />

    {/* Favicons copied verbatim from the vr theme (S6). */}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/favicons/favicon-32x32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/favicons/favicon-16x16.png"
    />
    <link rel="apple-touch-icon" href="/favicons/apple-touch-icon.png" />
    <link rel="manifest" href="/favicons/site.webmanifest" />
    <link rel="mask-icon" href="/favicons/safari-pinned-tab.svg" color="#5bbad5" />

    {
      /* Tools for a visitor's AI assistant, on every page. Nothing loads
        unless the browser has the API. */
    }
    <WebMcp />

    <JsonLd
      title={title}
      breadcrumbLabels={breadcrumbLabels}
      article={article}
      event={event}
      place={place}
    />

    {
      /*
      Theme resolution before first paint. Must stay inline and synchronous:
      an external or deferred script would let the light theme paint first and
      flash. Mirrors the old helper/theme-toggle.js bootstrap, except it only
      sets data-theme; the colours follow from color-scheme (see tokens.css).
    */
    }
    <script is:inline>
      try {
        const stored = localStorage.getItem('theme');
        if (stored === 'light' || stored === 'dark') {
          document.documentElement.setAttribute('data-theme', stored);
        }
      } catch {
        /* Blocked storage: fall through to the OS preference. */
      }

      /*
        Says that the blur-up can be driven at all.

        Every rule that hides an image until it has loaded is written against
        this attribute, so without scripting the images simply appear, which is
        the behaviour to fall back to. It is set here, in the head, because a
        page that painted first and hid its images afterwards would flash.
      */
      document.documentElement.setAttribute('data-js', '');

      /*
        `load` does not bubble, so this listens in the capture phase: one
        listener for every image on the page, whenever it arrives, rather than
        one per element. An image already complete by the time this runs, from
        the cache or from being parsed first, is swept up on DOMContentLoaded.
      */
      document.addEventListener(
        'load',
        (event) => {
          const img = event.target;
          if (img instanceof HTMLImageElement && img.hasAttribute('data-blur')) {
            img.setAttribute('data-loaded', '');
          }
        },
        true,
      );
      document.addEventListener('DOMContentLoaded', () => {
        for (const img of document.querySelectorAll('img[data-blur]')) {
          if (img.complete) img.setAttribute('data-loaded', '');
        }
      });
    </script>
  </head>

  <body>
    <a href="#main" class="skip-link">Vai al contenuto principale</a>

    <Header transparent={bare} />

    <main id="main" class:list={['main', bare && 'main--bare']}>
      <slot />
    </main>

    <Footer />

    <Analytics />

    <style>
      .skip-link {
        position: absolute;
        inset-block-start: var(--space-2xs);
        inset-inline-start: var(--space-2xs);
        z-index: 200;
        padding: var(--space-2xs) var(--space-sm);
        border-radius: var(--radius-sm);
        background-color: var(--color-bg);
        color: var(--color-accent);
        box-shadow: var(--shadow-md);
        transform: translateY(-200%);
      }

      .skip-link:focus {
        transform: none;
      }

      /* Clears the fixed header. */
      .main {
        flex: 1;
        padding-block: calc(var(--header-height) + var(--space-lg)) var(--space-2xl);
      }

      /* Homepage: the hero owns the viewport, header floats over it. */
      .main--bare {
        display: flex;
        flex-direction: column;
        padding: 0;
      }
    </style>
  </body>
</html>
