---
/**
 * A single content entry: news article today, flight site in slice 2.
 *
 * Sits beside PageLayout (MIGRATION-PLAN.md §3) rather than inside it: an entry
 * has a byline block — date, category, hero image — that a static page does not,
 * and the body is an <article> rather than a plain slot.
 */
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

interface Props {
  title: string;
  description?: string;
  breadcrumbLabels?: Record<string, string>;
  /** Route of this entry's generated social card (S3). */
  ogRoute?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  /** Present on news posts: the NewsArticle node's fields. */
  article?: {
    title: string;
    description: string;
    image: string;
    published: Date;
    section?: string;
  };
  /** Present when that post announces an event: the Event node's fields. */
  event?: {
    name: string;
    description: string;
    image: string;
    start: Date;
    end?: Date;
    location: string;
  };
}

const {
  title,
  description,
  breadcrumbLabels,
  ogRoute,
  imageAlt,
  type,
  publishedTime,
  article,
  event,
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  ogRoute={ogRoute}
  imageAlt={imageAlt}
  type={type}
  publishedTime={publishedTime}
  breadcrumbLabels={breadcrumbLabels}
  article={article}
  event={event}
>
  <div class="container">
    <Breadcrumbs title={title} labels={breadcrumbLabels} />

    <header class="entry__head">
      <slot name="meta" />
      <h1>{title}</h1>
    </header>

    <slot name="media" />

    <article class="prose entry__body">
      <slot />
    </article>
  </div>
</BaseLayout>

<style>
  .entry__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    margin-block: var(--space-md) var(--space-lg);
    max-width: var(--prose-width);
  }

  .entry__body {
    margin-block-start: var(--space-lg);
  }
</style>
