# Keystatic GitHub mode (Phase 3).
#
# You do not write these by hand. With `storage: { kind: 'github' }` in
# keystatic.config.ts, run `npm run dev`, open http://localhost:4321/keystatic
# and follow "create a GitHub App" — Keystatic creates the app, and writes the
# real values into a `.env` file next to this one.
#
# `.env` is git-ignored and must stay that way: the client secret is a
# credential. The same four values go into the host's environment settings for
# the deployed site.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
